# Astro-Frontend environment template — PUBLIC values only (PRD §10, §14)
# The frontend NEVER holds Supabase keys or any secret (DECISIONS.md D3).
# Only PUBLIC_* vars are exposed to the client bundle.

# Canonical site URL (used for canonical/meta tags later)
PUBLIC_SITE_URL=https://vyotish.com

# Backend API base (Epic 2+ consumes /api/v1; local dev uses the wrangler/bun server)
PUBLIC_API_BASE_URL=http://localhost:8787
