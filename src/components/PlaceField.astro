---
/**
 * Birthplace picker field (owner directive, 2026-11-20) — one autocomplete
 * input backed by the backend /places proxy (Google Places suggestions when
 * GOOGLE_PLACES_API_KEY is configured, the Vyotish city table otherwise —
 * same shape, meta.source tells which). Replaces raw Latitude/Longitude/
 * Timezone inputs on every birth- and place-input form.
 *
 * The behaviour lives in src/scripts/place-picker.ts, which fills the hidden
 * inputs by role so the pages' existing submit logic keeps working:
 *   data-place-role="lat"|"lng"|"tz" → separate hidden inputs (names/ids kept)
 *   data-place-role="combined"       → one hidden input "lat,lng,tz"
 * The script dispatches a "place:selected" event on the wrapper after a
 * successful resolve (used by the muhurat today-island to reload).
 */
interface Props {
  label?: string;
  required?: boolean;
  /** separate: three hidden inputs; combined: one hidden "lat,lng,tz" input */
  variant?: "separate" | "combined";
  /** id for the visible input (labels/aria) */
  inputId?: string;
  /** hidden input names — separate defaults to lat/lng/tz */
  names?: { lat?: string; lng?: string; tz?: string; combined?: string };
  /** ids for the hidden inputs when page JS reads by id (e.g. boy-lat) */
  ids?: { lat?: string; lng?: string; tz?: string };
  /** extra attributes for the combined hidden input (e.g. data-mt-city) */
  hiddenAttrs?: Record<string, string>;
}
const {
  label = "Place of birth",
  required = true,
  variant = "separate",
  inputId,
  names = {},
  ids = {},
  hiddenAttrs = {},
} = Astro.props;
---

<div class="pp" data-place-field={required ? "required" : ""}>
  <label class="pp-label" for={inputId}>{label}</label>
  <input
    class="pp-input"
    id={inputId}
    type="text"
    data-place-input
    placeholder="Start typing your city…"
    autocomplete="off"
    aria-expanded="false"
    aria-autocomplete="list"
  />
  <div class="pp-list" data-place-list role="listbox" hidden></div>
  {
    variant === "separate" ? (
      <>
        <input type="hidden" name={names.lat ?? "lat"} id={ids.lat} data-place-role="lat" />
        <input type="hidden" name={names.lng ?? "lng"} id={ids.lng} data-place-role="lng" />
        <input type="hidden" name={names.tz ?? "tz"} id={ids.tz} data-place-role="tz" />
      </>
    ) : (
      <input type="hidden" name={names.combined ?? "city"} data-place-role="combined" {...hiddenAttrs} />
    )
  }
  <p class="pp-status" data-place-status role="status" aria-live="polite"></p>
</div>

<style>
  .pp { position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .pp-label {
    font-size: 13px;
    color: var(--text-muted, #555);
    font-weight: 500;
  }
  .pp-input {
    min-height: var(--target-min, 44px);
    width: 100%;
    box-sizing: border-box;
    padding: 0 var(--space-3, 12px);
    background: var(--bg-raised, #fff);
    border: 1px solid var(--color-border-strong, #bbb);
    border-radius: var(--radius-card, 10px);
    color: var(--text-body, #1a1a1a);
    font: inherit;
    font-size: 14px;
  }
  .pp-input:focus { outline: none; border-color: var(--gold, #c9a227); }
  .pp-status { font-size: 12.5px; color: var(--text-dim, #777); min-height: 1em; margin: 0; }
</style>
