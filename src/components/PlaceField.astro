---
/**
 * Birthplace picker field (owner directive, 2026-11-20) — one autocomplete
 * input backed by the backend /places proxy (Google Places suggestions when
 * GOOGLE_PLACES_API_KEY is configured, the Vyotish city table otherwise —
 * same shape, meta.source tells which). Replaces raw Latitude/Longitude/
 * Timezone inputs on every birth- and place-input form.
 *
 * The behaviour lives in src/scripts/place-picker.ts, which fills the hidden
 * inputs by role so the pages' existing submit logic keeps working:
 *   data-place-role="lat"|"lng"|"tz" → separate hidden inputs (names/ids kept)
 *   data-place-role="combined"       → one hidden input "lat,lng,tz"
 *   data-place-role="place_id"       → the backend place reference (city:slug
 *                                      or Google id) — always emitted
 * The script dispatches a "place:selected" event on the wrapper after a
 * successful resolve (used by the muhurat today-island to reload).
 *
 * Search-select UX (S15-1, owner directive 2026-11-21): the script also owns
 * the clear (×) button — visible whenever the input holds text — plus
 * focus-select-all, free-text validation state (aria-invalid + error status)
 * and per-field Places sessions. Wrapper carries data-place-selected="true"
 * while a resolved place is held.
 *
 * Edit mode: pass `prefill` to open with a saved place (visible text + role
 * values + selected state, × visible). `disabled`/`readonly` render locked —
 * no clear button and the picker binds nothing.
 */
interface Props {
  label?: string;
  required?: boolean;
  /** deliberately-optional place: label suffix "(optional)" (S18 marker rule) */
  optional?: boolean;
  /** separate: three hidden inputs; combined: one hidden "lat,lng,tz" input */
  variant?: "separate" | "combined";
  /** id for the visible input (labels/aria) */
  inputId?: string;
  /** visible input placeholder (e.g. to hint a default place) */
  placeholder?: string;
  /** hidden input names — separate defaults to lat/lng/tz */
  names?: { lat?: string; lng?: string; tz?: string; combined?: string; place_id?: string };
  /** ids for the hidden inputs when page JS reads by id (e.g. boy-lat) */
  ids?: { lat?: string; lng?: string; tz?: string };
  /** extra attributes for the combined hidden input (e.g. data-mt-city) */
  hiddenAttrs?: Record<string, string>;
  /** edit mode: pre-fill a saved place (coords = "lat,lng,tz") */
  prefill?: { label: string; coords: string; place_id?: string };
  /** locked field: no × button, picker binds nothing, no validation */
  disabled?: boolean;
  readonly?: boolean;
}
const {
  label = "Place of birth",
  required = true,
  optional = false,
  variant = "separate",
  inputId,
  placeholder = "Start typing your city…",
  names = {},
  ids = {},
  hiddenAttrs = {},
  prefill,
  disabled,
  readonly,
} = Astro.props;
const locked = disabled === true || readonly === true;
const pfCoords = prefill ? prefill.coords.split(",") : [];
const pf = {
  label: prefill?.label ?? "",
  lat: pfCoords[0] ?? "",
  lng: pfCoords[1] ?? "",
  tz: pfCoords[2] ?? "",
  place_id: prefill?.place_id ?? "",
};
---

<div class="pp" data-place-field={required ? "required" : ""} data-place-selected={prefill ? "true" : undefined}>
  <label class="pp-label" for={inputId}>
    {label}
    {
      required ? (
        <span class="pp-req" aria-hidden="true"> *</span>
      ) : optional ? (
        <span class="pp-opt" aria-hidden="true"> (optional)</span>
      ) : (
        ""
      )
    }
  </label>
  <div class="pp-box">
    <input
      class="pp-input"
      id={inputId}
      type="text"
      data-place-input
      value={pf.label}
      placeholder={placeholder}
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-autocomplete="list"
      aria-controls={`${inputId}-listbox`}
      aria-required={required ? "true" : undefined}
      disabled={disabled}
      readonly={readonly}
    />
    {
      !locked && (
        <button type="button" class="pp-clear" data-place-clear aria-label="Clear city" hidden>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none" />
          </svg>
        </button>
      )
    }
    <div class="pp-list" id={`${inputId}-listbox`} data-place-list role="listbox" hidden></div>
  </div>
  {
    variant === "separate" ? (
      <>
        <input type="hidden" name={names.lat ?? "lat"} id={ids.lat} data-place-role="lat" value={pf.lat} />
        <input type="hidden" name={names.lng ?? "lng"} id={ids.lng} data-place-role="lng" value={pf.lng} />
        <input type="hidden" name={names.tz ?? "tz"} id={ids.tz} data-place-role="tz" value={pf.tz} />
        <input type="hidden" name={names.place_id ?? "place_id"} data-place-role="place_id" value={pf.place_id} />
      </>
    ) : (
      <>
        <input
          type="hidden"
          name={names.combined ?? "city"}
          data-place-role="combined"
          {...hiddenAttrs}
          value={prefill ? prefill.coords : hiddenAttrs.value}
        />
        <input type="hidden" name={names.place_id ?? "place_id"} data-place-role="place_id" value={pf.place_id} />
      </>
    )
  }
  <p class="pp-status" data-place-status role="status" aria-live="polite"></p>
</div>

<style>
  .pp { position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .pp-label {
    font-size: 13px;
    color: var(--text-muted, #555);
    font-weight: 500;
  }
  .pp-box { position: relative; display: flex; }
  .pp-input {
    min-height: var(--target-min, 44px);
    width: 100%;
    box-sizing: border-box;
    padding: 0 var(--space-3, 12px);
    background: var(--bg-raised, #fff);
    border: 1px solid var(--color-border-strong, #bbb);
    border-radius: var(--radius-card, 10px);
    color: var(--text-body, #1a1a1a);
    font: inherit;
    font-size: 14px;
  }
  .pp-input:focus { outline: none; border-color: var(--gold, #c9a227); }
  /* room for the × while it is visible (S15-1 AC-6) */
  .pp-input.has-clear { padding-right: 46px; }
  .pp-input[aria-invalid="true"] { border-color: var(--color-error-text, #b3261e); }
  .pp-clear {
    position: absolute; top: 0; right: 0; height: 100%;
    min-width: 44px; min-height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: transparent; border: none; cursor: pointer;
    color: var(--text-dim, #777);
    border-radius: var(--radius-card, 10px);
  }
  .pp-clear:hover { color: var(--text-body, #1a1a1a); }
  .pp-clear:focus-visible { outline: 2px solid var(--gold, #c9a227); outline-offset: -2px; }
  .pp-status { font-size: 12.5px; color: var(--text-dim, #777); min-height: 1em; margin: 0; }
  .pp-status.pp-error { color: var(--color-error-text, #b3261e); }
  .pp-req { color: var(--color-error-text, #b3261e); font-weight: 700; }
  .pp-opt { color: var(--text-dim, #777); font-weight: 400; }
</style>
