---
/**
 * Newsletter / notify-me form (Epic 5.5) — POSTs /api/v1/newsletter with a
 * source tag. Used by the Gemstones teaser (gemstones_notify) and the home
 * FAQ block (weekly_panchang). Design §6 markup, real endpoint.
 * S24: button label + failure copy become props so Hindi pages can inject
 * the HOME dict strings (aria stays bilingual-neutral "Email address").
 */
interface Props {
  source: "gemstones_notify" | "weekly_panchang";
  placeholder: string;
  buttonClass: string;
  inputClass: string;
  success: string;
  buttonLabel: string;
  fail: string;
  hi?: boolean;
}
const {
  source,
  placeholder,
  buttonClass,
  inputClass,
  success,
  buttonLabel,
  fail,
  hi = false,
} = Astro.props;
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<form data-newsletter-form data-source={source} class="max-w-md w-full mx-auto flex flex-col sm:flex-row flex-wrap gap-2 mt-2">
  {/* min-h appended here so every call site gets the 44px tap target without
      each caller having to remember it (UX audit F6) */}
  <input type="email" required placeholder={placeholder} aria-label="Email address" class={`${inputClass} min-h-[44px]${hi ? " hi-text" : ""}`} />
  <button type="submit" class={`${buttonClass} min-h-[44px]`}>
    <span class={hi ? "hi-text" : ""}>{buttonLabel}</span>
  </button>
  <div class="w-full" data-turnstile-slot data-turnstile-sitekey={turnstileSitekey}></div>
</form>
<p class="hidden font-body text-body-sm text-success dark:text-[var(--color-auspicious-text)] font-medium mt-1" data-newsletter-ok>{success}</p>
<p class={`hidden font-body text-body-sm text-error dark:text-[var(--color-error-text)] mt-1 ${hi ? "hi-text" : ""}`} data-newsletter-fail role="alert">{fail}</p>

<script define:vars={{ apiBase: import.meta.env.PUBLIC_API_BASE_URL ?? "https://astro-backend.vyotish.workers.dev", source: source, failTxt: fail }}>
  var form = document.querySelector('[data-newsletter-form][data-source="' + source + '"]');
  if (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var ok = form.nextElementSibling;
      var fail = ok && ok.nextElementSibling;
      var email = form.querySelector("input[type=email]").value.trim();
      var send = function (turnstileToken) {
        var payload = { email: email, source: form.getAttribute("data-source") };
        if (turnstileToken) payload.turnstile_token = turnstileToken;
        fetch(apiBase + "/api/v1/newsletter", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        })
          .then(function (r) {
            if (!r.ok) {
              return r.json()
                .catch(function () { return null; })
                .then(function (err) {
                  throw { serverMsg: err && err.error && err.error.message ? err.error.message : "" };
                });
            }
            return r.json();
          })
          .then(function () {
            if (ok) ok.classList.remove("hidden");
            if (fail) fail.classList.add("hidden");
            form.reset();
          })
          .catch(function (err) {
            if (fail) {
              fail.textContent =
                (err && err.serverMsg) || failTxt;
              fail.classList.remove("hidden");
            }
          });
      };
      if (window.VyotishTurnstile) {
        window.VyotishTurnstile.getToken(form).then(send);
      } else {
        send("");
      }
    });
    var tsTries = 0;
    var initTs = function () {
      if (window.VyotishTurnstile) {
        window.VyotishTurnstile.ensure(form);
        return;
      }
      if (tsTries++ < 15) setTimeout(initTs, 300);
    };
    initTs();
  }
</script>
