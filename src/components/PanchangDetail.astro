---
/**
 * Panchang detail component (Epic 3.2) — client island rendering the full
 * day from the LIVE /api/v1/panchang for a fixed city + date (?date= or today).
 */
import DateField from "./DateField.astro";

interface Props {
  apiBase: string;
  citySlug: string;
  cityName: string;
  lat: number;
  lng: number;
  tz: string;
}
const { apiBase, citySlug, cityName, lat, lng, tz } = Astro.props;
---

<section class="pd" aria-label={`Panchang for ${cityName}`} data-api-base={apiBase} data-city-slug={citySlug} data-city-tz={tz}>
  <div class="pd-toolbar">
    <div class="dp-date">
      <DateField id="pd-date" label="Date" preset="free" attrs={{ "data-pd-date": "" }} />
    </div>
    <div class="quick" role="group" aria-label="Quick date picks">
      <button type="button" class="quick-btn" data-pd-quick="today">Today</button>
      <button type="button" class="quick-btn" data-pd-quick="tomorrow">Tomorrow</button>
    </div>
    <button type="button" class="monthly" data-pd-monthly>Monthly view</button>
  </div>

  <div class="pd-error" data-pd-error hidden>Could not load Panchang — please try again shortly.</div>

  <div class="pd-grid" data-pd-grid>
    <div class="cell skeleton">Loading…</div>
  </div>

  <div class="pd-cal" data-pd-calendar hidden></div>

  <h3>Festivals &amp; vrats <span class="hint">— for the selected day (from the festivals table)</span></h3>
  <div class="festivals" data-pd-festivals>
    <p class="fest-empty">—</p>
  </div>

  <h3>Five limbs <span class="hint">— with start/end times (Vedic day runs sunrise → sunrise)</span></h3>
  <div class="limbs" data-pd-limbs></div>

  <h3>Day segments</h3>
  <div class="segments" data-pd-segments></div>

  <details class="accuracy">
    <summary>How this Panchang is calculated</summary>
    <p>
      Planetary positions come from published astronomical methods via the
      astronomy-engine library, converted to the sidereal zodiac with the Lahiri
      ayanamsha (≈24° for current years, validated against published tables).
      Timezones use the IANA database, so historical DST is handled correctly.
      The Vedic day begins at sunrise (upper limb + refraction, matching printed
      almanacs). Rahu Kaal and similar segments use the traditional proportional
      1/8-day method — these tables carry a pending Jyotishi-review flag.
    </p>
  </details>
</section>

<script is:inline define:vars={{ apiBase, citySlug, cityName, lat, lng, tz }}>
  (function () {
    var grid = document.querySelector("[data-pd-grid]");
    var limbsEl = document.querySelector("[data-pd-limbs]");
    var segsEl = document.querySelector("[data-pd-segments]");
    var errEl = document.querySelector("[data-pd-error]");
    var dateInput = document.querySelector("[data-pd-date]");

    // local calendar date (NOT toISOString — the site's audience runs on IST,
    // where the UTC date is still "yesterday" until 05:30 local)
    function today() {
      var d = new Date();
      return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
    }
    function fmt(iso, tz) {
      try {
        return new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date(iso));
      } catch (e) { return "—"; }
    }
    function cell(label, value, sub) {
      return '<div class="cell"><div class="label">' + label + '</div><div class="value">' + value + "</div>" + (sub ? '<div class="sub">' + sub + "</div>" : "") + "</div>";
    }
    function limbRows(limb) {
      return limb.map(function (w) {
        return '<div class="limb-row"><span class="ln">' + w.name + '</span><span class="lt">' + fmt(w.start, tz) + " – " + fmt(w.end, tz) + (w.end_kind === "day_end" ? " (day end)" : "") + "</span></div>";
      }).join("");
    }

    function load(dateISO) {
      errEl.setAttribute("hidden", "");
      grid.innerHTML = '<div class="cell skeleton">Loading…</div>';
      limbsEl.innerHTML = "";
      segsEl.innerHTML = "";
      var festEl = document.querySelector("[data-pd-festivals]");
      if (festEl) festEl.innerHTML = '<p class="fest-empty">—</p>';
      fetch(apiBase + "/api/v1/festivals?date=" + dateISO)
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (jf) {
          if (!jf || !festEl) return;
          var list = jf.data && jf.data.festivals ? jf.data.festivals : [];
          if (list.length === 0) {
            festEl.innerHTML = '<p class="fest-empty">No festivals or vrats recorded for this day yet.</p>';
          } else {
            festEl.innerHTML = list.map(function (f) {
              return '<div class="fest"><span class="fn">' + f.name + (f.name_hi ? ' <span class="fh">' + f.name_hi + "</span>" : "") + '</span><span class="fd">' + (f.description || "") + (f.is_sample ? " (sample)" : "") + "</span></div>";
            }).join("");
          }
        })
        .catch(function () { /* festivals are optional; panchang still renders */ });
      // City mode first — the backend caches per (city, date) and the daily
      // cron pre-warms today, so most reads are cache hits. Coordinates are
      // the fallback for a city that has since been removed.
      fetch(apiBase + "/api/v1/panchang?city=" + encodeURIComponent(citySlug) + "&date=" + dateISO)
        .then(function (r) { if (!r.ok) throw new Error("bad"); return r.json(); })
        .catch(function () {
          return fetch(apiBase + "/api/v1/panchang?lat=" + lat + "&lng=" + lng + "&tz=" + encodeURIComponent(tz) + "&date=" + dateISO)
            .then(function (r) { if (!r.ok) throw new Error("bad"); return r.json(); });
        })
        .then(function (j) {
          var p = j.data;
          var hm = p.hindu_month || {};
          var prim = hm.primary || hm.purnimanta || {};
          var sv = p.samvat || {};
          grid.innerHTML =
            cell("Tithi", p.tithi[0] ? p.tithi[0].name : "—") +
            cell("Nakshatra", p.nakshatra[0] ? p.nakshatra[0].name : "—", p.nakshatra[0] ? p.nakshatra[0].name_hi : "") +
            cell("Yoga", p.yoga[0] ? p.yoga[0].name : "—") +
            cell("Karana", p.karana[0] ? p.karana[0].name : "—") +
            cell("Sunrise", fmt(p.vedic_day.sunrise, p.timezone)) +
            cell("Sunset", fmt(p.vedic_day.sunset, p.timezone)) +
            cell("Moonrise", p.moonrise ? fmt(p.moonrise, p.timezone) : "—") +
            cell("Moonset", p.moonset ? fmt(p.moonset, p.timezone) : "—") +
            cell("Hindu month", prim.name ? prim.name + (hm.adhika ? " (adhika)" : "") : "—", prim.name_hi || "") +
            cell("Samvat", sv.vikram ? "Vikram " + sv.vikram + " · Shaka " + sv.shaka : "—");
          limbsEl.innerHTML =
            '<div class="limb-block"><h4>Tithi</h4>' + limbRows(p.tithi) + "</div>" +
            '<div class="limb-block"><h4>Nakshatra</h4>' + limbRows(p.nakshatra) + "</div>" +
            '<div class="limb-block"><h4>Yoga</h4>' + limbRows(p.yoga) + "</div>" +
            '<div class="limb-block"><h4>Karana</h4>' + limbRows(p.karana) + "</div>";
          var segs = [p.rahu_kaal, p.yamaganda, p.gulika, p.abhijit, p.brahma_muhurta];
          segsEl.innerHTML = segs.map(function (s) {
            return '<div class="seg ' + (s.verified ? "verified" : "unverified") + '"><div class="sn">' + s.name + '</div><div class="st">' + fmt(s.start, tz) + " – " + fmt(s.end, tz) + '</div><div class="ss">' + (s.verified ? "" : "⚠ pending Jyotishi review — ") + "</div></div>";
          }).join("");
        })
        .catch(function () {
          grid.innerHTML = "";
          errEl.removeAttribute("hidden");
        });
    }

    // programmatic writes: once the DateField picker is bound, vyDateTime.set
    // fires `change` and the listener below does the replaceState + load —
    // one fetch per pick. Before it binds (init path), do both here: setupField
    // re-renders the segments from whatever the hidden input already holds.
    function setPdDate(iso) {
      dateInput.value = iso;
      if (window.vyDateTime) {
        window.vyDateTime.set(dateInput, iso);
      } else {
        var url = new URL(location.href);
        url.searchParams.set("date", iso);
        history.replaceState(null, "", url.toString());
        load(iso);
      }
    }

    var initial = new URLSearchParams(location.search).get("date") || today();
    setPdDate(initial);
    // Monthly calendar view (Epic 3.2b) owns the page when ?view=calendar —
    // its bundled script fills [data-pd-calendar]; skip the day fetch.
    var isCalendarView = new URLSearchParams(location.search).get("view") === "calendar";
    if (!isCalendarView && !window.vyDateTime) load(initial);
    document.querySelectorAll("[data-pd-quick]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var kind = btn.getAttribute("data-pd-quick");
        var d = new Date();
        if (kind === "tomorrow") d.setDate(d.getDate() + 1);
        var iso = d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
        setPdDate(iso);
      });
    });
    dateInput.addEventListener("change", function () {
      var url = new URL(location.href);
      url.searchParams.set("date", dateInput.value);
      history.replaceState(null, "", url.toString());
      load(dateInput.value);
    });
    // the monthly-calendar island asks us to re-show the day view (Epic 3.2b)
    var pdSection = document.querySelector(".pd");
    if (pdSection) {
      pdSection.addEventListener("pd:show-day", function () {
        load(dateInput.value || today());
      });
    }
  })();
</script>

<script>
  // Epic 3.2b — monthly calendar island (bundled; reads the section's data
  // attributes because bundled scripts cannot use define:vars).
  import "../scripts/panchang-calendar";
</script>

<style is:global>
  .pd { max-width: 1000px; margin: 0 auto; padding: var(--space-5) var(--space-4) var(--space-8); }
  .pd-toolbar { display: flex; gap: var(--space-4); align-items: flex-end; margin-bottom: var(--space-4); flex-wrap: wrap; }
  .pd-toolbar .dt { min-width: 220px; }
  .monthly { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; color: var(--gold); font-size: 14px; text-decoration: none; min-height: var(--target-min); line-height: var(--target-min); }
  .quick { display: inline-flex; gap: var(--space-2); }
  .quick-btn {
    min-height: var(--target-min); padding: 0 var(--space-3);
    background: var(--bg-raised); border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card); color: var(--text-muted); font-size: 13px; cursor: pointer;
  }
  .quick-btn:hover { border-color: var(--border-gold-soft); color: var(--ivory); }
  .festivals { display: flex; flex-direction: column; gap: var(--space-2); }
  .fest-empty { color: var(--text-faint); font-size: 13px; }
  .fest { background: var(--bg-raised); border: 1px solid var(--border-gold-soft); border-radius: var(--radius-card); padding: var(--space-3) var(--space-4); display: flex; flex-direction: column; gap: 2px; }
  .fest .fn { color: var(--ivory); font-weight: 500; font-size: 14px; }
  .fest .fh { color: var(--text-dim); font-weight: 400; margin-left: var(--space-2); }
  .fest .fd { color: var(--text-dim); font-size: 12.5px; }
  .pd-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--space-3); }
  .cell { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-3); min-height: 72px; }
  .cell .label { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); }
  .cell .value { font-family: var(--font-display); font-size: 19px; color: var(--ivory); margin-top: 2px; }
  .cell .sub { font-size: 12px; color: var(--text-faint); }
  .cell.skeleton { display: flex; align-items: center; color: var(--text-dim); }
  h3 { font-family: var(--font-display); color: var(--ivory); font-size: 22px; margin: var(--space-6) 0 var(--space-3); }
  .hint { font-size: 13px; color: var(--text-dim); font-family: var(--font-body); }
  .limbs { display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
  .limb-block { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-4); }
  .limb-block h4 { color: var(--gold); font-size: 14px; margin-bottom: var(--space-2); }
  .limb-row { display: flex; justify-content: space-between; gap: var(--space-3); padding: 6px 0; border-bottom: 1px solid var(--border-faint); font-size: 14px; }
  .limb-row:last-child { border-bottom: none; }
  .limb-row .ln { color: var(--text-body); }
  .limb-row .lt { color: var(--text-dim); font-variant-numeric: tabular-nums; }
  .segments { display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .seg { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-3); }
  .seg.unverified { border-color: var(--border-gold-soft); }
  .seg .sn { color: var(--ivory); font-weight: 500; font-size: 14px; }
  .seg .st { color: var(--text-muted); font-size: 13px; margin-top: 2px; font-variant-numeric: tabular-nums; }
  .seg .ss { color: var(--text-faint); font-size: 11px; }
  /* Monthly calendar (Epic 3.2b) */
  .pd.cal-mode .pd-grid,
  .pd.cal-mode .pd-error,
  .pd.cal-mode h3,
  .pd.cal-mode .festivals,
  .pd.cal-mode .limbs,
  .pd.cal-mode .segments { display: none; }
  .pd-cal { margin-top: var(--space-5); }
  .cal-nav { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }
  .cal-nav .cal-title { color: var(--ivory); font-family: var(--font-display); font-size: 18px; flex: 1; }
  .cal-nav button {
    min-height: var(--target-min); padding: 0 var(--space-3); cursor: pointer;
    background: var(--bg-raised); border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card); color: var(--text-muted); font-size: 13px;
  }
  .cal-nav button:hover { border-color: var(--border-gold-soft); color: var(--ivory); }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--space-1); }
  .cal-head {
    text-align: center; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--gold); padding: var(--space-2) 0; font-weight: 600;
  }
  .cal-day {
    background: var(--bg-raised); border: 1px solid var(--color-border-strong);
    border-radius: 8px; padding: 6px 8px; min-height: 64px; font-size: 12px;
    display: flex; flex-direction: column; gap: 2px;
  }
  .cal-day .d { color: var(--ivory); font-weight: 600; font-variant-numeric: tabular-nums; }
  .cal-day .t, .cal-day .n { color: var(--text-dim); line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cal-day.today { border-color: var(--gold); }
  .cal-day.today .d { color: var(--gold); }
  .cal-day .sk { color: var(--text-faint); }
  @media (max-width: 640px) {
    .cal-day { min-height: 52px; padding: 4px 5px; font-size: 10.5px; }
    .cal-day .n { display: none; }
  }
  .accuracy { margin-top: var(--space-6); color: var(--text-muted); font-size: 14px; }
  .accuracy summary { min-height: var(--target-min); display: flex; align-items: center; cursor: pointer; color: var(--gold); }
  .accuracy p { margin-top: var(--space-3); line-height: 1.7; }
</style>
