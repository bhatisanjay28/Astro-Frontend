---
/**
 * Explore Vyotish — one tile per tab (PRD §6). Used on both homes; on the
 * Hindi home the horoscope tile links to /hi/horoscope (S22) and the other
 * tiles keep their EN hrefs (no hi twins yet — honest fallback).
 */
import { NAV_TABS, withLang } from "../data/navigation";

interface Props {
  lang?: "en" | "hi";
}
const { lang = "en" } = Astro.props;
const hi = lang === "hi";
const tileHref = (href: string) => withLang(href, hi ? "/hi/" : "/");
---

<section class:list={["explore", { "explore-hi": hi }]} aria-labelledby="explore-h">
  <h2 id="explore-h">{hi ? "व्योतिष देखें" : "Explore Vyotish"}</h2>
  <div class="tiles">
    {
      NAV_TABS.map((t) => (
        <a class="tile" href={tileHref(t.href)}>
          <span class="icon" aria-hidden="true">
            {t.icon}
          </span>
          <span class="t-label">{hi ? t.label_hi : t.label}</span>
          <span class="t-desc">{t.description}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .explore {
    max-width: 1100px;
    margin: 0 auto var(--space-8);
    padding: 0 var(--space-4);
  }
  h2 {
    font-family: var(--font-display);
    color: var(--ivory);
    font-size: 28px;
    margin-bottom: var(--space-4);
    font-weight: 600;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-3);
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 110px;
    padding: var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .tile:hover,
  .tile:focus-visible {
    border-color: var(--border-gold-soft);
    transform: translateY(-2px);
  }
  .icon { font-size: 22px; }
  .t-label { color: var(--ivory); font-weight: 500; font-size: 15px; }
  .t-desc { color: var(--text-dim); font-size: 12.5px; line-height: 1.45; }

  /* Hindi home (S22): Devanagari heading/labels on the self-hosted face. */
  .explore-hi h2 {
    font-family: "Noto Sans Devanagari", var(--font-display);
  }
  .explore-hi .t-label {
    font-family: "Noto Sans Devanagari", var(--font-body);
  }
</style>
