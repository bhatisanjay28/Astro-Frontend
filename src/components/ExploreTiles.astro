---
/**
 * Explore Vyotish — one tile per tab (PRD §6).
 */
import { NAV_TABS } from "../data/navigation";
---

<section class="explore" aria-labelledby="explore-h">
  <h2 id="explore-h">Explore Vyotish</h2>
  <div class="tiles">
    {
      NAV_TABS.map((t) => (
        <a class="tile" href={t.href}>
          <span class="icon" aria-hidden="true">
            {t.icon}
          </span>
          <span class="t-label">{t.label}</span>
          <span class="t-desc">{t.description}</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .explore {
    max-width: 1100px;
    margin: 0 auto var(--space-8);
    padding: 0 var(--space-4);
  }
  h2 {
    font-family: var(--font-display);
    color: var(--ivory);
    font-size: 28px;
    margin-bottom: var(--space-4);
    font-weight: 600;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-3);
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 110px;
    padding: var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .tile:hover,
  .tile:focus-visible {
    border-color: var(--border-gold-soft);
    transform: translateY(-2px);
  }
  .icon { font-size: 22px; }
  .t-label { color: var(--ivory); font-weight: 500; font-size: 15px; }
  .t-desc { color: var(--text-dim); font-size: 12.5px; line-height: 1.45; }
</style>
