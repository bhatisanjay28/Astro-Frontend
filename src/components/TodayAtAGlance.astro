---
/**
 * Today at a glance (PRD §6) — client island fetching the LIVE backend
 * /api/v1/panchang for the remembered city (localStorage), Delhi default.
 * Deterministic per city+date; the API serves it from the edge once the
 * cache secret lands.
 */
interface Props {
  apiBase: string;
}
const { apiBase } = Astro.props;
---

<section class="glance" aria-labelledby="glance-h">
  <div class="glance-head">
    <h2 id="glance-h">Today at a glance</h2>
    <label class="city-label">
      City
      <select id="glance-city" aria-label="Select city">
        <option value="28.6139,77.209,Asia/Kolkata,New Delhi">New Delhi</option>
        <option value="19.076,72.8777,Asia/Kolkata,Mumbai">Mumbai</option>
        <option value="12.9716,77.5946,Asia/Kolkata,Bengaluru">Bengaluru</option>
        <option value="22.5726,88.3639,Asia/Kolkata,Kolkata">Kolkata</option>
        <option value="13.0827,80.2707,Asia/Kolkata,Chennai">Chennai</option>
        <option value="17.385,78.4867,Asia/Kolkata,Hyderabad">Hyderabad</option>
      </select>
    </label>
  </div>

  <div class="glance-grid" id="glance-grid" aria-live="polite">
    <div class="cell skeleton">Loading Panchang…</div>
  </div>
  <p class="glance-error" id="glance-error" hidden>
    Panchang is temporarily unavailable. Please try again shortly.
  </p>
  <p class="powered">Computed by the Vyotish engine · <a href={apiBase}>API</a></p>
</section>

<script is:inline define:vars={{ apiBase }}>
  (function () {
    var grid = document.getElementById("glance-grid");
    var errEl = document.getElementById("glance-error");
    var select = document.getElementById("glance-city");

    function remembered() {
      try { return localStorage.getItem("vyotish-city") || select.options[0].value; } catch (e) { return select.options[0].value; }
    }
    function remember(v) {
      try { localStorage.setItem("vyotish-city", v); } catch (e) {}
    }

    function cell(label, value, sub) {
      return '<div class="cell"><div class="label">' + label + '</div><div class="value">' + value + "</div>" + (sub ? '<div class="sub">' + sub + "</div>" : "") + "</div>";
    }
    function fmt(iso, tz) {
      try {
        return new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date(iso));
      } catch (e) { return "—"; }
    }

    function render(p) {
      var t = p.tithi && p.tithi[0] ? p.tithi[0].name : "—";
      var n = p.nakshatra && p.nakshatra[0] ? p.nakshatra[0].name : "—";
      var rahu = p.rahu_kaal;
      grid.innerHTML =
        cell("Tithi", t, "Shukla Paksha" ) +
        cell("Nakshatra", n, "") +
        cell("Vaar", p.vaar.name, p.vaar.name_hi) +
        cell("Sunrise", fmt(p.vedic_day.sunrise, p.timezone), "") +
        cell("Sunset", fmt(p.vedic_day.sunset, p.timezone), "") +
        cell("Rahu Kaal", fmt(rahu.start, p.timezone) + "–" + fmt(rahu.end, p.timezone), "avoid new work");
    }

    function load() {
      var parts = remembered().split(",");
      var url = apiBase + "/api/v1/panchang?lat=" + parts[0] + "&lng=" + parts[1] + "&tz=" + encodeURIComponent(parts[2]) + "&date=" + new Date().toISOString().slice(0, 10);
      errEl.setAttribute("hidden", "");
      fetch(url)
        .then(function (r) { if (!r.ok) throw new Error("bad status"); return r.json(); })
        .then(function (j) { render(j.data); })
        .catch(function () {
          grid.innerHTML = "";
          errEl.removeAttribute("hidden");
        });
    }

    select.value = remembered();
    select.addEventListener("change", function () { remember(select.value); load(); });
    load();
  })();
</script>

<style is:global>
  .glance {
    max-width: 1100px;
    margin: 0 auto var(--space-8);
    padding: 0 var(--space-4);
  }
  .glance-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  h2 {
    font-family: var(--font-display);
    color: var(--ivory);
    font-size: 28px;
    font-weight: 600;
  }
  .city-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-dim);
    font-size: 14px;
  }
  .city-label select {
    min-height: var(--target-min);
    background: var(--bg-raised);
    color: var(--text-body);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    padding: 0 var(--space-3);
  }
  .glance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-3);
  }
  .cell {
    background: var(--bg-raised);
    border: 1px solid var(--border-gold-soft);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    min-height: 84px;
  }
  .cell .label {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .cell .value {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--ivory);
    margin-top: var(--space-1);
  }
  .cell .sub {
    font-size: 12px;
    color: var(--text-faint);
    margin-top: 2px;
  }
  .cell.skeleton { color: var(--text-dim); display: flex; align-items: center; }
  .glance-error { color: var(--text-muted); font-size: 14px; }
  .powered { color: var(--text-faint); font-size: 12px; margin-top: var(--space-3); }
  .powered a { color: var(--gold); }
</style>
