---
/**
 * Legal/page layout component (Epic 2.3 skeleton → Epic 7.3 sectioned content
 * → Sally UX polish, 2026-11-21).
 *
 * Sally pass (Stitch "Vyotish — UX Designs (Sally)" legal-policy template
 * screens): gold eyebrow + Cinzel H1 header block, "Last updated" pill chip
 * with calendar icon, tinted "On this page" card with gold-dot numbered
 * anchors, Cinzel section headings with gold underline bars, gold-dot bullet
 * markers, terracotta prose links, and a closing grid with a Related
 * documents card (current page flagged "Current", per stitch) + the Zero-OTP
 * trust card (copy reused verbatim from the contact page) + a questions
 * mailto card. Everything maps onto tokens.css aliases so dark mode follows
 * automatically. Sally's invented policy copy (section rewrites, deletion
 * SLAs, DPO identity) was discarded — page content stays authored in-repo.
 *
 * 7.3 upgrade: pages are now written as sections (id-anchored h2 + paragraphs +
 * bullet lists) with an "On this page" anchor list and a Last-updated line, so
 * long-form DPDP-grounded legal copy stays readable on mobile. Paragraph and
 * bullet strings may contain inline <a> links (authored in-repo content only —
 * never user input — so set:html is safe here). set:html children carry no
 * Astro scope id, so inner-element styles use :global() scoped to the section.
 *
 * `body` (flat paragraphs) is kept for backward compatibility but no page uses
 * it anymore. Ownership/legal review of the drafts is tracked in epics.md +
 * launch-blockers.md.
 */
import Base from "../layouts/Base.astro";
import { langFromPath, withLang } from "../lib/i18n";
import { LEGAL_CHROME } from "../lib/i18n/legal";

interface Section {
  id: string;
  heading: string;
  paragraphs?: string[];
  bullets?: string[];
  /** Paragraphs rendered after the bullet list (closing note). */
  note?: string[];
}

interface Props {
  title: string;
  heading: string;
  intro: string;
  updated?: string;
  /** Small uppercase label above the H1 (family the page belongs to). */
  eyebrow?: string;
  sections?: Section[];
  body?: string[];
  /** Optional status footnote (e.g. phased-launch note on the About page). */
  note?: string;
}
const { title, heading, intro, updated, eyebrow, sections = [], body = [], note } = Astro.props;

/* S24 — page-level language: chrome (eyebrow, TOC, related docs, trust card,
 * back link) follows the /hi path; document content comes from the caller's
 * dict. Only the display-font headings need the explicit .hi-text face — body
 * text inherits html[lang="hi"] from base.css. */
const lang = langFromPath(Astro.url.pathname);
const c = LEGAL_CHROME[lang];
const hi = lang === "hi";

const EMAIL = "vyotish@gmail.com";
const here = Astro.url.pathname.replace(/\/+$/, "");
---

<Base title={title} description={intro}>
  <article class="legal">
    <header class="legal-head">
      <p class={`eyebrow ${hi ? "hi-text" : ""}`}><span class="edot" aria-hidden="true"></span>{eyebrow ?? c.eyebrow}</p>
      <h1 class={hi ? "hi-text" : ""}>{heading}</h1>
      <p class="intro">{intro}</p>
      {
        updated && (
          <p class="updated-chip">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>{c.updatedPre}{updated}</span>
          </p>
        )
      }
    </header>

    {
      sections.length > 1 && (
        <nav class="toc" aria-label={c.tocAria}>
          <div class="toc-head">
            <p class="toc-title">{c.tocTitle}</p>
            <span class="toc-count">
              {sections.length} {c.sectionsWord}
            </span>
          </div>
          <ol class="toc-list">
            {sections.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="dot" aria-hidden="true" />
                  <span class="num">{i + 1}.</span>
                  <span class="toc-label">{s.heading}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      sections.map((s) => (
        <section class="legal-section" id={s.id}>
          <h2 class={hi ? "hi-text" : ""}>{s.heading}</h2>
          {s.paragraphs?.map((p) => <p set:html={p} />)}
          {s.bullets && (
            <ul>
              {s.bullets.map((b) => (
                <li set:html={b} />
              ))}
            </ul>
          )}
          {s.note?.map((p) => <p set:html={p} />)}
        </section>
      ))
    }

    {body.map((para) => <p class="legacy-body">{para}</p>)}

    {note && <div class="page-note">{note}</div>}

    <div class="closing">
      <nav class="related" aria-label={c.relatedAria}>
        <p class={`card-label ${hi ? "hi-text" : ""}`}>{c.relatedTitle}</p>
        <ul class="related-list">
          {
            c.relatedDocs.map((d) => {
              const href = withLang(d.href, Astro.url.pathname);
              const current = here === href;
              const row = (
                <>
                  <span class="dot" aria-hidden="true" />
                  <span class="rlabel">{d.label}</span>
                </>
              );
              return (
                <li>
                  {current ? (
                    <span class="rrow current" aria-current="page">
                      {row}
                      <span class="chip-current">{c.current}</span>
                    </span>
                  ) : (
                    <a class="rrow" href={href}>
                      {row}
                      <svg class="rarrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 18 6-6-6-6" />
                      </svg>
                    </a>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="side">
        <div class="trust-card">
          <div class="trust-row">
            <span class="trust-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            </span>
            <div>
              <h2 class={`trust-title ${hi ? "hi-text" : ""}`}>{c.trustTitle}</h2>
              <p class={`trust-text ${hi ? "hi-text" : ""}`}>{c.trustText}</p>
            </div>
          </div>
        </div>
        <div class="questions-card">
          <p class={`card-label ${hi ? "hi-text" : ""}`}>{c.questionsLabel}</p>
          <a class="mail-link" href={`mailto:${EMAIL}`}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>{EMAIL}</span>
          </a>
        </div>
      </div>
    </div>

    <a class="back" href={withLang("/", Astro.url.pathname)}>{c.backHome}</a>
  </article>
</Base>

<style>
  .legal {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-7);
  }

  /* ---- Header block ---- */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* accent gold is ≈3.1:1 on the light surface — the theme-aware
       --color-accent-text passes AA in both modes (eyebrow contrast fix) */
    color: var(--color-accent-text);
  }
  .edot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-text);
    flex-shrink: 0;
  }
  .legal-head h1 {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .intro {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: 15.5px;
    line-height: 1.7;
  }
  .updated-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .updated-chip svg {
    flex-shrink: 0;
  }

  /* ---- On-this-page card ---- */
  .toc {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-tint);
  }
  .toc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .card-label,
  .toc-title {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* accent gold is ≈2.8:1 on the tinted card — theme-aware
       --color-accent-text passes AA in both modes (eyebrow contrast fix) */
    color: var(--color-accent-text);
  }
  .toc-count {
    font-size: 11px;
    color: var(--color-text-muted);
  }
  .toc-list {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--space-6);
  }
  .toc-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 2px 0;
    font-size: 13.5px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .toc-list .num {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    min-width: 1.6em;
  }
  .toc-label {
    transition: color 0.15s ease;
  }
  .toc-list a:hover .toc-label,
  .toc-list a:focus-visible .toc-label {
    color: var(--color-primary);
  }
  .toc-list a:hover .num {
    color: var(--color-primary);
  }
  .toc-list a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 6px;
  }

  /* ---- Content sections ---- */
  .legal-section {
    margin-top: var(--space-6);
    /* 88px sat under the 82px stuck header; the global scroll-padding (6rem,
       base.css S20) now owns the header clearance — keep only a small air gap */
    scroll-margin-top: 10px;
  }
  .legal-section h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    font-size: 20px;
    letter-spacing: -0.005em;
  }
  .legal-section h2::after {
    content: "";
    display: block;
    width: 24px;
    height: 2px;
    margin-top: 8px;
    border-radius: 2px;
    background: var(--color-accent);
  }
  .legal-section p,
  .legacy-body {
    color: var(--color-text-muted);
    font-size: 14.5px;
    line-height: 1.8;
    margin-top: var(--space-3);
  }
  .legal-section ul {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .legal-section li {
    position: relative;
    padding-left: var(--space-5);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: 14.5px;
    line-height: 1.8;
  }
  .legal-section li::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  /* set:html content carries no Astro scope id — target it via :global() */
  .legal-section :global(a) {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
  }
  .legal-section :global(a:hover) {
    text-decoration: underline;
  }
  .legal-section :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ---- Status footnote (About page phased-launch note) ---- */
  .page-note {
    margin-top: var(--space-6);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
    background: var(--color-tint);
    color: var(--color-text-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  /* ---- Closing grid: related documents + trust/questions ---- */
  .closing {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .related {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-tint);
  }
  .related .card-label {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .related-list {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .rrow {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 4px 10px;
    margin-top: 4px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 13px;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .rrow .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .rlabel {
    color: var(--color-primary);
    font-weight: 500;
    transition: color 0.15s ease;
  }
  a.rrow:hover,
  a.rrow:focus-visible {
    background: var(--color-surface);
    border-color: var(--color-border);
  }
  a.rrow:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .rarrow {
    margin-left: auto;
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  a.rrow:hover .rarrow,
  a.rrow:focus-visible .rarrow {
    opacity: 1;
    transform: translateX(0);
  }
  .rrow.current {
    background: var(--color-surface);
    border-color: var(--color-border);
  }
  .rrow.current .dot {
    background: var(--color-primary);
  }
  .rrow.current .rlabel {
    color: var(--color-primary);
  }
  .chip-current {
    margin-left: auto;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
    font-size: 10.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .trust-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-accent-soft);
  }
  .trust-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .trust-title {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .trust-text {
    margin: var(--space-1) 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .questions-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-tint);
  }
  .questions-card .card-label {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .mail-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-2) 0;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
  }
  .mail-link:hover {
    text-decoration: underline;
  }
  .mail-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 6px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-6);
    min-height: var(--target-min);
    color: var(--color-primary);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  .back:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 6px;
  }

  /* ---- Responsive ---- */
  @media (min-width: 640px) {
    .toc-list {
      grid-template-columns: 1fr 1fr;
    }
    .legal-head h1 {
      margin-top: var(--space-4);
    }
  }
  /* Comfortable touch targets on small screens / coarse pointers */
  @media (max-width: 768px), (pointer: coarse) {
    .toc-list a,
    .rrow {
      min-height: var(--target-min);
    }
  }
  @media (min-width: 900px) {
    .closing {
      grid-template-columns: 7fr 5fr;
      align-items: start;
    }
  }
</style>
