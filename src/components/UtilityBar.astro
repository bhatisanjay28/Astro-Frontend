---
/**
 * Top utility bar (home design §4): precision guarantee, language switch,
 * light/dark toggle. Persists the choice (localStorage "vyotish-theme") and
 * toggles BOTH the .dark class (Tailwind) and data-theme (legacy tokens).
 * S22: Base computes the counterpart hrefs — exact on / and /horoscope/*,
 * flat language-home fallback elsewhere (never a dead link).
 */
interface Props {
  lang?: "en" | "hi";
  /** English counterpart href (used when the page is Hindi). */
  enHref?: string;
  /** Hindi counterpart href (used when the page is English). */
  hiHref?: string;
}
const { lang = "en", enHref = "/", hiHref = "/hi/" } = Astro.props;
---

<aside class="chrome-reset bg-light-surface-variant dark:bg-dark-surface-variant border-b border-light-outline-variant/60 dark:border-dark-outline-variant/40 py-2 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-4 text-light-outline dark:text-dark-outline">
      <span class="inline-flex items-center gap-1 font-body text-body-sm">
        <span class="material-symbols-outlined text-title-md text-accent">auto_awesome</span>
        astronomy-engine &amp; Lahiri Ayanamsha precision computation
      </span>
      <span class="hidden md:inline text-light-outline font-body text-body-sm">|</span>
      <span class="hidden md:inline font-body text-body-sm">Calculated from local sunrise &amp; true astronomical coordinates</span>
    </div>
    <div class="flex items-center gap-4">
      <!-- Language Switcher. The ACTIVE language renders as a plain span
           (aria-current) — a javascript:void(0) link is both a fake link for
           AT and would be blocked once CSP ships (UX audit F5). Inactive one
           is a real link, padded to a 24px-min tap target (F6). -->
      <div class="flex items-center gap-1 bg-light-surface dark:bg-dark-surface rounded px-2 py-1 border border-light-outline-variant dark:border-dark-outline-variant">
        {
          lang === "en" ? (
            <span class="inline-flex items-center font-label text-label-sm px-2 py-1.5 font-semibold text-light-primary dark:text-dark-primary" aria-current="true">English</span>
          ) : (
            <a href={enHref} class="inline-flex items-center font-label text-label-sm px-2 py-1.5 font-medium text-light-outline dark:text-dark-outline hover:text-light-on-surface dark:hover:text-dark-on-surface">English</a>
          )
        }
        <span class="text-light-outline font-label text-label-sm">/</span>
        {
          lang === "hi" ? (
            <span lang="hi" class="inline-flex items-center hi-text font-label text-label-sm px-2 py-1.5 font-semibold text-light-primary dark:text-dark-primary" aria-current="true">हिन्दी</span>
          ) : (
            <a href={hiHref} lang="hi" class="inline-flex items-center hi-text font-label text-label-sm px-2 py-1.5 font-medium text-light-outline dark:text-dark-outline hover:text-light-on-surface dark:hover:text-dark-on-surface">हिन्दी</a>
          )
        }
      </div>
      <!-- Light / Dark Mode Toggle (44×44 tap target, UX audit F6) -->
      <button
        type="button"
        data-theme-toggle
        class="inline-flex h-11 w-11 items-center justify-center rounded text-light-outline dark:text-dark-outline hover:text-light-on-surface dark:hover:text-dark-on-surface focus-visible:ring-2 focus-visible:ring-light-primary"
        title="Toggle Light/Dark Theme"
        aria-label="Toggle Theme"
      >
        <span class="material-symbols-outlined text-title-md dark:hidden">dark_mode</span>
        <span class="material-symbols-outlined text-title-md hidden dark:inline">light_mode</span>
      </button>
    </div>
  </div>
</aside>

<script>
  // Theme toggle — persists choice; keeps Tailwind .dark class and legacy
  // data-theme attribute in lockstep (bootstrap in Base.astro reads both).
  document.querySelectorAll("[data-theme-toggle]").forEach((el) => {
    el.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.classList.contains("dark") ? "light" : "dark";
      root.classList.toggle("dark", next === "dark");
      if (next === "dark") root.setAttribute("data-theme", "dark");
      else root.removeAttribute("data-theme");
      try {
        localStorage.setItem("vyotish-theme", next);
      } catch {
        /* storage unavailable — session-only theme */
      }
    });
  });
</script>
