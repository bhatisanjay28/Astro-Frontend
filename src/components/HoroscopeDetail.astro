---
/**
 * Horoscope detail — main column of /horoscope/{sign}/{period}
 * (Horoscope Upgrade Step 4; design spec §1–§2, §4).
 *
 * Server-renders the generated payload fetched at build time (resolve-current
 * API): overview, thought strip, category cards, do/don't, best/testing day
 * pills, sky block, Sade Sati note, month table. Filled chips only where D4
 * allows (month table rows); category headings carry a small bandmark glyph
 * (spec §8 flag 1). Legacy rows (payload absent) render the five text columns
 * without chips. Honest empty state when nothing exists.
 */
import type { HoroscopeBlocks, HoroscopePayload, HoroscopeSignRow } from "../lib/content";
import { DETAIL, type HoroLang, MONTHS_SHORT as L10N_MONTHS } from "../lib/horoscope-l10n";
import HoroscopeChip from "./HoroscopeChip.astro";

export interface Props {
  period: string;
  signEn: string;
  row: HoroscopeSignRow | null;
  blocks: HoroscopeBlocks;
  range: { start: string; end: string } | null;
  lang?: HoroLang;
  signHi?: string;
}

const { period, signEn, row, blocks, range, lang = "en", signHi } = Astro.props;
const hi = lang === "hi";
const payload: HoroscopePayload | null = row?.payload ?? null;

const H = blocks.headers ?? {};
const AREA = blocks.area_names ?? {};
const LABELS = blocks.rating_labels?.labels ?? {};
const bandmark = (band?: string): { label: string; glyph: string } | null => {
  if (!band || !LABELS[band]) return null;
  return { label: LABELS[band].label, glyph: LABELS[band].glyph };
};

const MONTHS = L10N_MONTHS[lang];
const fmtDay = (key: string): string => {
  const [y, m, d] = key.split("-").map(Number);
  return `${MONTHS[(m ?? 1) - 1]} ${d}, ${y}`;
};
const fmtShort = (key: string): string => {
  const [, m, d] = key.split("-").map(Number);
  return `${MONTHS[(m ?? 1) - 1]} ${d}`;
};

const isDaily = period === "yesterday" || period === "daily" || period === "tomorrow";
const isWeekly = period === "weekly";
const isMonthly = period === "monthly";
const isYearly = period === "yearly";

/** Daily/weekly/monthly 5-card layout order (Career & Money combined per D1). */
const CARD_ORDER: Array<{ key: string; combined?: string }> = [
  { key: "health" },
  { key: "career", combined: "money" },
  { key: "love" },
  { key: "education" },
  { key: "family" },
];

// Sade Sati detection must work in both langs — the payload keeps the EN
// structural `label` even on Hindi rows, while `label_hi` carries the prefix.
const isSadeSati = (ph: { label: string; label_hi: string }): boolean =>
  ph.label.includes("Sade Sati") || ph.label_hi.includes("साढ़े साती");
const phaseName = (ph: { label: string; label_hi: string }): string =>
  (hi ? ph.label_hi : ph.label).replace(hi ? /^साढ़े साती\s*—\s*/ : /^Sade Sati\s*—\s*/, "");
const phaseMonths = (ph: { months_en: string; months_hi: string }): string =>
  hi ? ph.months_hi : ph.months_en;
const fillWhy = (tpl: string, p: { planet: string; sign: string }): string =>
  tpl.replace(/\{\{planet\}\}/g, p.planet).replace(/\{\{sign\}\}/g, p.sign);
const fillNote = (tpl: string, phase: string, months: string): string =>
  tpl.replace(/\{\{phase\}\}/g, phase).replace(/\{\{months\}\}/g, months);

const unavailable = DETAIL[lang].unavailable;
const hasLegacy = !!row && (row.overview || row.love || row.career || row.finance || row.health);
const LEGACY: Array<[string, string]> = [
  ["love", DETAIL[lang].legacy_love],
  ["career", DETAIL[lang].legacy_career],
  ["finance", DETAIL[lang].legacy_finance],
  ["health", DETAIL[lang].legacy_health],
];
---

<section
  class:list={["hzd", { "hzd-hi": hi }]}
  aria-label={hi ? `${signHi ?? signEn} राशिफल` : `${signEn} horoscope`}
>
  {
    !row && <p class="hzd-empty">{unavailable}</p>
  }

  {
    row && !payload && hasLegacy && (
      <div class="hzd-card">
        {row.overview && (
          <>
            <h2>{H.overview ?? "Overview"}</h2>
            <p>{row.overview}</p>
          </>
        )}
        {LEGACY.map(([key, label]) =>
          row[key as "love"] ? (
            <>
              <h3>{label}</h3>
              <p>{row[key as "love"]}</p>
            </>
          ) : null,
        )}
      </div>
    )
  }

  {
    row && !payload && !hasLegacy && <p class="hzd-empty">{unavailable}</p>
  }

  {
    payload && (
      <>
        {payload.range && !isYearly && (
          <p class="hzd-range">
            {fmtDay(payload.range.start)} – {fmtDay(payload.range.end)}
          </p>
        )}

        <div class="hzd-card">
          <h2>
            {isYearly
              ? (H.year_overview ?? "Year overview")
              : isMonthly
                ? (H.monthly_overview ?? "This month's overview")
                : (H.overview ?? "Overview")}
            {(() => {
              const bm = bandmark(payload.rating);
              return bm ? <span class={`hzd-bandmark ${payload.rating}`}>{bm.glyph} {bm.label}</span> : null;
            })()}
          </h2>
          <p>{payload.overview.text}</p>
        </div>

        {payload.thought && (
          <aside class="hzd-thought">
            <span class="lbl">{H.thought_of_day ?? "Thought of the day"}</span>
            <p>{payload.thought.text}</p>
          </aside>
        )}

        {(isDaily || isWeekly || isMonthly) && payload.areas && (
          <div class="hzd-catgrid">
            {CARD_ORDER.map(({ key, combined }) => {
              const a = payload.areas?.[key];
              if (!a) return null;
              const bm = bandmark(a.rating);
              const extra = combined ? payload.areas?.[combined] : null;
              return (
                <article class={`hzd-card${combined ? " wide" : ""}`}>
                  <h3>
                    {combined ? (AREA.career_money ?? "Career & Money") : (AREA[key] ?? key)}
                    {bm && <span class={`hzd-bandmark ${a.rating}`}>{bm.glyph} {bm.label}</span>}
                  </h3>
                  <p>{a.text}</p>
                  {extra && combined && (
                    <>
                      <h4>{AREA[combined] ?? combined}</h4>
                      <p>{extra.text}</p>
                    </>
                  )}
                  {key === "health" && payload.chandrashtama && blocks.chandrashtama_tag && (
                    <p class="hzd-note">{blocks.chandrashtama_tag.text}</p>
                  )}
                </article>
              );
            })}
          </div>
        )}

        {isDaily && (payload.dos || payload.donts) && (
          <div class="hzd-dos">
            {payload.dos && (
              <article class="hzd-card do">
                <h3>{H.dos_heading ?? "Do"}</h3>
                <p>{payload.dos.text}</p>
              </article>
            )}
            {payload.donts && (
              <article class="hzd-card dont">
                <h3>{H.donts_heading ?? "Avoid"}</h3>
                <p>{payload.donts.text}</p>
              </article>
            )}
          </div>
        )}

        {isMonthly && payload.best_days && payload.best_days.length > 0 && (
          <div class="hzd-dayrow" role="list" aria-label={H.best_days ?? "Best days"}>
            <span class="cap">{H.best_days ?? "Best days"}</span>
            {payload.best_days.map((b) => (
              <span class="hzd-daypill best" role="listitem">
                <span aria-hidden="true">▲</span> {fmtShort(b.date)} ·{" "}
                {(hi ? b.planets_hi : b.planets_en).join(", ")}
              </span>
            ))}
            {payload.testing_day && (
              <span class="hzd-daypill test" role="listitem">
                <span aria-hidden="true">▼</span> {fmtShort(payload.testing_day.date)} ·{" "}
                {(hi ? payload.testing_day.planets_hi : payload.testing_day.planets_en).join(", ")}
              </span>
            )}
          </div>
        )}

        {isMonthly && payload.sky && payload.sky.length > 0 && (
          <div class="hzd-card">
            <h2>{H.sky_block ?? "This month's sky"}</h2>
            <ul class="hzd-sky">
              {payload.sky.map((s) => (
                <li>
                  <b>{fmtShort(s.date)}</b> — {hi ? s.hi || s.en : s.en}
                </li>
              ))}
            </ul>
          </div>
        )}

        {isYearly && payload.sadesati?.active && blocks.sadesati_note && (
          <aside class="hzd-sadesati">
            {/* Dhaiya/Ashtama years get their own heading — the card is not always Sade Sati */}
            <h2>
              {payload.sadesati.phases.some(isSadeSati)
                ? DETAIL[lang].sadesati
                : DETAIL[lang].saturn_phase}
            </h2>
            {payload.sadesati.phases.map((ph) => (
              <p>
                {fillNote(blocks.sadesati_note!.text, phaseName(ph), phaseMonths(ph))}
              </p>
            ))}
          </aside>
        )}

        {isYearly && payload.year_areas && (
          <div class="hzd-catgrid">
            {Object.entries(payload.year_areas).map(([key, a]) => {
              const bm = bandmark(a.rating);
              return (
                <article class="hzd-card">
                  <h3>
                    {AREA[key] ?? key}
                    {bm && <span class={`hzd-bandmark ${a.rating}`}>{bm.glyph} {bm.label}</span>}
                  </h3>
                  <p>{a.text}</p>
                </article>
              );
            })}
          </div>
        )}

        {isYearly && payload.month_table && payload.month_table.length > 0 && (
          <div class="hzd-card">
            <table class="hzd-mtable">
              <caption>
                {H.month_table ?? "Month by month"}
                {blocks.month_clause_intro?.text ? ` — ${blocks.month_clause_intro.text}` : ""}
              </caption>
              <thead>
                <tr>
                  <th scope="col">{DETAIL[lang].month_col}</th>
                  <th scope="col">{H.outlook_col ?? "Outlook"}</th>
                  <th scope="col"><span class="visually-hidden">{DETAIL[lang].rating_col}</span></th>
                </tr>
              </thead>
              <tbody>
                {payload.month_table.map((m) => {
                  const lbl = LABELS[m.rating];
                  return (
                    <tr>
                      <th scope="row">{hi ? m.month_hi || m.month : m.month}</th>
                      <td>{m.clause}</td>
                      <td>
                        {lbl ? (
                          <HoroscopeChip band={m.rating} label={lbl.label} glyph={lbl.glyph} />
                        ) : null}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </>
    )
  }
</section>

<style>
  .hzd-empty {
    background: var(--bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    color: var(--text-dim);
    font-size: 14px;
  }
  .hzd-range {
    color: var(--text-muted);
    font-size: 13.5px;
    margin-bottom: var(--space-3);
  }
  .hzd-card {
    background: var(--bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
  }
  .hzd-card + .hzd-card,
  .hzd-catgrid,
  .hzd-thought,
  .hzd-dos,
  .hzd-dayrow,
  .hzd-sadesati {
    margin-top: var(--space-4);
  }
  .hzd-card h2 {
    font-family: var(--font-display);
    color: var(--gold);
    font-size: 16px;
    margin-bottom: var(--space-2);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .hzd-card h3,
  .hzd-card h4 {
    font-family: var(--font-title);
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-1);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .hzd-card h4 {
    margin-top: var(--space-3);
    text-transform: none;
    letter-spacing: 0;
    font-size: 13.5px;
    color: var(--text-body);
  }
  .hzd-card p {
    color: var(--text-body);
    font-size: 14px;
    line-height: 1.65;
  }
  .hzd-card p + p {
    margin-top: var(--space-2);
  }
  .hzd-bandmark {
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }
  .hzd-bandmark.excellent { color: var(--rating-excellent-text); }
  .hzd-bandmark.good { color: var(--rating-good-text); }
  .hzd-bandmark.moderate { color: var(--rating-moderate-text); }
  .hzd-bandmark.challenging { color: var(--rating-challenging-text); }
  .hzd-note {
    margin-top: var(--space-2);
    font-size: 13px;
    color: var(--text-muted);
    font-style: italic;
    border-top: 1px dashed var(--color-border);
    padding-top: var(--space-2);
  }
  .hzd-thought {
    background: var(--color-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-5);
  }
  .hzd-thought .lbl {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: var(--space-1);
  }
  .hzd-thought p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15.5px;
    color: var(--gold);
    line-height: 1.6;
  }
  .hzd-catgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .hzd-catgrid .hzd-card {
    margin-top: 0;
    padding: var(--space-4);
  }
  .hzd-catgrid .hzd-card.wide {
    grid-column: 1 / -1;
  }
  .hzd-dos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .hzd-dos .hzd-card {
    margin-top: 0;
    padding: var(--space-4);
    border-left: 4px solid var(--color-border);
  }
  .hzd-dos .do { border-left-color: var(--rating-excellent-text); }
  .hzd-dos .dont { border-left-color: var(--rating-challenging-text); }
  .hzd-dayrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .hzd-dayrow .cap {
    font-size: 13px;
    color: var(--text-muted);
    font-style: italic;
  }
  .hzd-daypill {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    border-radius: var(--radius-pill);
    padding: 5px 14px;
    font-size: 13px;
    font-weight: 600;
  }
  .hzd-daypill.best {
    color: var(--rating-excellent-text);
    background: var(--rating-excellent-bg);
  }
  .hzd-daypill.test {
    color: var(--rating-challenging-text);
    background: var(--rating-challenging-bg);
  }
  .hzd-sky {
    list-style: none;
    margin: 0;
  }
  .hzd-sky li {
    padding: var(--space-2) 0 var(--space-2) var(--space-5);
    position: relative;
    border-bottom: 1px dashed var(--color-border);
    font-size: 14px;
    color: var(--text-body);
  }
  .hzd-sky li:last-child { border-bottom: none; }
  .hzd-sky li::before {
    content: "✦";
    position: absolute;
    left: 2px;
    top: var(--space-2);
    color: var(--color-accent-text);
    font-size: 12px;
  }
  .hzd-sky b { color: var(--text-body); }
  .hzd-sadesati {
    background: var(--rating-moderate-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
  }
  .hzd-sadesati h2 {
    font-family: var(--font-display);
    color: var(--rating-moderate-text);
    font-size: 15px;
    margin-bottom: var(--space-1);
  }
  .hzd-sadesati p {
    color: var(--text-body);
    font-size: 14px;
    line-height: 1.65;
  }
  .hzd-sadesati p + p { margin-top: var(--space-2); }
  .hzd-mtable {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .hzd-mtable caption {
    text-align: left;
    font-size: 13px;
    color: var(--text-muted);
    padding-bottom: var(--space-2);
  }
  .hzd-mtable th {
    text-align: left;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 2px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    font-weight: 600;
  }
  .hzd-mtable td {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    vertical-align: top;
    color: var(--text-body);
    font-size: 14px;
    line-height: 1.55;
  }
  .hzd-mtable tbody th {
    border-bottom: 1px solid var(--color-border);
    text-transform: none;
    letter-spacing: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-body);
    white-space: nowrap;
    padding: var(--space-2) var(--space-3);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 639px) {
    .hzd-catgrid,
    .hzd-dos {
      grid-template-columns: 1fr;
    }
  }

  /* Hindi variant (S22): Devanagari text uses the self-hosted Devanagari
     face — the Latin display/title fonts carry no Devanagari glyphs. */
  .hzd-hi {
    font-family: "Noto Sans Devanagari", var(--font-body);
  }
  .hzd-hi .hzd-card h2,
  .hzd-hi .hzd-sadesati h2,
  .hzd-hi .hzd-thought p {
    font-family: "Noto Sans Devanagari", var(--font-display);
  }
  .hzd-hi .hzd-card h3,
  .hzd-hi .hzd-card h4,
  .hzd-hi .hzd-mtable th,
  .hzd-hi .hzd-thought .lbl,
  .hzd-hi .hzd-dayrow .cap {
    font-family: "Noto Sans Devanagari", var(--font-body);
  }
</style>
