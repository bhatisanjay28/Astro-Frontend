---
/**
 * Swappable brand wordmark (docs/placeholders.md P1).
 * The SVG lives in ONE file — `src/assets/brand/vyotish-wordmark.svg` — so the
 * owner's final logo replaces it without touching any page. Wired into the
 * site header in Epic 2.1.
 */
import wordmark from "../assets/brand/vyotish-wordmark.svg";
---

<img class="wordmark" src={wordmark.src} width="220" height="56" alt="Vyotish — Vedic Astrology" />

<style>
  .wordmark {
    display: block;
    height: auto;
  }
</style>
