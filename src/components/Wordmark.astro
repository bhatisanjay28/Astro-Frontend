---
/**
 * Swappable brand wordmark (docs/placeholders.md P1).
 * The SVG lives in ONE file — `src/assets/brand/vyotish-wordmark.svg` — and is
 * inlined here (Vite `?raw`) so its CSS-variable fills adapt to light/dark.
 */
import wordmarkRaw from "../assets/brand/vyotish-wordmark.svg?raw";
---

<span class="wordmark" set:html={wordmarkRaw} />

<style>
  .wordmark {
    display: inline-flex;
    height: 40px;
    width: auto;
  }
  .wordmark :global(svg) {
    height: 100%;
    width: auto;
  }
</style>
