---
/**
 * Site footer — home design §4 (D11 re-skin): brand & mission, 9 portals,
 * popular tools, trust & legal, mandatory astrological disclaimer.
 * (The newsletter moved to the home FAQ section; the footer matches the
 * approved design exactly.)
 */
import { NAV_TABS } from "../data/navigation";

const portals = NAV_TABS.map((t, i) => ({
  n: i + 1,
  label: t.label,
  href: t.href,
  suffix: t.label === "Gemstones" ? " (Soon)" : t.label === "Blog" ? " & Admin" : "",
  display:
    t.label === "Panchang"
      ? "Daily Panchang"
      : t.label === "Muhurat"
        ? "Shubh Muhurat"
        : t.label === "Astrology"
          ? "Astrology (Kundli)"
          : t.label === "Poojan"
            ? "Vedic Poojan"
            : t.label === "Blog"
              ? "Blog"
              : t.label,
}));

const tools = [
  { label: "Free Janam Kundli", href: "/kundli" },
  { label: "Kundli Matching (36 Guna)", href: "/matching" },
  { label: "Moon Sign (Rashi) Finder", href: "/calculators/rashi" },
  { label: "Nakshatra Calculator", href: "/calculators/rashi" },
  { label: "Shani Sade Sati Check", href: "/calculators/sade-sati" },
  { label: "Manglik Dosha Analysis", href: "/calculators/mangal-dosha" },
  { label: "Vedic Numerology", href: "/calculators" },
];

const legal = [
  { label: "Privacy Policy (DPDP Act)", href: "/privacy" },
  { label: "Terms of Use", href: "/terms" },
  { label: "Refund & Cancellation", href: "/refund" },
  { label: "Astrological Disclaimer", href: "/disclaimer" },
  { label: "About Calculation Accuracy", href: "/about" },
  { label: "Grievance & Contact", href: "/contact" },
];
---

<footer class="chrome-reset bg-light-surface-variant dark:bg-dark-surface-variant border-t border-light-outline-variant/60 dark:border-dark-outline-variant/40 pt-12 pb-8 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
    <!-- Brand & Mission Column -->
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded bg-light-primary text-light-on-primary flex items-center justify-center font-display font-bold">V</div>
        <span class="font-display font-bold text-headline-sm text-light-on-surface dark:text-dark-on-surface">Vyotish</span>
      </div>
      <p class="font-body text-body-sm text-light-outline dark:text-dark-outline max-w-sm mb-4 leading-relaxed">
        Authentic Vedic astrology calculated with modern astronomical rigor. Providing accessible, zero-cost Janam Kundli charts, precision daily Panchang, and vetted scholar consultations.
      </p>
      <div class="font-body text-body-sm text-light-outline dark:text-dark-outline space-y-1">
        <div>Engine: Swiss Ephemeris • Lahiri Ayanamsha (Chitra Paksha)</div>
        <div>Timezones: IANA Global Astronomical Database</div>
      </div>
    </div>

    <!-- Quick Nav: 9 Main Tabs -->
    <nav aria-label="Portals">
      <h4 class="font-title text-title-sm font-semibold text-light-on-surface dark:text-dark-on-surface mb-3">Portals</h4>
      <ul class="space-y-1 font-body text-body-sm text-light-outline dark:text-dark-outline">
        {
          portals.map((p) => (
            <li>
              <a href={p.href} class="inline-flex items-center py-1 hover:text-light-primary dark:hover:text-dark-primary">
                {p.n}. {p.display}
                {p.suffix}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Free Calculators Tier 1 -->
    <nav aria-label="Popular Tools">
      <h4 class="font-title text-title-sm font-semibold text-light-on-surface dark:text-dark-on-surface mb-3">Popular Tools</h4>
      <ul class="space-y-1 font-body text-body-sm text-light-outline dark:text-dark-outline">
        {
          tools.map((t) => (
            <li>
              <a href={t.href} class="inline-flex items-center py-1 hover:text-light-primary dark:hover:text-dark-primary">{t.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Legal & Trust Policies (Mandatory Section 15) -->
    <nav aria-label="Trust and Legal">
      <h4 class="font-title text-title-sm font-semibold text-light-on-surface dark:text-dark-on-surface mb-3">Trust &amp; Legal</h4>
      <ul class="space-y-1 font-body text-body-sm text-light-outline dark:text-dark-outline">
        {
          legal.map((l) => (
            <li>
              <a href={l.href} class="inline-flex items-center py-1 hover:text-light-primary dark:hover:text-dark-primary">{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- MANDATORY LEGAL DISCLAIMER (Section 15) -->
  <div class="max-w-7xl mx-auto pt-6 border-t border-light-outline-variant/40 font-body text-body-sm text-light-outline dark:text-dark-outline space-y-2">
    <p>
      <strong>Astrological Disclaimer:</strong> Astrology content, horoscope readings, and calculation tools provided on Vyotish are for philosophical guidance, self-discovery, and cultural informational purposes only. Astrological outcomes cannot be guaranteed. This platform does not provide or replace certified medical diagnoses, legal counsel, psychiatric therapy, or licensed financial planning.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-between pt-4 font-body text-body-sm">
      <div>© {new Date().getFullYear()} Vyotish Platform. All rights reserved.</div>
      <div class="flex gap-4 mt-2 sm:mt-0">
        {/* CSP claim intentionally absent — story 7.2 hasn't shipped; only
            promises that are true today are shown (UX audit F14) */}
        <span>Zero OTP — we never ask for one-time passwords</span>
      </div>
    </div>
  </div>
</footer>
