---
/**
 * Site footer — home design §4 (D11 re-skin): brand & mission, 9 portals,
 * popular tools, trust & legal, mandatory astrological disclaimer.
 * (The newsletter moved to the home FAQ section; the footer matches the
 * approved design exactly.)
 *
 * Link-column polish (Sally UX pass, 2026-11-20; Stitch "Vyotish — UX
 * Designs (Sally)" footer screen): Cinzel column headings with gold
 * underline bars, gold dot bullets replace literal "1. 2. 3." numbers,
 * 34px row rhythm (44px on touch/mobile), hover = terracotta label +
 * sliding arrow, "Soon" pill badge instead of "(Soon)" text suffix.
 * Data fixes in the same pass: "Nakshatra Calculator" removed (no such
 * tool exists — it linked to the Moon Sign page), "Vedic Numerology"
 * now points at /calculators/numerology instead of the hub, "Blog & Admin"
 * simplified to "Blog" (internal chrome stays out of public copy — audit C5).
 */
import { NAV_TABS } from "../data/navigation";

const portals = NAV_TABS.map((t) => ({
  label: t.label,
  href: t.href,
  soon: t.label === "Gemstones",
  display:
    t.label === "Panchang"
      ? "Daily Panchang"
      : t.label === "Muhurat"
        ? "Shubh Muhurat"
        : t.label === "Astrology"
          ? "Astrology (Kundli)"
          : t.label === "Poojan"
            ? "Vedic Poojan"
            : t.label,
}));

const tools = [
  { label: "Free Janam Kundli", href: "/kundli" },
  { label: "Kundli Matching (36 Guna)", href: "/matching" },
  { label: "Moon Sign (Rashi) Finder", href: "/calculators/rashi" },
  { label: "Shani Sade Sati Check", href: "/calculators/sade-sati" },
  { label: "Manglik Dosha Analysis", href: "/calculators/mangal-dosha" },
  { label: "Vedic Numerology", href: "/calculators/numerology" },
];

const legal = [
  { label: "Privacy Policy (DPDP Act)", href: "/privacy" },
  { label: "Terms of Use", href: "/terms" },
  { label: "Refund & Cancellation", href: "/refund" },
  { label: "Astrological Disclaimer", href: "/disclaimer" },
  { label: "About Vyotish", href: "/about" },
  { label: "Grievance & Contact", href: "/contact" },
];
---

<footer class="footer chrome-reset">
  <div class="cols">
    <!-- Brand & Mission Column -->
    <div class="brand">
      <div class="brand-row">
        <div class="brand-tile">V</div>
        <span class="brand-name">Vyotish</span>
      </div>
      <p class="mission">
        Authentic Vedic astrology calculated with modern astronomical rigor. Providing accessible, zero-cost Janam Kundli charts, precision daily Panchang, and straightforward consultation booking.
      </p>
      <div class="meta">
        <div>Engine: astronomy-engine • Lahiri Ayanamsha</div>
        <div>Timezones: IANA Time Zone Database</div>
      </div>
      <div class="trust-chip">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>Zero OTP — we never ask for one-time passwords</span>
      </div>
    </div>

    <!-- Quick Nav: 9 Main Tabs -->
    <nav aria-label="Portals">
      <h2 class="col-head">Portals</h2>
      <ul class="links">
        {
          portals.map((p) => (
            <li>
              <a href={p.href} class="flink">
                <span class="dot" aria-hidden="true" />
                <span class="flabel">{p.display}</span>
                {p.soon && <span class="badge-soon">Soon</span>}
                <svg class="farrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Free Calculators Tier 1 -->
    <nav aria-label="Popular Tools">
      <h2 class="col-head">Popular Tools</h2>
      <ul class="links">
        {
          tools.map((t) => (
            <li>
              <a href={t.href} class="flink">
                <span class="dot" aria-hidden="true" />
                <span class="flabel">{t.label}</span>
                <svg class="farrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Legal & Trust Policies (Mandatory Section 15) -->
    <nav aria-label="Trust and Legal">
      <h2 class="col-head">Trust &amp; Legal</h2>
      <ul class="links">
        {
          legal.map((l) => (
            <li>
              <a href={l.href} class="flink">
                <span class="dot" aria-hidden="true" />
                <span class="flabel">{l.label}</span>
                <svg class="farrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- MANDATORY LEGAL DISCLAIMER (Section 15) -->
  <div class="legal-band">
    <p>
      <strong>Astrological Disclaimer:</strong> Astrology content, horoscope readings, and calculation tools provided on Vyotish are for philosophical guidance, self-discovery, and cultural informational purposes only. Astrological outcomes cannot be guaranteed. This platform does not provide or replace certified medical diagnoses, legal counsel, psychiatric therapy, or licensed financial planning.
    </p>
    <div class="legal-row">
      <div>© {new Date().getFullYear()} Vyotish Platform. All rights reserved.</div>
      <div>Astrological content is for guidance, not a substitute for professional advice.</div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-tint);
    border-top: 1px solid var(--color-border);
    padding: var(--space-7) var(--space-4) var(--space-5);
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }
  .cols {
    max-width: 1200px;
    margin: 0 auto var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  /* ---- Brand column ---- */
  .brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .brand-tile {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-text);
  }
  .mission {
    max-width: 38ch;
    margin: 0 0 var(--space-4);
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  .meta {
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--color-text-muted);
  }
  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 6px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: 11.5px;
    color: var(--color-text-muted);
  }
  .trust-chip svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ---- Column headings (Cinzel + gold bar) ---- */
  .col-head {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }
  .col-head::after {
    content: "";
    display: block;
    width: 24px;
    height: 2px;
    margin-top: 6px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  /* ---- Link rows ---- */
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links li {
    display: block;
  }
  .flink {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 2px 0;
    font-size: 13px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.55;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }
  .flabel {
    transition: color 0.15s ease;
  }
  .farrow {
    margin-left: auto;
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .flink:hover .flabel,
  .flink:focus-visible .flabel {
    color: var(--color-primary);
  }
  .flink:hover .dot,
  .flink:focus-visible .dot {
    opacity: 1;
  }
  .flink:hover .farrow,
  .flink:focus-visible .farrow {
    opacity: 1;
    transform: translateX(0);
  }
  .flink:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 6px;
  }
  .badge-soon {
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
    font-size: 10.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* ---- Mandatory legal band ---- */
  .legal-band {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  .legal-band p {
    margin: 0;
  }
  .legal-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
  }

  /* ---- Responsive ---- */
  @media (min-width: 640px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .cols {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: var(--space-6);
    }
    .legal-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  /* Comfortable touch targets on small screens / coarse pointers */
  @media (max-width: 768px), (pointer: coarse) {
    .flink {
      min-height: var(--target-min);
    }
  }
</style>
