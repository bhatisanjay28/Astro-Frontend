---
import Base from "../../layouts/Base.astro";
import { fetchHoroscopePage } from "../../lib/content";
import {
  type HoroLang,
  LORD_HI,
  MONTHS_FULL,
  MONTHS_SHORT,
  PERIOD_LABEL,
  PERIOD_TITLE,
  WEEKDAYS,
} from "../../lib/horoscope-l10n";
/**
 * Shared body of /horoscope/{sign}/{period} and its Hindi twin
 * /hi/horoscope/{sign}/{period} (S22).
 *
 * Horoscope Upgrade Step 4 (spec §1, §5, §6) + S22 i18n:
 * - Build-time SSR: the resolve-current API is fetched once per page at build
 *   (Astro static output) IN THE PAGE LANGUAGE and the payload renders
 *   server-side by HoroscopeDetail + HoroscopeSidebar — zero client fetch.
 * - Freshness: the backend cron pings the CF Pages deploy hook after
 *   generation, so dated rows are re-baked daily by a rebuild.
 * - Fail-soft ladder (all baked, never faked):
 *     generated payload → legacy five-text-column row → honest unavailable line.
 * - Fixed page strings (disclaimer, disclosure, rating labels, lucky why) come
 *   from content_blocks horoscope.* via the API (D12); page furniture (h1,
 *   chips, crumbs, dates, picker) is frontend chrome translated per lang.
 * - Both routes pass the same langPath → Base emits the en/hi hreflang pair.
 */
import HoroscopeDetail from "../HoroscopeDetail.astro";
import HoroscopeSidebar from "../HoroscopeSidebar.astro";

export interface SignDef {
  slug: string;
  symbol: string;
  hi: string;
  /** Transliteration shown in EN headings ("Simha (Leo)"). */
  en: string;
  /** Short zodiac name for the picker chips ("Leo") — S22 item 3. */
  zodiac: string;
  lord: string;
}
export interface PeriodDef {
  slug: string;
  label: string;
}
export interface Props {
  lang: HoroLang;
  sign: SignDef;
  period: PeriodDef;
  signs: SignDef[];
  periods: PeriodDef[];
}

const { lang, sign, period, signs, periods } = Astro.props;
const hi = lang === "hi";
const R = hi ? "राशिफल" : "Rashiphal";
const title = PERIOD_TITLE[lang][period.slug] ?? "";
const hubHref = hi ? "/hi/horoscope/" : "/horoscope/";

// Build-time resolve-current fetch — fail-soft null when the API is unreachable.
const page = await fetchHoroscopePage(period.slug, sign.slug, lang);
const row = page?.row ?? null;
const blocks = page?.blocks ?? {};

const fmtLong = (key: string): string => {
  const [y, m, d] = key.split("-").map(Number);
  const wd = WEEKDAYS[lang][new Date(Date.UTC(y, (m ?? 1) - 1, d ?? 1)).getUTCDay()];
  return hi
    ? `${wd}, ${d} ${MONTHS_FULL.hi[(m ?? 1) - 1]} ${y}`
    : `${wd}, ${d} ${MONTHS_FULL.en[(m ?? 1) - 1]} ${y}`;
};
const fmtShort = (key: string): string => {
  const [, m, d] = key.split("-").map(Number);
  return `${d} ${MONTHS_SHORT[lang][(m ?? 1) - 1]}`;
};

/** Hero meta line baked from the resolved date_key / range. The pre-migration
 * API lacks date_key — guard so a legacy response simply skips the line. */
const metaLine = (() => {
  if (!page?.date_key) return null;
  // Sample (seeded) rows must not wear a dated frame — honesty of the ladder.
  if (row?.is_sample)
    return hi
      ? "नमूना रीडिंग — लाइव रीडिंग तैयार हो रही हैं"
      : "Sample reading — live readings are being prepared";
  if (period.slug === "yearly")
    return hi ? `वर्ष ${page.date_key} के लिए` : `Reading for ${page.date_key}`;
  if (period.slug === "monthly") {
    const [y, m] = page.date_key.split("-").map(Number);
    return hi
      ? `${MONTHS_FULL.hi[(m ?? 1) - 1]} ${y} के लिए`
      : `Reading for ${MONTHS_FULL.en[(m ?? 1) - 1]} ${y}`;
  }
  if (period.slug === "weekly") {
    const r = page.range;
    return r ? `${fmtShort(r.start)} – ${fmtShort(r.end)}` : null;
  }
  return fmtLong(page.date_key);
})();

const lordLabel = hi ? `स्वामी: ${LORD_HI[sign.lord] ?? sign.lord}` : `Lord ${sign.lord}`;
const lede = hi
  ? `चंद्र राशि आधारित वैदिक राशिफल · ${lordLabel} · ${metaLine ?? "रीडिंग तैयार हो रही है"}`
  : `Moon-sign based Vedic horoscope · ${lordLabel} · ${metaLine ?? "Reading being prepared"}`;

const titleTag = hi
  ? `${title} ${R} — ${sign.hi} (${sign.zodiac}) | व्योतिष`
  : `${title} ${R} — ${sign.en} | Vyotish`;
const descTag = hi
  ? `${title} वैदिक राशिफल ${sign.hi} (${sign.zodiac}, चंद्र राशि) — सारांश, प्रेम, करियर, धन, स्वास्थ्य, करें और बचें, साथ ही शुभ रंग, संख्या, देवता और मंत्र।`
  : `${title} Vedic horoscope for ${sign.en} (Moon sign) — overview, love, career, money, health, dos & don'ts, plus lucky colours, number, deity and mantra.`;
---

<Base lang={lang} langPath={`/horoscope/${sign.slug}/${period.slug}`} title={titleTag} description={descTag}>
  <section class:list={["hz", { "hz-hi": hi }]}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={hubHref}>{hi ? "राशिफल" : "Horoscope"}</a>
      <span>/</span>
      <span>{hi ? sign.hi : sign.en}</span>
    </nav>

    <h1>
      <span class="glyph" aria-hidden="true">{sign.symbol}</span>
      {title} {R} — {hi ? sign.hi : sign.en}
      <span class="hi-text" lang={hi ? "en" : "hi"}>({hi ? sign.zodiac : sign.hi})</span>
    </h1>
    <p class="lede">{lede}</p>

    <nav class="periods" aria-label={hi ? "अवधि" : "Period"}>
      {
        periods.map((p) => (
          <a
            class={`chip ${p.slug === period.slug ? "active" : ""}`}
            href={`${hubHref}${sign.slug}/${p.slug}`}
            aria-current={p.slug === period.slug ? "page" : undefined}
          >
            {PERIOD_LABEL[lang][p.slug] ?? p.label}
          </a>
        ))
      }
    </nav>

    <div class="layout">
      <div class="main">
        <HoroscopeDetail
          period={period.slug}
          signEn={sign.en}
          signHi={sign.hi}
          lang={lang}
          row={row}
          blocks={blocks}
          range={page?.range ?? null}
        />
      </div>
      <HoroscopeSidebar
        period={period.slug}
        signSlug={sign.slug}
        lang={lang}
        lucky={row?.payload?.lucky ?? null}
        blocks={blocks}
      />
    </div>

    {
      blocks.disclosure?.text && (
        <details class="how" open>
          <summary>{blocks.headers?.disclosure_title ?? (hi ? "यह कैसे निकाला जाता है" : "How we compute this")}</summary>
          <p>{blocks.disclosure.text}</p>
        </details>
      )
    }
    {blocks.disclaimer?.text && <p class="disclaimer">{blocks.disclaimer.text}</p>}

    <section class="picker" aria-label={hi ? "अन्य राशियाँ" : "Other signs"}>
      <h2>{hi ? "सभी 12 राशियाँ" : "All 12 Signs"}</h2>
      <div class="grid">
        {
          signs.map((s) => (
            <a
              class={`sign ${s.slug === sign.slug ? "current" : ""}`}
              href={`${hubHref}${s.slug}/${period.slug}`}
              hreflang={lang}
              aria-current={s.slug === sign.slug ? "page" : undefined}
            >
              <span class="sym" aria-hidden="true">{s.symbol}</span>
              {/* S22 item 3: both names, both languages — English zodiac name
                  + Devanagari name on every page, every period. */}
              <span class="sname">{s.zodiac}</span>
              <span class="sname hi" lang="hi">{s.hi}</span>
            </a>
          ))
        }
      </div>
    </section>
  </section>
</Base>

<style>
  .hz { max-width: 1120px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  .crumbs { display: flex; gap: var(--space-2); font-size: 13px; color: var(--text-dim); margin-bottom: var(--space-3); }
  .crumbs a { color: var(--gold); text-decoration: underline; text-underline-offset: 2px; }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(24px, 5vw, 36px); display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .glyph { display: inline-flex; width: 44px; height: 44px; border-radius: 999px; background: var(--bg-raised); border: 1px solid var(--border-gold-soft); align-items: center; justify-content: center; font-size: 22px; color: var(--gold); }
  /* The parenthetical sign name inverts per lang: Devanagari on EN pages,
     Latin on HI pages — so the Devanagari face applies only on EN. */
  .hz:not(.hz-hi) .hi-text { color: var(--text-dim); font-size: 0.7em; font-family: "Noto Sans Devanagari", var(--font-display); }
  .hz-hi .hi-text { color: var(--text-dim); font-size: 0.7em; }
  .lede { color: var(--text-muted); font-size: 14px; margin-top: var(--space-2); }
  .periods { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .chip { padding: 6px 14px; border-radius: 999px; border: 1px solid var(--color-border-strong); color: var(--text-muted); text-decoration: none; font-size: 13px; }
  .chip:hover { border-color: var(--border-gold-soft); color: var(--ivory); }
  .chip.active { background: var(--gold); color: var(--color-on-primary); border-color: var(--gold); font-weight: 600; }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    margin-top: var(--space-5);
  }
  .main { min-width: 0; }
  .how {
    margin-top: var(--space-5);
    background: var(--bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-5);
    font-size: 13.5px;
  }
  .how summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 14px;
  }
  .how p { color: var(--text-muted); line-height: 1.65; margin-top: var(--space-3); }
  .disclaimer {
    margin-top: var(--space-3);
    color: var(--text-dim);
    font-size: 12.5px;
    line-height: 1.6;
  }
  .picker { margin-top: var(--space-7); }
  .picker h2 { font-family: var(--font-display); color: var(--ivory); font-size: 18px; margin-bottom: var(--space-3); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: var(--space-2); }
  .sign { display: flex; flex-direction: column; align-items: center; gap: 4px; background: var(--bg-raised); border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: var(--space-3) var(--space-2); text-decoration: none; }
  .sign:hover { border-color: var(--border-gold-soft); }
  .sign.current { border-color: var(--gold); }
  .sym { color: var(--gold); font-size: 18px; }
  .sname { color: var(--ivory); font-size: 13px; }
  .sname.hi {
    color: var(--text-dim);
    font-size: 12px;
    font-family: "Noto Sans Devanagari", var(--font-body);
  }
  @media (max-width: 1023px) {
    .layout { grid-template-columns: 1fr; }
  }

  /* Hindi variant (S22): Devanagari chrome on the self-hosted Devanagari
     face — the Latin display font carries no Devanagari glyphs. */
  .hz-hi {
    font-family: "Noto Sans Devanagari", var(--font-body);
  }
  .hz-hi h1,
  .hz-hi .picker h2,
  .hz-hi .how summary {
    font-family: "Noto Sans Devanagari", var(--font-display);
  }
</style>
