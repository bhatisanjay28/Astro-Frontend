---
/**
 * Shared body of /horoscope/ and its Hindi twin /hi/horoscope/ (S22 item 4).
 * Sign identity is frontend presentation config (D12 boundary); all horoscope
 * TEXT renders on the per-sign pages via the backend API at runtime.
 * Base gets the matching langPath so the en/hi hreflang pair is emitted.
 */
import Base from "../../layouts/Base.astro";
import type { HoroLang } from "../../lib/horoscope-l10n";

export interface Props {
  lang: HoroLang;
}
const { lang } = Astro.props;
const hi = lang === "hi";
const hubBase = hi ? "/hi/horoscope" : "/horoscope";

const SIGNS = [
  { slug: "aries", symbol: "♈", hi: "मेष", en: "Mesh (Aries)" },
  { slug: "taurus", symbol: "♉", hi: "वृषभ", en: "Vrishabha (Taurus)" },
  { slug: "gemini", symbol: "♊", hi: "मिथुन", en: "Mithun (Gemini)" },
  { slug: "cancer", symbol: "♋", hi: "कर्क", en: "Karka (Cancer)" },
  { slug: "leo", symbol: "♌", hi: "सिंह", en: "Simha (Leo)" },
  { slug: "virgo", symbol: "♍", hi: "कन्या", en: "Kanya (Virgo)" },
  { slug: "libra", symbol: "♎", hi: "तुला", en: "Tula (Libra)" },
  { slug: "scorpio", symbol: "♏", hi: "वृश्चिक", en: "Vrishchika (Scorpio)" },
  { slug: "sagittarius", symbol: "♐", hi: "धनु", en: "Dhanu (Sagittarius)" },
  { slug: "capricorn", symbol: "♑", hi: "मकर", en: "Makar (Capricorn)" },
  { slug: "aquarius", symbol: "♒", hi: "कुम्भ", en: "Kumbha (Aquarius)" },
  { slug: "pisces", symbol: "♓", hi: "मीन", en: "Meen (Pisces)" },
] as const;
---

<Base
  lang={lang}
  langPath="/horoscope/"
  title={hi
    ? "राशिफल — सभी 12 राशियों का दैनिक राशिफल | व्योतिष"
    : "Horoscope — Daily Rashiphal for All 12 Signs | Vyotish"}
  description={hi
    ? "सभी 12 चंद्र राशियों के लिए बीते कल, आज, कल, साप्ताहिक, मासिक और वार्षिक वैदिक राशिफल — अपनी राशि चुनें।"
    : "Daily, yesterday, tomorrow, weekly, monthly and yearly Vedic horoscopes (rashiphal) for all 12 Moon signs — pick your sign."}
>
  <section class:list={["hz", { "hz-hi": hi }]}>
    <h1>{hi ? "राशिफल" : "Horoscope — Rashiphal"}</h1>
    <p class="lede">
      {
        hi ? (
          <>
            हर राशि और हर अवधि के लिए चंद्र राशि आधारित वैदिक राशिफल, रोज़ अपडेट। होम पेज पर{" "}
            <a href={hi ? "/hi/#horoscope" : "/#horoscope"}>सभी राशियाँ टैब में</a> देखें।
          </>
        ) : (
          <>
            Moon-sign based Vedic predictions, updated daily for every sign and period.
            The home page shows <a href="/#horoscope">all signs in tabs</a>.
          </>
        )
      }
    </p>
    <div class="grid">
      {
        SIGNS.map((s) => (
          <a class="card" href={`${hubBase}/${s.slug}/daily`} hreflang={lang}>
            <span class="sym" aria-hidden="true">{s.symbol}</span>
            <span class="name">{hi ? s.hi : s.en}</span>
            <span class="alt">{hi ? s.en : s.hi}</span>
            <span class="cta">{hi ? "आज का राशिफल →" : "Today's rashiphal →"}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hz { max-width: 1000px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(26px, 5vw, 38px); }
  .lede { color: var(--text-muted); margin-top: var(--space-2); font-size: 14.5px; }
  .lede a { color: var(--gold); }
  .grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); margin-top: var(--space-5); }
  .card {
    display: flex; flex-direction: column; gap: 3px;
    background: var(--bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    text-decoration: none;
  }
  .card:hover { border-color: var(--border-gold-soft); }
  .sym { color: var(--gold); font-size: 20px; }
  .name { color: var(--ivory); font-weight: 500; font-size: 15px; }
  .alt { color: var(--text-dim); font-size: 13px; }
  .cta { color: var(--gold); font-size: 12.5px; margin-top: var(--space-2); }

  /* Hindi variant (S22): Devanagari chrome on the self-hosted Devanagari face. */
  .hz-hi { font-family: "Noto Sans Devanagari", var(--font-body); }
  .hz-hi h1 { font-family: "Noto Sans Devanagari", var(--font-display); }
  .hz:not(.hz-hi) .alt { font-family: "Noto Sans Devanagari", var(--font-body); }
</style>
