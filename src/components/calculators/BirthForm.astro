---
/**
 * Shared calculator input form (Epic 4.4/4.6). The page supplies `endpoint`
 * (+ optional extra fields); the page's own script renders results into
 * [data-calc-result]. GET endpoints → cache-friendly, no-PII (PRD §10).
 */
export interface ExtraField {
  name: string;
  label: string;
  type: "text" | "date" | "tel" | "email" | "number" | "time";
  placeholder?: string;
  required?: boolean;
  /** When present, renders a <select> with these options (e.g. gender). */
  options?: string[];
  /** date extra fields — "free" (default, past+future valid) or "birth" (no future, 100y window) */
  preset?: "birth" | "free";
  /** time extra fields — 12-hour AM/PM (default) or 24-hour (e.g. the UTC field) */
  hour12?: boolean;
}
interface Props {
  endpoint: string;
  submitLabel?: string;
  extraFields?: ExtraField[];
  note?: string;
}

import PlaceField from "../PlaceField.astro";
import DateField from "../DateField.astro";

const { endpoint, submitLabel = "Calculate", extraFields = [], note } = Astro.props;
const inputClass =
  "w-full px-3 py-2 min-h-[44px] rounded bg-light-surface dark:bg-dark-surface border border-light-outline-variant dark:border-dark-outline-variant text-light-on-surface dark:text-dark-on-surface font-body text-body-sm";
const labelClass =
  "block font-label text-label-sm font-semibold text-light-on-surface-variant dark:text-dark-on-surface-variant mb-1";
---

<form
  class="grid grid-cols-2 sm:grid-cols-3 gap-3 items-end"
  data-calc-endpoint={endpoint}
  data-place-required="true"
  autocomplete="off"
>
  <div>
    <DateField id="bf-date" name="date" label="Birth date" labelClass={labelClass} required />
  </div>
  <div>
    <DateField mode="time" id="bf-time" name="time" label="Birth time" labelClass={labelClass} />
  </div>
  {/* full row: the PlaceField's live-status line sits below its input, so
      confining it to one grid cell broke the items-end bottom alignment */}
  <div class="col-span-2 sm:col-span-3">
    <PlaceField variant="separate" inputId="bf-place" label="Place of birth" />
  </div>
  {
    extraFields.map((f) => (
      <div>
        {f.options ? (
          <div>
            <label class={labelClass} for={`bf-${f.name}`}>
              {f.label}
              {f.required ? "" : " (optional)"}
            </label>
            <select class={inputClass} id={`bf-${f.name}`} name={f.name} required={f.required === true}>
              {f.required !== true && <option value="">—</option>}
              {f.options.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>
        ) : f.type === "date" ? (
          <DateField
            id={`bf-${f.name}`}
            name={f.name}
            label={`${f.label}${f.required ? "" : " (optional)"}`}
            labelClass={labelClass}
            required={f.required === true}
            preset={f.preset ?? "free"}
          />
        ) : f.type === "time" ? (
          <DateField
            mode="time"
            id={`bf-${f.name}`}
            name={f.name}
            label={`${f.label}${f.required ? "" : " (optional)"}`}
            labelClass={labelClass}
            required={f.required === true}
            hour12={f.hour12 !== false}
          />
        ) : (
          <div>
            <label class={labelClass} for={`bf-${f.name}`}>
              {f.label}
              {f.required ? "" : " (optional)"}
            </label>
            <input
              class={inputClass}
              id={`bf-${f.name}`}
              name={f.name}
              type={f.type}
              placeholder={f.placeholder ?? ""}
              required={f.required === true}
            />
          </div>
        )}
      </div>
    ))
  }
  <button
    type="submit"
    class="px-5 py-2 min-h-[44px] rounded bg-light-primary text-light-on-primary dark:bg-dark-primary dark:text-dark-on-primary font-label text-label-md font-semibold hover:opacity-95 transition-opacity whitespace-nowrap"
  >
    {submitLabel}
  </button>
</form>
{
  note && (
    <p class="font-body text-body-sm text-light-outline dark:text-dark-outline mt-2">{note}</p>
  )
}
