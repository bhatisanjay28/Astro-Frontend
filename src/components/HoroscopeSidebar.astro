---
/**
 * Horoscope sidebar — Lucky triad, trust note, explore links
 * (Horoscope Upgrade Step 4; design spec §2 Lucky card, §5 sidebar).
 *
 * Chrome only: card headings and field labels are frontend config (D12
 * boundary); every lucky VALUE (planet, colours, number, direction, deity,
 * mantra, why-line) comes from the API payload and content_blocks. The
 * lucky-heading period wording ("Lucky today / this week / …") is chrome.
 * Direction is hidden when the payload omits it (Ketu → null).
 *
 * S22: lang-aware chrome (Hindi labels/values via the payload's hi twins on
 * /hi/ pages) and the reviewer sentence removed — the trust card keeps its
 * heading + attribution only.
 */
import type { HoroscopeBlocks, HoroscopePayload } from "../lib/content";
import { type HoroLang, luckyHeading, PERIOD_SIDEBAR_LABEL, TRUST } from "../lib/horoscope-l10n";

export interface Props {
  period: string;
  signSlug: string;
  lucky: HoroscopePayload["lucky"] | null;
  blocks: HoroscopeBlocks;
  lang?: HoroLang;
}

const { period, signSlug, lucky, blocks, lang = "en" } = Astro.props;
const hi = lang === "hi";
const H = blocks.headers ?? {};

// The Hindi payload carries hi twins for every lucky value; fall back to en.
const pick = (v: { en: string; hi: string }): string => (hi ? v.hi || v.en : v.en);

const luckyTitle = luckyHeading(lang, period, H.lucky_heading);

/** Fill a lucky_why template with the payload's attribution params. */
const fillWhy = (tpl: string, why: NonNullable<HoroscopePayload["lucky"]>["why"]): string => {
  const p = why.params;
  return tpl
    .replace(/\{\{planet_hi\}\}/g, p.planet_hi)
    .replace(/\{\{planet\}\}/g, p.planet)
    .replace(/\{\{sign_hi\}\}/g, p.sign_hi)
    .replace(/\{\{sign\}\}/g, p.sign);
};
const whyLine =
  lucky && blocks.lucky_why?.[lucky.why.key]
    ? fillWhy(blocks.lucky_why[lucky.why.key], lucky.why)
    : null;

// Swatches come from DB jsonb — only a strict hex value goes into a style attr
// (defense-in-depth on top of the validator's palette check).
const safeSwatch = (v: string): string | null => (/^#[0-9a-fA-F]{3,8}$/.test(v) ? v : null);

const LABELS = hi
  ? { number: "संख्या", colours: "रंग", direction: "दिशा", deity: "देवता", mantra: "मंत्र" }
  : {
      number: "Number",
      colours: "Colours",
      direction: "Direction",
      deity: "Deity",
      mantra: "Mantra",
    };
const ARIA = hi
  ? { trust: "इस सामग्री के बारे में", explore: "और देखें" }
  : { trust: "About this content", explore: "Explore more" };
const CTA = hi ? "परामर्श बुक करें" : "Book a Consultation";

// Links stay inside the current language section (S22 carry).
const base = hi ? "/hi/horoscope" : "/horoscope";
const OTHER_PERIODS = ["yesterday", "daily", "tomorrow", "weekly", "monthly", "yearly"]
  .filter((p) => p !== period)
  .map((p) => ({ slug: p, label: PERIOD_SIDEBAR_LABEL[lang][p] ?? p }));
---

<aside class:list={["hzs", { "hzs-hi": hi }]}>
  {
    lucky && (
      <section class="card lucky" aria-label={luckyTitle}>
        <h2>{luckyTitle}</h2>
        {whyLine && <p class="why">{whyLine}</p>}
        <dl class="triad">
          <div class="row">
            <dt>{LABELS.number}</dt>
            <dd>
              <span class="num">{lucky.number}</span>
            </dd>
          </div>
          <div class="row">
            <dt>{LABELS.colours}</dt>
            <dd>
              <ul class="colours">
                {lucky.colours.map((c) => {
                  const sw = safeSwatch(c.swatch);
                  return (
                    <li>
                      {sw && <span class="sw" style={`background:${sw}`} aria-hidden="true" />}
                      {pick(c)}
                    </li>
                  );
                })}
              </ul>
            </dd>
          </div>
          {lucky.direction && (
            <div class="row">
              <dt>{LABELS.direction}</dt>
              <dd>{pick(lucky.direction)}</dd>
            </div>
          )}
          <div class="row">
            <dt>{LABELS.deity}</dt>
            <dd>{pick(lucky.deity)}</dd>
          </div>
        </dl>
        <div class="mantra">
          <span class="lbl">{LABELS.mantra}</span>
          <p lang="hi">{lucky.mantra.hi}</p>
          <p class="tr">{lucky.mantra.en}</p>
        </div>
      </section>
    )
  }

  <section class="card trust" aria-label={ARIA.trust}>
    <h2>{TRUST[lang].title}</h2>
    <p>{TRUST[lang].body}</p>
  </section>

  <section class="card explore" aria-label={ARIA.explore}>
    <h2>{hi ? "और देखें" : "Explore"}</h2>
    <ul class="links">
      {
        OTHER_PERIODS.map((p) => (
          <li>
            <a href={`${base}/${signSlug}/${p.slug}`}>{p.label}</a>
          </li>
        ))
      }
    </ul>
    <a class="book" href="/consultations/">{CTA}</a>
  </section>
</aside>

<style>
  .hzs {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .card {
    background: var(--bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
  }
  .card h2 {
    font-family: var(--font-display);
    color: var(--gold);
    font-size: 15px;
    margin-bottom: var(--space-2);
  }
  .card p {
    color: var(--text-body);
    font-size: 13.5px;
    line-height: 1.6;
  }
  .lucky .why {
    color: var(--text-muted);
    font-style: italic;
    font-size: 13px;
    padding-bottom: var(--space-2);
    border-bottom: 1px dashed var(--color-border);
    margin-bottom: var(--space-3);
  }
  .triad {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .triad .row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .triad dt {
    flex: 0 0 76px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .triad dd {
    margin: 0;
    color: var(--text-body);
    font-size: 14px;
  }
  .triad .num {
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1;
    color: var(--gold);
    font-weight: 700;
  }
  .colours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }
  .colours li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: var(--text-body);
  }
  .sw {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    flex-shrink: 0;
  }
  .mantra {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border);
  }
  .mantra .lbl {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: var(--space-1);
  }
  .mantra p {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--gold);
    line-height: 1.6;
    margin: 0;
  }
  .mantra .tr {
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--text-muted);
    font-style: italic;
    margin-top: var(--space-1);
  }
  .links {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .links a {
    color: var(--gold);
    font-size: 13.5px;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--gold);
    color: var(--color-on-primary);
    border-radius: var(--radius-pill);
    padding: 10px 20px;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
  }
  .book:hover {
    box-shadow: var(--gold-shadow);
  }

  /* Hindi variant: Devanagari text uses the self-hosted Devanagari face
     (the Latin display font has no Devanagari glyphs — browser fallback
     would look off-brand). The lucky number stays on the display face. */
  .hzs-hi {
    font-family: "Noto Sans Devanagari", var(--font-body);
  }
  .hzs-hi .card h2 {
    font-family: "Noto Sans Devanagari", var(--font-display);
  }
  .hzs-hi .mantra p {
    font-family: "Noto Sans Devanagari", var(--font-display);
  }
</style>
