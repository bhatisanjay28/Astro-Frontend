---
import type { ExtraField } from "../../components/calculators/BirthForm.astro";
import BirthForm from "../../components/calculators/BirthForm.astro";
import DateField from "../../components/DateField.astro";
import FieldLabel from "../../components/forms/FieldLabel.astro";
import RequiredNote from "../../components/forms/RequiredNote.astro";
import PlaceField from "../../components/PlaceField.astro";
/**
 * /calculators/{tool} — Epic 4.4 (Tier 1) + 4.6 (Tier 2) + Epic 14 (S14-2).
 * One shared template (PRD §5.7) driven by a registry: slug/titles/input kind.
 * Computation always happens in the backend (D12); results render through the
 * shared block renderer (scripts/calculator-renderer.ts, spec classes styled
 * by the is:global block below — JS-injected nodes never match scoped CSS).
 */
import Base from "../../layouts/Base.astro";

type ToolKind =
  | "birth"
  | "date-name"
  | "date"
  | "date-place"
  | "names"
  | "name"
  | "mobile"
  | "age"
  | "transits";

interface Tool {
  slug: string;
  title: string;
  hi: string;
  description: string;
  kind: ToolKind;
  endpoint: string;
  submitLabel?: string;
  extraFields?: ExtraField[];
  /** inline-form date preset — "birth" (default: no future, 100y window) or "free" for any-date tools */
  dateMode?: "birth" | "free";
  forFun?: boolean;
  note?: string;
}

// NOTE: the registry lives INSIDE getStaticPaths below — Astro's worker build
// hoists getStaticPaths to its own scope where module-level consts are not
// visible ("TOOLS is not defined").
export function getStaticPaths() {
  const TOOLS: Tool[] = [
    // Tier 1 (§5.7 verified)
    {
      slug: "rashi",
      title: "Rashi Calculator",
      hi: "चंद्र राशि",
      description:
        "Find your exact Moon sign (Rashi) for your birth moment — the anchor of your Vedic horoscope.",
      kind: "birth",
      endpoint: "/api/v1/calculators/rashi",
    },
    {
      slug: "nakshatra",
      title: "Nakshatra Calculator",
      hi: "नक्षत्र",
      description:
        "Your birth Nakshatra, pada and its planetary lord — the anchor of your Vimshottari dasha timeline.",
      kind: "birth",
      endpoint: "/api/v1/calculators/nakshatra",
    },
    {
      slug: "lagna",
      title: "Rising Sign (Lagna) Calculator",
      hi: "लग्न",
      description:
        "The sign rising on the eastern horizon at your birth moment — your ascendant, its lord and nakshatra.",
      kind: "birth",
      endpoint: "/api/v1/calculators/lagna",
    },
    {
      slug: "vimshottari-dasha",
      title: "Vimshottari Dasha Calculator",
      hi: "विंशोत्तरी दशा",
      description:
        "Your full 120-year mahadasha timeline, the period running now, and every antardasha inside it.",
      kind: "birth",
      endpoint: "/api/v1/calculators/vimshottari-dasha",
    },
    {
      slug: "sade-sati",
      title: "Shani Sade Sati Check",
      hi: "साढ़े साती",
      description:
        "Saturn's 7.5-year transit relative to your Moon sign — current phase, window start/end, dhaiya and next window.",
      kind: "birth",
      endpoint: "/api/v1/calculators/sade-sati",
      extraFields: [{ name: "as_of", label: "Check as of date", type: "date" }],
    },
    {
      slug: "mangal-dosha",
      title: "Mangal Dosha Check",
      hi: "मंगल दोष",
      description:
        "Mars placement in houses 1, 2, 4, 7, 8, 12 from Lagna, Moon and Venus — with classical cancellations.",
      kind: "birth",
      endpoint: "/api/v1/calculators/mangal-dosha",
      submitLabel: "Evaluate Mars",
      extraFields: [
        {
          name: "gender",
          label: "Gender",
          type: "text",
          options: ["male", "female", "other"],
        },
      ],
    },
    {
      slug: "kaal-sarp",
      title: "Kaal Sarp Yoga Check",
      hi: "काल सर्प योग",
      description:
        "Whether all seven grahas are hemmed within one Rahu–Ketu axis, and the classical type by Rahu's house.",
      kind: "birth",
      endpoint: "/api/v1/calculators/kaal-sarp",
      submitLabel: "Check Kaal Sarp",
    },
    {
      slug: "karakas",
      title: "Atmakaraka & Jaimini Karakas",
      hi: "आत्मकारक",
      description:
        "Your seven soul-significators ranked by in-sign degree — Atmakaraka, Amatyakaraka … Darakaraka.",
      kind: "birth",
      endpoint: "/api/v1/calculators/karakas",
    },
    {
      slug: "ishta-devata",
      title: "Ishta Devata (Atmakaraka base)",
      hi: "इष्ट देवता",
      description:
        "Atmakaraka and its Navamsha sign — the classical anchor for personal worship. Individual traditions vary — treat the table as guidance.",
      kind: "birth",
      endpoint: "/api/v1/calculators/ishta-devata",
    },
    {
      slug: "transits",
      title: "Current Transit Chart",
      hi: "गोचर",
      description: "Where the nine grahas are right now, computed for your coordinates.",
      kind: "transits",
      endpoint: "/api/v1/calculators/transits",
      submitLabel: "Fetch Current Positions",
    },
    {
      slug: "moon-phase",
      title: "Moon Phase Calculator",
      hi: "चंद्र कला",
      description:
        "The Moon's phase for any date — illumination, lunar age, and the next new & full moon.",
      kind: "date",
      endpoint: "/api/v1/calculators/moon-phase",
      dateMode: "free", // any historical date, not a birth date
      extraFields: [{ name: "time", label: "Time (UTC)", type: "time", hour12: false }],
      note: "Date and the optional time are interpreted in UTC; without a time, 12:00 UTC is used.",
    },
    {
      slug: "sun-sign",
      title: "Sun Sign Calculator",
      hi: "सूर्य राशि",
      description:
        "Your Western sun sign AND your Vedic Surya Rashi — with the Sun's nakshatra, pada and planetary lord.",
      kind: "date-place",
      endpoint: "/api/v1/calculators/sun-sign",
      note: "Without a time and place the sign is computed for 12:00 UTC; add both for an exact instant (cusp-day births may differ).",
    },
    // Tier 2 (§5.7 "build next")
    {
      slug: "numerology",
      title: "Vedic Numerology",
      hi: "अंक ज्योतिष",
      description:
        "Mulank (birth number), Bhagyank (destiny number) and Namank (name number) via Chaldean values.",
