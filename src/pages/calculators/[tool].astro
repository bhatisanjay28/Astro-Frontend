    },
    {
      slug: "destiny-number",
      title: "Destiny Number (Bhagyank)",
      hi: "भाग्यांक",
      description:
        "Bhagyank from your full date of birth, with Mulank (psychic number) and both planetary lords.",
      kind: "date",
      endpoint: "/api/v1/calculators/destiny-number",
    },
    {
      slug: "lo-shu",
      title: "Lo Shu Grid",
      hi: "लो शु ग्रिड",
      description:
        "Your birth-date digits on the classical 3×3 Lo Shu map — missing and repeated numbers.",
      kind: "date",
      endpoint: "/api/v1/calculators/lo-shu",
    },
    {
      slug: "vehicle-number",
      title: "Lucky Vehicle Number",
      hi: "वाहन अंक",
      description:
        "Is a registration plate lucky for you? Two numerology schools read the plate against your birth numbers.",
      kind: "date",
      endpoint: "/api/v1/calculators/vehicle-plate",
      dateMode: "free", // registration/purchase date, not a birth date
      extraFields: [
        {
          name: "plate",
          label: "Registration plate",
          type: "text",
          placeholder: "e.g. DL 8C AF 1234",
          required: true,
        },
      ],
      note: "Enter a standard Indian plate (state + RTO + series + number). The owner date personalises the verdict.",
    },
    {
      slug: "name-numerology",
      title: "Lucky Name Numerology",
      hi: "नाम अंक",
      description: "Chaldean value of your name with its planetary lord and per-word subtotals.",
      kind: "name",
      endpoint: "/api/v1/calculators/name-numerology",
      extraFields: [
        {
          name: "name",
          label: "Full name",
          type: "text",
          placeholder: "Your name",
          required: true,
        },
        {
          name: "date",
          label: "Your birth date",
          type: "date",
        },
      ],
    },
    {
      slug: "mobile-numerology",
      title: "Mobile Number Numerology",
      hi: "मोबाइल अंक",
      description: "Digit-sum reading of your phone number (for entertainment).",
      kind: "mobile",
      endpoint: "/api/v1/calculators/mobile-numerology",
      extraFields: [
        {
          name: "digits",
          label: "Mobile number",
          type: "text",
          placeholder: "10 digits (or +91 …)",
          required: true,
        },
      ],
      forFun: true,
    },
    {
      slug: "age",
      title: "Age Calculator",
      hi: "आयु गणना",
      description:
        "Exact calendar age — years, months, days, total weeks and hours, and your next birthday.",
      kind: "age",
      endpoint: "/api/v1/calculators/age",
      extraFields: [{ name: "now", label: "Age at date", type: "date" }],
      note: "Leave “Age at date” empty for your age today.",
    },
    {
      slug: "name-compatibility",
      title: "Name Compatibility",
      hi: "नाम मिलान",
      description: "Combined Chaldean name roots with a harmony band.",
      kind: "names",
      endpoint: "/api/v1/calculators/name-compatibility",
      extraFields: [
        {
          name: "b",
          label: "Second name",
          type: "text",
          placeholder: "Other name",
          required: true,
        },
      ],
      forFun: true,
    },
    {
      slug: "love",
      title: "Love Compatibility (fun)",
      hi: "प्रेम मिलान",
      description: "Playful name-numerology love score.",
      kind: "names",
      endpoint: "/api/v1/calculators/love",
      extraFields: [
        {
          name: "b",
          label: "Second name",
          type: "text",
          placeholder: "Other name",
          required: true,
        },
      ],
      forFun: true,
    },
    {
      slug: "friendship",
      title: "Friendship Compatibility (fun)",
      hi: "मित्रता मिलान",
      description: "Playful name-numerology friendship score.",
      kind: "names",
      endpoint: "/api/v1/calculators/friendship",
      extraFields: [
        {
          name: "b",
          label: "Second name",
          type: "text",
          placeholder: "Other name",
          required: true,
        },
      ],
      forFun: true,
    },
    {
      slug: "flames",
      title: "FLAMES (fun)",
      hi: "फ्लेम्स",
      description: "The classic letter game — labelled strictly for fun.",
      kind: "names",
      endpoint: "/api/v1/calculators/flames",
      extraFields: [
        {
          name: "b",
          label: "Second name",
          type: "text",
          placeholder: "Other name",
          required: true,
        },
      ],
      forFun: true,
    },
  ];
  return TOOLS.map((tool) => ({ params: { tool: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };
const API_NOTE = "Free · instant · computed live — nothing is stored.";
---

<Base
  title={`${tool.title} — Free Vedic Calculator | Vyotish`}
  description={`${tool.description} Free, instant, no login — computed live by the Vyotish engine.`}
>
  <section class="calc">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/calculators/">Calculators</a>
      <span>/</span>
      <span>{tool.title}</span>
    </nav>

    <h1>{tool.title} {tool.hi && <span class="hi-text">({tool.hi})</span>}</h1>
    <p class="lede">{tool.description}</p>
    <div class="flags">
      {tool.forFun && <span class="flag fun">For fun — not an astrological verdict</span>}
      <span class="flag">{API_NOTE}</span>
    </div>

    <div class="panel">
      {
        tool.kind === "birth" ? (
          <BirthForm
            endpoint={tool.endpoint}
            submitLabel={tool.submitLabel ?? "Calculate"}
            note={tool.note}
            extraFields={tool.extraFields}
          />
        ) : tool.kind === "transits" ? (
          <form class="grid grid-cols-2 sm:grid-cols-3 gap-3 items-end" data-calc-endpoint={tool.endpoint} data-place-required="true" autocomplete="off">
            <div class="col-span-2 sm:col-span-3"><RequiredNote /></div>
            <div class="col-span-2 sm:col-span-3">
              <PlaceField variant="separate" inputId="bf-place" label="Place" />
            </div>
            <button type="submit" class="btn">{tool.submitLabel ?? "Calculate"}</button>
          </form>
        ) : (
          <form
            class="grid grid-cols-2 sm:grid-cols-3 gap-3 items-end"
            data-calc-endpoint={tool.endpoint}
            data-place-required={tool.kind === "date-place" ? "false" : undefined}
            autocomplete="off"
          >
            <div class="col-span-2 sm:col-span-3"><RequiredNote /></div>
            {/* dt fields span the full row at base — the picker needs ~230px
                and a half-width 360px cell overflows it (S18 responsive check) */}
            {tool.kind === "date-place" && (
              <DateField
                mode="time"
                id="bf-time"
                name="time"
                label="Time of birth"
                optional
                class="col-span-2 sm:col-span-1"
              />
            )}
            {tool.kind !== "names" && tool.kind !== "name" && tool.kind !== "mobile" && (
              <DateField
                id="bf-date"
                name="date"
                label={tool.kind === "age" ? "Date of birth" : "Date"}
                required
                preset={tool.dateMode ?? "birth"}
                class="col-span-2 sm:col-span-1"
              />
            )}
            {(tool.kind === "name" || tool.kind === "names" || tool.kind === "date-name") && (
              <div>
                {/* S18: name drives the value only for name-numerology/names;
                    numerology (date-name) computes Namank from it if given —
                    optional there, so no native required */}
                <FieldLabel
                  forId="bf-name"
                  label={tool.kind === "names" ? "First name" : "Name"}
                  required={tool.kind !== "date-name"}
                  optional={tool.kind === "date-name"}
                  class="lbl"
                />
                <input class="inp" id="bf-name" name={tool.kind === "names" ? "a" : "name"} type="text" placeholder={tool.kind === "names" ? "First name" : "Your name"} required={tool.kind !== "date-name"} />
              </div>
            )}
            {tool.extraFields?.filter((f) => f.name !== "name").map((f) => (
              <div class={f.type === "date" || f.type === "time" ? "col-span-2 sm:col-span-1" : ""}>
                {f.options ? (
                  <div>
                    <FieldLabel forId={`bf-${f.name}`} label={f.label} required={f.required === true} optional={f.required !== true} class="lbl" />
                    <select class="inp" id={`bf-${f.name}`} name={f.name} required={f.required === true}>
                      {f.required !== true && <option value="">—</option>}
                      {f.options.map((opt) => (
                        <option value={opt}>{opt}</option>
                      ))}
                    </select>
                  </div>
                ) : f.type === "date" ? (
                  <DateField
                    id={`bf-${f.name}`}
                    name={f.name}
                    label={`${f.label}${f.required ? "" : " (optional)"}`}
                    required={f.required === true}
                    preset={f.preset ?? "free"}
                  />
                ) : f.type === "time" ? (
                  <DateField
                    mode="time"
                    id={`bf-${f.name}`}
                    name={f.name}
                    label={`${f.label}${f.required ? "" : " (optional)"}`}
                    required={f.required === true}
                    hour12={f.hour12 !== false}
                  />
                ) : (
                  <div>
                    <FieldLabel forId={`bf-${f.name}`} label={f.label} required={f.required === true} optional={f.required !== true} class="lbl" />
                    <input class="inp" id={`bf-${f.name}`} name={f.name} type={f.type} placeholder={f.placeholder ?? ""} required={f.required === true} />
                  </div>
                )}
              </div>
            ))}
            {tool.kind === "date-place" && (
              <div class="col-span-2 sm:col-span-3">
                {/* required={false}: sun-sign works without a place — the page
                    note explains the 12:00 UTC default; the picker only gates
                    it when a birth time is given */}
                <PlaceField variant="separate" inputId="bf-place" label="Place of birth" required={false} optional />
              </div>
            )}
            <button type="submit" class="btn">{tool.submitLabel ?? "Calculate"}</button>
          </form>
        )
      }

      {tool.note && tool.kind !== "birth" && <p class="tool-note">{tool.note}</p>}
      <section class="result" data-calc-result aria-live="polite">
        <p class="hint">Your result will appear here — instant, and nothing is stored.</p>
      </section>
    </div>

    <p class="more">
      <a href="/calculators/">← All calculators</a> · Kundli with charts &amp; Dasha on the
      <a href="/kundli">Free Kundli page</a> · Matching on the <a href="/matching">Match page</a>
    </p>
  </section>
</Base>

<script>
  // Shared submit/fetch logic for every registry calculator page. Rendering is
  // delegated to the block renderer (S14-2 AC-2); this file owns the form →
  // querystring plumbing and the four states (empty/loading/error/results).
  import { esc, renderCalculatorResult } from "../../scripts/calculator-renderer";
  import { installFormValidation } from "../../scripts/form-validation";

  const apiBase =
    import.meta.env.PUBLIC_API_BASE_URL ?? "https://astro-backend.vyotish.workers.dev";
  const form = document.querySelector<HTMLFormElement>("form[data-calc-endpoint]");
  const box = document.querySelector<HTMLElement>("[data-calc-result]");
  if (form && box) {
    const toolSlug = location.pathname.split("/").pop() ?? "";
    const placeRequired = form.getAttribute("data-place-required") === "true";

    // S18 — shared validation gate: dt + required-place come from markup; text
    // rules derive from the native required attrs (first/second name, plate,
    // digits). The gate blocks before this handler's fetch ever runs.
    installFormValidation(form, {
      text: [...form.querySelectorAll<HTMLInputElement>("input[required]")]
        .filter((el) => el.type !== "hidden")
        .map((el) => ({
          el,
          required: true,
          message: el.id === "bf-name" ? "Please enter your name." : undefined,
        })),
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const latField = form.querySelector<HTMLInputElement>('[data-place-role="lat"]');
      const timeField = form.querySelector<HTMLInputElement>('[name="time"]');

      // free text without a pick must never submit as a place (S15-1 AC-4):
      // typing wiped the role inputs, so the visible text is unselected garbage
      const placeInput = form.querySelector<HTMLInputElement>("[data-place-input]");
      if (placeInput && placeInput.value.trim() && latField && !latField.value) {
        const st = form.querySelector<HTMLElement>("[data-place-status]");
        if (st) st.textContent = "Please select a city from the list.";
        placeInput.setAttribute("aria-invalid", "true");
        return;
      }

      // birthplace picker guard — required forms need a pick before submitting;
      // optional-place forms (sun-sign) only need it when a local time is given
      if (latField && !latField.value && (placeRequired || (timeField && timeField.value))) {
        const st = form.querySelector<HTMLElement>("[data-place-status]");
        const input = form.querySelector<HTMLInputElement>("[data-place-input]");
        if (st) {
          st.textContent = placeRequired
            ? "Please select your place of birth from the suggestions."
            : "Add your place of birth to use the birth time — or clear the time field.";
        }
        if (input) input.setAttribute("aria-invalid", "true");
        return;
      }

      const qs = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (String(value).trim() !== "") qs.set(key, String(value).trim());
      });
      // optional-place pages: place coordinates only count when picked
      if (latField && !latField.value) {
        qs.delete("lat");
        qs.delete("lng");
        qs.delete("tz");
        qs.delete("time");
      }

      const base = form.getAttribute("data-calc-endpoint") ?? "";
      const url = apiBase + base + (base.indexOf("?") >= 0 ? "&" : "?") + qs.toString();
      box.setAttribute("aria-busy", "true");
      box.innerHTML = '<p class="hint">Calculating…</p>';
      fetch(url)
        .then((r) => r.json().then((j) => ({ ok: r.ok, j })))
        .then(({ ok, j }) => {
          box.removeAttribute("aria-busy");
          if (!ok || j.error) {
            const msg =
              (j && j.error && j.error.message) ||
              "The calculation failed — please check the inputs and try again.";
            box.innerHTML = `<p class="hint err">${esc(msg)}${ok ? "" : " Please check the inputs."}</p>`;
            return;
          }
          renderCalculatorResult(base, j.data ?? {}, j.meta ?? null, box);
          // Epic 7.4 — consent-gated analytics; no-op unless GA4 is loaded
          const w = window as unknown as { vyTrack?: (event: string, props: unknown) => void };
          w.vyTrack?.("calculator_used", { tool: toolSlug });
        })
        .catch(() => {
          box.removeAttribute("aria-busy");
          box.innerHTML =
            '<p class="hint err">The backend could not be reached — please refresh and try again.</p>';
        });
    });
  }
</script>

<style>
  .calc { max-width: 900px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  .crumbs { display: flex; gap: var(--space-2); font-size: 13px; color: var(--text-dim); margin-bottom: var(--space-3); }
  .crumbs a { color: var(--gold); text-decoration: underline; text-underline-offset: 2px; }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(24px, 5vw, 34px); }
  .hi-text { color: var(--text-dim); font-size: 0.7em; }
  .lede { color: var(--text-muted); font-size: 14.5px; margin-top: var(--space-2); max-width: 640px; }
  .flags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .flag { font-size: 12px; color: var(--text-dim); border: 1px solid var(--color-border); border-radius: 999px; padding: 3px 10px; }
  .flag.fun { color: var(--gold); border-color: var(--border-gold-soft); }
  .panel { margin-top: var(--space-5); background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-5); }
  .lbl { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; }
  .inp { width: 100%; min-height: 44px; padding: 8px 10px; border-radius: 8px; background: var(--bg); border: 1px solid var(--color-border-strong); color: var(--ivory); font-size: 14px; }
  /* theme-aware pair (was: gold + hardcoded dark text → 1.97:1 in light mode) */
  .btn { min-height: 44px; padding: 9px 18px; border-radius: 8px; background: var(--color-primary); color: var(--color-on-primary); font-weight: 600; font-size: 14px; border: none; cursor: pointer; }
  .result { margin-top: var(--space-4); border-top: 1px dashed var(--color-border); padding-top: var(--space-4); }
  .tool-note { color: var(--text-faint); font-size: 12.5px; margin-bottom: var(--space-2); }
  .more { margin-top: var(--space-5); font-size: 13.5px; color: var(--text-dim); }
  .more a { color: var(--gold); }
</style>

<style is:global>
  /* Result-region classes are injected by scripts/calculator-renderer.ts —
