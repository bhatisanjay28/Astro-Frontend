const { tool } = Astro.props as { tool: Tool };
const lang = langFromPath(Astro.url.pathname);
const t = CALC_TOOL[lang];
const hi = lang === "hi";
/* per-language display copy — option values and endpoints stay EN */
const fLabel = (f: ExtraField) => (hi ? (f.label_hi ?? f.label) : f.label);
const fPlaceholder = (f: ExtraField) =>
  hi ? (f.placeholder_hi ?? f.placeholder ?? "") : (f.placeholder ?? "");
const fOptLabel = (f: ExtraField, opt: string) => (hi ? (f.options_hi?.[opt] ?? opt) : opt);
const toolDesc = hi ? (tool.description_hi ?? tool.description) : tool.description;
const toolNote = hi ? (tool.note_hi ?? tool.note) : tool.note;
const toolSubmit = hi
  ? (tool.submitLabel_hi ?? t.submitDefault)
  : (tool.submitLabel ?? t.submitDefault);
const here = Astro.url.pathname;
---

<Base
  title={`${hi ? tool.hi : tool.title}${t.titleSuffix}`}
  description={`${toolDesc}${t.descSuffix}`}
>
  <section class="calc">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={withLang("/calculators/", here)}>{t.crumbsRoot}</a>
      <span>/</span>
      <span>{hi ? tool.hi : tool.title}</span>
    </nav>

    <h1>
      {hi ? `${tool.hi} ` : `${tool.title} `}
      <span class="hi-text">({hi ? tool.title : tool.hi})</span>
    </h1>
    <p class={hi ? "lede hi-text" : "lede"}>{toolDesc}</p>
    <div class="flags">
      {tool.forFun && <span class="flag fun">{t.funFlag}</span>}
      <span class="flag">{t.apiNote}</span>
    </div>

    <div class="panel">
      {
        tool.kind === "birth" ? (
          <BirthForm
            endpoint={tool.endpoint}
            submitLabel={toolSubmit}
            note={toolNote}
            extraFields={tool.extraFields}
          />
        ) : tool.kind === "transits" ? (
          <form class="grid grid-cols-2 sm:grid-cols-3 gap-3 items-end" data-calc-endpoint={tool.endpoint} data-place-required="true" autocomplete="off">
            <div class="col-span-2 sm:col-span-3"><RequiredNote /></div>
            <div class="col-span-2 sm:col-span-3">
              <PlaceField variant="separate" inputId="bf-place" label={t.place} />
            </div>
            <button type="submit" class="btn">{toolSubmit}</button>
          </form>
        ) : (
          <form
            class="grid grid-cols-2 sm:grid-cols-3 gap-3 items-end"
            data-calc-endpoint={tool.endpoint}
            data-place-required={tool.kind === "date-place" ? "false" : undefined}
            autocomplete="off"
          >
            <div class="col-span-2 sm:col-span-3"><RequiredNote /></div>
            {/* dt fields span the full row at base — the picker needs ~230px
                and a half-width 360px cell overflows it (S18 responsive check) */}
            {tool.kind === "date-place" && (
              <DateField
                mode="time"
                id="bf-time"
                name="time"
                label={t.timeOfBirth}
                optional
                class="col-span-2 sm:col-span-1"
              />
            )}
            {tool.kind !== "names" && tool.kind !== "name" && tool.kind !== "mobile" && (
              <DateField
                id="bf-date"
                name="date"
                label={tool.kind === "age" ? t.dateOfBirth : t.date}
                required
                preset={tool.dateMode ?? "birth"}
                class="col-span-2 sm:col-span-1"
              />
            )}
            {(tool.kind === "name" || tool.kind === "names" || tool.kind === "date-name") && (
              <div>
                {/* S18: name drives the value only for name-numerology/names;
                    numerology (date-name) computes Namank from it if given —
                    optional there, so no native required */}
                <FieldLabel
                  forId="bf-name"
                  label={tool.kind === "names" ? t.firstName : t.nameLbl}
                  required={tool.kind !== "date-name"}
                  optional={tool.kind === "date-name"}
                  optionalText={t.optionalSuffix}
                  class="lbl"
                />
                <input class="inp" id="bf-name" name={tool.kind === "names" ? "a" : "name"} type="text" placeholder={tool.kind === "names" ? t.firstName : t.yourName} required={tool.kind !== "date-name"} />
              </div>
            )}
            {tool.extraFields?.filter((f) => f.name !== "name").map((f) => (
              <div class={f.type === "date" || f.type === "time" ? "col-span-2 sm:col-span-1" : ""}>
                {f.options ? (
                  <div>
                    <FieldLabel forId={`bf-${f.name}`} label={fLabel(f)} required={f.required === true} optional={f.required !== true} optionalText={t.optionalSuffix} class="lbl" />
                    <select class="inp" id={`bf-${f.name}`} name={f.name} required={f.required === true}>
                      {f.required !== true && <option value="">—</option>}
                      {f.options.map((opt) => (
                        <option value={opt}>{fOptLabel(f, opt)}</option>
                      ))}
                    </select>
                  </div>
                ) : f.type === "date" ? (
                  <DateField
                    id={`bf-${f.name}`}
                    name={f.name}
                    label={`${fLabel(f)}${f.required ? "" : t.optionalSuffix}`}
                    required={f.required === true}
                    preset={f.preset ?? "free"}
                  />
                ) : f.type === "time" ? (
                  <DateField
                    mode="time"
                    id={`bf-${f.name}`}
                    name={f.name}
                    label={`${fLabel(f)}${f.required ? "" : t.optionalSuffix}`}
                    required={f.required === true}
                    hour12={f.hour12 !== false}
                  />
                ) : (
                  <div>
                    <FieldLabel forId={`bf-${f.name}`} label={fLabel(f)} required={f.required === true} optional={f.required !== true} optionalText={t.optionalSuffix} class="lbl" />
                    <input class="inp" id={`bf-${f.name}`} name={f.name} type={f.type} placeholder={fPlaceholder(f)} required={f.required === true} />
                  </div>
                )}
              </div>
            ))}
            {tool.kind === "date-place" && (
              <div class="col-span-2 sm:col-span-3">
                {/* required={false}: sun-sign works without a place — the page
                    note explains the 12:00 UTC default; the picker only gates
                    it when a birth time is given */}
                <PlaceField variant="separate" inputId="bf-place" label={t.placeBirth} required={false} optional />
              </div>
            )}
            <button type="submit" class="btn">{toolSubmit}</button>
          </form>
        )
      }

      {toolNote && tool.kind !== "birth" && <p class={hi ? "tool-note hi-text" : "tool-note"}>{toolNote}</p>}
      <section class="result" data-calc-result aria-live="polite">
        <p class="hint">{t.resultHint}</p>
      </section>
    </div>

    <p class="more"><a href={withLang("/calculators/", here)}>{t.allCalc}</a> · {t.kundliPre}<a href={withLang("/kundli", here)}>{t.kundliLink}</a>{t.kundliPost}{t.matchPre}<a href={withLang("/matching", here)}>{t.matchLink}</a>{t.matchPost}</p>
  </section>
</Base>

<script>
  // Shared submit/fetch logic for every registry calculator page. Rendering is
  // delegated to the block renderer (S14-2 AC-2); this file owns the form →
  // querystring plumbing and the four states (empty/loading/error/results).
  import { esc, renderCalculatorResult } from "../../scripts/calculator-renderer";
  import { installFormValidation } from "../../scripts/form-validation";
  import { CALC_TOOL } from "../../lib/i18n/calculators";

  const apiBase =
    import.meta.env.PUBLIC_API_BASE_URL ?? "https://astro-backend.vyotish.workers.dev";
  const form = document.querySelector<HTMLFormElement>("form[data-calc-endpoint]");
  const box = document.querySelector<HTMLElement>("[data-calc-result]");
  if (form && box) {
    const toolSlug = location.pathname.split("/").pop() ?? "";
    const placeRequired = form.getAttribute("data-place-required") === "true";
    // S24 — UI strings follow the page language; option values/endpoints stay EN
    const T = CALC_TOOL[document.documentElement.lang === "hi" ? "hi" : "en"];

    // S18 — shared validation gate: dt + required-place come from markup; text
    // rules derive from the native required attrs (first/second name, plate,
    // digits). The gate blocks before this handler's fetch ever runs.
    installFormValidation(form, {
      text: [...form.querySelectorAll<HTMLInputElement>("input[required]")]
        .filter((el) => el.type !== "hidden")
        .map((el) => ({
          el,
          required: true,
          message: el.id === "bf-name" ? T.nameMsg : undefined,
        })),
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const latField = form.querySelector<HTMLInputElement>('[data-place-role="lat"]');
      const timeField = form.querySelector<HTMLInputElement>('[name="time"]');

      // free text without a pick must never submit as a place (S15-1 AC-4):
      // typing wiped the role inputs, so the visible text is unselected garbage
      const placeInput = form.querySelector<HTMLInputElement>("[data-place-input]");
      if (placeInput && placeInput.value.trim() && latField && !latField.value) {
        const st = form.querySelector<HTMLElement>("[data-place-status]");
        if (st) st.textContent = T.selectCity;
        placeInput.setAttribute("aria-invalid", "true");
        return;
      }

      // birthplace picker guard — required forms need a pick before submitting;
      // optional-place forms (sun-sign) only need it when a local time is given
      if (latField && !latField.value && (placeRequired || (timeField && timeField.value))) {
        const st = form.querySelector<HTMLElement>("[data-place-status]");
        const input = form.querySelector<HTMLInputElement>("[data-place-input]");
        if (st) {
          st.textContent = placeRequired ? T.selectBirthPlace : T.needPlaceTime;
        }
        if (input) input.setAttribute("aria-invalid", "true");
        return;
      }

      const qs = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (String(value).trim() !== "") qs.set(key, String(value).trim());
      });
      // optional-place pages: place coordinates only count when picked
      if (latField && !latField.value) {
        qs.delete("lat");
        qs.delete("lng");
        qs.delete("tz");
        qs.delete("time");
      }

      const base = form.getAttribute("data-calc-endpoint") ?? "";
      // S24 — hi pages ask the backend for Hindi values + interpretations
      const qsFull = new URLSearchParams(qs);
      if (document.documentElement.lang === "hi") qsFull.set("lang", "hi");
      const url =
        apiBase + base + (base.indexOf("?") >= 0 ? "&" : "?") + qsFull.toString();
      box.setAttribute("aria-busy", "true");
      box.innerHTML = `<p class="hint">${esc(T.calculating)}</p>`;
      fetch(url)
        .then((r) => r.json().then((j) => ({ ok: r.ok, j })))
        .then(({ ok, j }) => {
          box.removeAttribute("aria-busy");
          if (!ok || j.error) {
            const msg = (j && j.error && j.error.message) || T.errFallback;
            box.innerHTML = `<p class="hint err">${esc(msg)}${ok ? "" : esc(T.checkInputs)}</p>`;
            return;
          }
          renderCalculatorResult(base, j.data ?? {}, j.meta ?? null, box);
          // Epic 7.4 — consent-gated analytics; no-op unless GA4 is loaded
          const w = window as unknown as { vyTrack?: (event: string, props: unknown) => void };
          w.vyTrack?.("calculator_used", { tool: toolSlug });
        })
        .catch(() => {
          box.removeAttribute("aria-busy");
          box.innerHTML = `<p class="hint err">${esc(T.netErr)}</p>`;
        });
    });
  }
</script>

<style>
  .calc { max-width: 900px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  .crumbs { display: flex; gap: var(--space-2); font-size: 13px; color: var(--text-dim); margin-bottom: var(--space-3); }
  .crumbs a { color: var(--gold); text-decoration: underline; text-underline-offset: 2px; }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(24px, 5vw, 34px); }
  .hi-text { color: var(--text-dim); font-size: 0.7em; }
  .lede { color: var(--text-muted); font-size: 14.5px; margin-top: var(--space-2); max-width: 640px; }
  .flags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .flag { font-size: 12px; color: var(--text-dim); border: 1px solid var(--color-border); border-radius: 999px; padding: 3px 10px; }
  .flag.fun { color: var(--gold); border-color: var(--border-gold-soft); }
  .panel { margin-top: var(--space-5); background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-5); }
  .lbl { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; }
  .inp { width: 100%; min-height: 44px; padding: 8px 10px; border-radius: 8px; background: var(--bg); border: 1px solid var(--color-border-strong); color: var(--ivory); font-size: 14px; }
  /* theme-aware pair (was: gold + hardcoded dark text → 1.97:1 in light mode) */
  .btn { min-height: 44px; padding: 9px 18px; border-radius: 8px; background: var(--color-primary); color: var(--color-on-primary); font-weight: 600; font-size: 14px; border: none; cursor: pointer; }
  .result { margin-top: var(--space-4); border-top: 1px dashed var(--color-border); padding-top: var(--space-4); }
  .tool-note { color: var(--text-faint); font-size: 12.5px; margin-bottom: var(--space-2); }
  .more { margin-top: var(--space-5); font-size: 13.5px; color: var(--text-dim); }
  .more a { color: var(--gold); }
</style>

<style is:global>
  /* Result-region classes are injected by scripts/calculator-renderer.ts —
     they can never match Astro scoped CSS, so they are global here and keyed
     off [data-calc-result] (root-cause fix for the "alignment" complaint). */
  [data-calc-result] .hint { color: var(--text-dim); font-size: 13.5px; }
  [data-calc-result] .hint.err { color: var(--color-error-text); }
  /* DateField labels size-match the page's .lbl (component owns its label) */
  [data-calc-endpoint] .dt-label { font-size: 12px; }

  /* B1 verdict card */
  [data-calc-result] .verdict-card {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border: 1px solid var(--border-emphasis);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  [data-calc-result] .verdict-eyebrow {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.85;
  }
  [data-calc-result] .verdict-main {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15;
  }
  [data-calc-result] .verdict-sub { font-size: 14px; opacity: 0.85; }
  [data-calc-result] .status-chip {
    align-self: flex-start;
    margin-top: var(--space-1, 4px);
    font-size: 12px;
    font-weight: 600;
    border-radius: 999px;
    padding: 3px 10px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  /* B2 chips */
  [data-calc-result] .chip-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  [data-calc-result] .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    background: var(--color-tint);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 13px;
    color: var(--color-text);
  }
  [data-calc-result] .chip-k { color: var(--text-muted); font-size: 11.5px; }
  [data-calc-result] .chip-v { font-weight: 600; }
  [data-calc-result] .chip-good { border-color: var(--color-auspicious-text); }
  [data-calc-result] .chip-bad { border-color: var(--color-inauspicious-text); }
  [data-calc-result] .chip-info { border-color: var(--border-emphasis); }

  /* B3 meaning */
  [data-calc-result] .meaning { margin-top: var(--space-4); max-width: 640px; }
  [data-calc-result] .meaning p { color: var(--color-text); font-size: 14.5px; line-height: 1.65; margin: 0 0 var(--space-2); }
  [data-calc-result] .guidance { margin: var(--space-2) 0; padding-left: var(--space-5); color: var(--color-text); font-size: 13.5px; line-height: 1.6; }
  [data-calc-result] .basis { color: var(--text-faint); font-size: 12px; }

  /* B4 detail cards */
  [data-calc-result] .detail-card {
    margin-top: var(--space-3);
    background: var(--bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    padding: var(--space-4);
  }
  [data-calc-result] .detail-title { font-size: 13px; font-weight: 600; color: var(--text-muted); margin-bottom: var(--space-2); }
  [data-calc-result] .row {
    display: grid;
    grid-template-columns: minmax(140px, 200px) 1fr;
    gap: var(--space-3);
    padding: 5px 0;
    border-bottom: 1px solid var(--color-border);
  }
  [data-calc-result] .row:last-child { border-bottom: none; }
  [data-calc-result] .k { color: var(--text-dim); font-size: 13px; }
  [data-calc-result] .v { color: var(--color-text); font-size: 14px; overflow-wrap: anywhere; }
  @media (max-width: 480px) {
    [data-calc-result] .row { grid-template-columns: 1fr; gap: 2px; }
  }

  /* tables (dasha / kaal-sarp / karakas / transits / lo-shu lines) */
  [data-calc-result] .table-scroll { overflow-x: auto; max-width: 100%; }
  [data-calc-result] .table { width: 100%; border-collapse: collapse; font-size: 13.5px; color: var(--color-text); }
  [data-calc-result] .table th {
    text-align: left;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--color-border-strong);
    padding: 6px 10px 6px 0;
    white-space: nowrap;
  }
  [data-calc-result] .table td { padding: 6px 10px 6px 0; border-bottom: 1px solid var(--color-border); }
  [data-calc-result] .cell-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    border-radius: 999px;
    padding: 1px 8px;
    background: var(--color-inauspicious-bg);
    color: var(--color-inauspicious-text);
  }
  [data-calc-result] .cell-good { color: var(--color-auspicious-text); font-weight: 600; }
  [data-calc-result] .cell-bad { color: var(--color-inauspicious-text); font-weight: 600; }
  [data-calc-result] .cell-info { color: var(--color-text); font-weight: 600; }
  [data-calc-result] .cell-hl { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--border-emphasis); }

  /* Lo Shu 3×3 grid */
  [data-calc-result] .loshu {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    max-width: 340px;
  }
  [data-calc-result] .loshu-cell {
    aspect-ratio: 1;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }
  [data-calc-result] .loshu-cell.has { background: var(--color-tint); border: 1px solid var(--color-border-strong); }
  [data-calc-result] .loshu-cell.miss { border: 1px dashed var(--color-border-strong); opacity: 0.55; }
  [data-calc-result] .loshu-cell .ln { font-family: var(--font-display); font-size: 20px; color: var(--color-text); }
  [data-calc-result] .loshu-cell .lp { font-size: 10.5px; color: var(--text-muted); }
  [data-calc-result] .legend { margin-top: var(--space-2); font-size: 12px; color: var(--text-faint); }

  /* progress bar */
  [data-calc-result] .bar { height: 10px; border-radius: 999px; background: var(--color-tint); overflow: hidden; max-width: 420px; }
  [data-calc-result] .bar-fill { height: 100%; background: var(--color-primary); border-radius: 999px; }
  [data-calc-result] .bar-label { margin-top: var(--space-1, 4px); font-size: 12.5px; color: var(--text-muted); }

  [data-calc-result] .blist { margin: var(--space-2) 0 0; padding-left: var(--space-5); color: var(--color-text); font-size: 13.5px; line-height: 1.7; }

  /* B5 footnotes */
  [data-calc-result] .flagline { margin-top: var(--space-3); font-size: 12px; color: var(--text-dim); }
</style>
