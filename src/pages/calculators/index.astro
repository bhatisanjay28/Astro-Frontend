---
/** /calculators/ — hub (Epic 4.4). Tier 1 cards come from the Supabase
 * content_blocks via /content/home (D12, build-time fetch, honest empty
 * state); the Tier 2 tool list is URL/presentation config (like NAV_TABS).
 * S24: the /hi twin renders this same body via the page path — Tier 1 card
 * text stays as served by the API (hi rows merge in at P6); the Tier 2 list
 * shows its Hindi names on Hindi pages. */
import Base from "../../layouts/Base.astro";
import { fetchHomeContent } from "../../lib/content";
import { langFromPath, withLang } from "../../lib/i18n";
import { CALCULATORS_HUB } from "../../lib/i18n/hubs";

const lang = langFromPath(Astro.url.pathname);
const hi = lang === "hi";
const t = CALCULATORS_HUB[lang];
const lp = (href: string) => withLang(href, Astro.url.pathname);

const home = await fetchHomeContent("en");
const blocks = (home?.blocks ?? {}) as Record<string, unknown>;
interface CalcCard {
  icon?: string;
  title: string;
  text?: string;
  cta?: string;
  href?: string;
}
const TIER1 = (blocks.calculators as CalcCard[] | undefined) ?? [];

const TIER2 = [
  { slug: "nakshatra", title: "Nakshatra", hi: "नक्षत्र" },
  { slug: "lagna", title: "Rising Sign (Lagna)", hi: "लग्न" },
  { slug: "vimshottari-dasha", title: "Vimshottari Dasha", hi: "विंशोत्तरी दशा" },
  { slug: "lo-shu", title: "Lo Shu Grid", hi: "लो शु" },
  { slug: "numerology", title: "Vedic Numerology", hi: "वैदिक अंक ज्योतिष" },
  { slug: "destiny-number", title: "Destiny Number (Bhagyank)", hi: "भाग्यांक" },
  { slug: "moon-phase", title: "Moon Phase", hi: "चंद्र कला" },
  { slug: "sun-sign", title: "Sun Sign (Surya Rashi)", hi: "सूर्य राशि" },
  { slug: "name-numerology", title: "Name Numerology", hi: "नाम अंक" },
  { slug: "mobile-numerology", title: "Mobile Numerology", hi: "मोबाइल अंक" },
  { slug: "vehicle-number", title: "Lucky Vehicle Number", hi: "शुभ वाहन अंक" },
  { slug: "age", title: "Age Calculator", hi: "आयु यंत्र" },
  { slug: "name-compatibility", title: "Name Compatibility", hi: "नाम मिलान" },
  { slug: "love", title: "Love Compatibility (fun)", hi: "प्रेम मिलान" },
  { slug: "friendship", title: "Friendship (fun)", hi: "मित्रता" },
  { slug: "flames", title: "FLAMES (fun)", hi: "फ्लेम्स" },
  { slug: "karakas", title: "Atmakaraka / Darakaraka", hi: "आत्मकारक / दराकारक" },
  { slug: "ishta-devata", title: "Ishta Devata", hi: "इष्ट देवता" },
  { slug: "transits", title: "Current Transit Chart", hi: "वर्तमान गोचर" },
];
---

<Base title={t.title} description={t.description}>
  <section class="calc-index">
    <h1 class={hi ? "hi-text" : ""}>{t.h1}</h1>
    <p class={`lede ${hi ? "hi-text" : ""}`}>
      {t.lede}
    </p>

    <h2 class={hi ? "hi-text" : ""}>{t.featured}</h2>
    <div class={`grid ${hi ? "hi-text" : ""}`}>
      {
        TIER1.length === 0 ? (
          <p class="lede">{t.empty}</p>
        ) : (
          TIER1.map((c) => (
            <a class="card ready" href={lp(c.href || "/calculators")}>
              <span class="name">{c.title}</span>
              {c.text && <span class="desc">{c.text}</span>}
              <span class="cta">{c.cta || t.open}</span>
            </a>
          ))
        )
      }
    </div>

    <h2 class={hi ? "hi-text" : ""}>{t.more}</h2>
    <div class={`grid small ${hi ? "hi-text" : ""}`}>
      {
        TIER2.map((tool) => (
          <a class="card" href={lp(`/calculators/${tool.slug}`)}>
            <span class="name">{hi ? tool.hi : tool.title}</span>
            {!hi && <span class="hi">{tool.hi}</span>}
            <span class="cta">{t.open}</span>
          </a>
        ))
      }
    </div>

    <p class={`note ${hi ? "hi-text" : ""}`} set:html={t.note} />
  </section>
</Base>

<style>
  .calc-index { max-width: 1000px; margin: 0 auto; padding: var(--space-8) var(--space-4); }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: 34px; }
  h2 { font-family: var(--font-display); color: var(--gold); font-size: 18px; margin-top: var(--space-6); margin-bottom: var(--space-3); }
  .lede { color: var(--text-muted); font-size: 14.5px; margin-top: var(--space-2); }
  .lede a { color: var(--gold); }
  .grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin-top: var(--space-4); }
  .grid.small { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
  .card {
    display: flex; flex-direction: column; gap: 4px;
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    text-decoration: none;
  }
  .card.ready { border-color: var(--border-gold-soft); }
  .card:hover { border-color: var(--gold); }
  .name { color: var(--ivory); font-weight: 500; font-size: 15px; }
  .desc { color: var(--text-dim); font-size: 13px; line-height: 1.55; }
  .hi { color: var(--text-dim); font-size: 13px; }
  .cta { color: var(--gold); font-size: 12.5px; margin-top: 6px; }
  .note { color: var(--text-faint); font-size: 13px; margin-top: var(--space-5); line-height: 1.6; }
  .note a { color: var(--gold); }
</style>
