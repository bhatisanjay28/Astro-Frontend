---
/** /calculators/ — hub (Epic 4.4). Tier 1 cards come from the Supabase
 * content_blocks via /content/home (D12, build-time fetch, honest empty
 * state); the Tier 2 tool list is URL/presentation config (like NAV_TABS). */
import Base from "../../layouts/Base.astro";
import { fetchHomeContent } from "../../lib/content";

const home = await fetchHomeContent("en");
const blocks = (home?.blocks ?? {}) as Record<string, unknown>;
interface CalcCard {
  icon?: string;
  title: string;
  text?: string;
  cta?: string;
  href?: string;
}
const TIER1 = (blocks.calculators as CalcCard[] | undefined) ?? [];

const TIER2 = [
  { slug: "lo-shu", title: "Lo Shu Grid", hi: "लो शु" },
  { slug: "numerology", title: "Vedic Numerology", hi: "अंक ज्योतिष" },
  { slug: "name-numerology", title: "Name Numerology", hi: "नाम अंक" },
  { slug: "mobile-numerology", title: "Mobile Numerology", hi: "मोबाइल अंक" },
  { slug: "vehicle-number", title: "Lucky Vehicle Number", hi: "वाहन अंक" },
  { slug: "age", title: "Age Calculator", hi: "आयु" },
  { slug: "name-compatibility", title: "Name Compatibility", hi: "नाम मिलान" },
  { slug: "love", title: "Love Compatibility (fun)", hi: "प्रेम" },
  { slug: "friendship", title: "Friendship (fun)", hi: "मित्रता" },
  { slug: "flames", title: "FLAMES (fun)", hi: "फ्लेम्स" },
  { slug: "karakas", title: "Atmakaraka / Darakaraka", hi: "आत्मकारक" },
  { slug: "ishta-devata", title: "Ishta Devata", hi: "इष्ट देवता" },
  { slug: "transits", title: "Current Transit Chart", hi: "गोचर" },
];
---

<Base
  title="Free Astrology & Numerology Calculators | Vyotish"
  description="Free Tier 1 and Tier 2 Vedic calculators — Rashi, Nakshatra, Sade Sati, Mangal Dosha, Kaal Sarp, numerology and more — computed live by the Vyotish engine."
>
  <section class="calc-index">
    <h1>Free calculators</h1>
    <p class="lede">
      Every tool is computed by the Vyotish backend engine (/api/v1) — instant results,
      plain-language explanations, zero login. Birth-based tools never store your details.
    </p>

    <h2>Featured calculators</h2>
    <div class="grid">
      {
        TIER1.length === 0 ? (
          <p class="lede">
            Featured tools are temporarily unavailable — the backend content service could
            not be reached at build time. The full list below still works.
          </p>
        ) : (
          TIER1.map((c) => (
            <a class="card ready" href={c.href || "/calculators"}>
              <span class="name">{c.title}</span>
              {c.text && <span class="desc">{c.text}</span>}
              <span class="cta">{c.cta || "Open →"}</span>
            </a>
          ))
        )
      }
    </div>

    <h2>More tools</h2>
    <div class="grid small">
      {
        TIER2.map((t) => (
          <a class="card" href={`/calculators/${t.slug}`}>
            <span class="name">{t.title}</span>
            <span class="hi">{t.hi}</span>
            <span class="cta">Open →</span>
          </a>
        ))
      }
    </div>

    <p class="note">
      Building a match? Use the <a href="/matching">Guna Milan (Ashtakoota) page</a>, or generate a
      full chart on the <a href="/kundli">Free Kundli page</a>. Fun tools are always labelled
      <em>"for fun"</em>; astrological verdicts carry their verification status.
    </p>
  </section>
</Base>

<style>
  .calc-index { max-width: 1000px; margin: 0 auto; padding: var(--space-8) var(--space-4); }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: 34px; }
  h2 { font-family: var(--font-display); color: var(--gold); font-size: 18px; margin-top: var(--space-6); margin-bottom: var(--space-3); }
  .lede { color: var(--text-muted); font-size: 14.5px; margin-top: var(--space-2); }
  .lede a { color: var(--gold); }
  .grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); margin-top: var(--space-4); }
  .grid.small { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
  .card {
    display: flex; flex-direction: column; gap: 4px;
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    text-decoration: none;
  }
  .card.ready { border-color: var(--border-gold-soft); }
  .card:hover { border-color: var(--gold); }
  .name { color: var(--ivory); font-weight: 500; font-size: 15px; }
  .desc { color: var(--text-dim); font-size: 13px; line-height: 1.55; }
  .hi { color: var(--text-dim); font-size: 13px; }
  .cta { color: var(--gold); font-size: 12.5px; margin-top: 6px; }
  .note { color: var(--text-faint); font-size: 13px; margin-top: var(--space-5); line-height: 1.6; }
  .note a { color: var(--gold); }
</style>
