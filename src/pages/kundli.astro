---
import DateField from "../components/DateField.astro";
import RequiredNote from "../components/forms/RequiredNote.astro";
import PlaceField from "../components/PlaceField.astro";
/**
 * /kundli — Free Kundli page (Epic 4.2): form → LIVE /api/v1/kundli →
 * North/South Indian SVG charts (printable), planetary table (incl. Navamsha
 * column), Vimshottari, API verdicts (Mangal dosha, Kaal Sarp, Sade Sati) and
 * the admin-authored interpretation notes (Epic 4.2b, GET /content/blocks
 * prefix=kundli.). No signup, no storage.
 * S24: the /hi twin renders this same body via the page path — chrome,
 * form labels and all JS-injected results follow the page language (KUNDLI
 * dict; sign/planet names mapped client-side until the API serves hi).
 */
import Base from "../layouts/Base.astro";
import { fetchContentBlocks } from "../lib/content";
import { langFromPath } from "../lib/i18n";
import { KUNDLI } from "../lib/i18n/kundli";

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "https://astro-backend.vyotish.workers.dev";
const lang = langFromPath(Astro.url.pathname);
const hi = lang === "hi";
const t = KUNDLI[lang];
const notes = (await fetchContentBlocks("kundli.", lang)) ?? {};
---

<Base
  title={t.title}
  description={t.description}
>
  <section class="kl">
    <h1 class={hi ? "hi-text" : ""}>{t.h1}</h1>
    <p class={`lede ${hi ? "hi-text" : ""}`}>
      {t.lede}
    </p>

    <form data-k-form>
      <RequiredNote lang={lang} />
      <div class="row">
        <DateField id="k-date" name="date" label={t.birthDate} required />
        <DateField mode="time" id="k-time" name="time" label={t.birthTime} value="10:00" required />
        <label class={hi ? "hi-text" : ""}>{t.chartStyle}
          <select name="style">
            <option value="north">{t.styleNorth}</option>
            <option value="south">{t.styleSouth}</option>
          </select>
        </label>
      </div>
      <PlaceField variant="combined" names={{ combined: "city" }} inputId="k-place" label={t.placeLabel} />
      <button type="submit" class={hi ? "hi-text" : ""}>{t.submit}</button>
    </form>

    <div class="k-error" data-k-error hidden>{t.errGeneric}</div>
  </section>

  <section class="k-out" data-k-out hidden aria-live="polite">
    <div class="charts">
      <figure data-chart-wrap>
        <figcaption class={hi ? "hi-text" : ""}>{t.figPre}<span data-style-label>{t.styleNorth}</span>{t.figPost}</figcaption>
        <div data-chart-svg></div>
      </figure>
    </div>

    <div class="summary" data-summary></div>

    <h2 class={hi ? "hi-text" : ""}>{t.h2Planets}</h2>
    <div class="table-wrap"><table data-planets></table></div>

    <h2 class={hi ? "hi-text" : ""}>{t.h2Dasha}</h2>
    <div class="table-wrap"><table data-dasha></table></div>

    <h2 class={hi ? "hi-text" : ""}>{t.h2Doshas}</h2>
    <div class="doshas" data-doshas></div>

    <h2 class={hi ? "hi-text" : ""} data-interp-head hidden>{t.h2Interp}</h2>
    <div class="interp" data-interp></div>

    <p class={`fine ${hi ? "hi-text" : ""}`}>
      {t.fine}
    </p>
  </section>
</Base>

<script is:inline define:vars={{
  apiBase, notes, locale: t.locale, errPlace: t.errPlace,
  styleNorth: t.styleNorth, styleSouth: t.styleSouth, ariaNorth: t.ariaNorth, ariaSouth: t.ariaSouth,
  sumLagna: t.sumLagna, sumBirth: t.sumBirth, sumDasha: t.sumDasha, padaLbl: t.padaLbl,
  thPlanet: t.thPlanet, thLon: t.thLon, thSign: t.thSign, thNak: t.thNak, thD9: t.thD9, thMotion: t.thMotion,
  retro: t.retro, direct: t.direct,
  thLord: t.thLord, thStart: t.thStart, thEnd: t.thEnd, thYears: t.thYears,
  dMangal: t.dMangal, dKaal: t.dKaal, dSadeSati: t.dSadeSati,
  vPresent: t.vPresent, vNot: t.vNot, vMangCancel: t.vMangCancel, cancelPre: t.cancelPre, kaalSuf: t.kaalSuf,
  ssRunPre: t.ssRunPre, ssRunPost: t.ssRunPost, ssNotRun: t.ssNotRun,
  ssSatPre: t.ssSatPre, ssMid: t.ssMid, ssSatPost: t.ssSatPost,
  ssWinPre: t.ssWinPre, ssTo: t.ssTo, ssWinPost: t.ssWinPost, ssNextPre: t.ssNextPre, ssNextPost: t.ssNextPost,
  signNames: t.signNames, planetNames: t.planetNames,
}}>
  (function () {
    var SIGNS = ["Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo", "Libra", "Scorpio", "Sagittarius", "Capricorn", "Aquarius", "Pisces"];
    var SIGN_SHORT = { Aries: "Ar", Taurus: "Ta", Gemini: "Ge", Cancer: "Cn", Leo: "Le", Virgo: "Vi", Libra: "Li", Scorpio: "Sc", Sagittarius: "Sg", Capricorn: "Cp", Aquarius: "Aq", Pisces: "Pi" };
    var ABBR = { Sun: "Su", Moon: "Mo", Mars: "Ma", Mercury: "Me", Jupiter: "Ju", Venus: "Ve", Saturn: "Sa", Rahu: "Ra", Ketu: "Ke" };

    function pname(p) { return planetNames[p] || p; }
    function sname(s) { return signNames[SIGNS.indexOf(s)] || s; }
    function esc(s) {
      return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
    function fmtDay(iso) {
      return iso ? new Date(iso).toLocaleDateString(locale, { day: "numeric", month: "short", year: "numeric" }) : "—";
    }

    var form = document.querySelector("[data-k-form]");
    var out = document.querySelector("[data-k-out]");
    var errEl = document.querySelector("[data-k-error]");
    var chartWrap = document.querySelector("[data-chart-svg]");
    var styleLabel = document.querySelector("[data-style-label]");
    var summaryEl = document.querySelector("[data-summary]");
    var planetsEl = document.querySelector("[data-planets]");
    var dashaEl = document.querySelector("[data-dasha]");
    var doshasEl = document.querySelector("[data-doshas]");
    var interpEl = document.querySelector("[data-interp]");
    var interpHead = document.querySelector("[data-interp-head]");
    var lastData = null;

    /* ---------- SVG charts ---------- */
    function housePlants(grahas, houses) {
      // planet → house; used for NIndian diamond placement
      var byHouse = {};
      grahas.forEach(function (g) {
        var h = houses[g.planet];
        (byHouse[h] = byHouse[h] || []).push(ABBR[g.planet] + (g.retrograde ? "*" : ""));
      });
      return byHouse;
    }
    function signPlanets(grahas) {
      var bySign = {};
      grahas.forEach(function (g) {
        (bySign[g.signIndex] = bySign[g.signIndex] || []).push(ABBR[g.planet] + (g.retrograde ? "*" : ""));
      });
      return bySign;
    }
    function planetText(list, x, y) {
      return "<text x='" + x + "' y='" + y + "' class='pt'>" + (list || []).join(" ") + "</text>";
    }

    function northSVG(lagnaSign, byHouse) {
      // North Indian: fixed house diamonds; house 1 top-center diamond.
      var W = 320, H = 320;
      var s = "<svg viewBox='0 0 " + W + " " + H + "' width='320' height='320' role='img' aria-label='" + ariaNorth + "'>";
      s += "<rect x='4' y='4' width='" + (W - 8) + "' height='" + (H - 8) + "' fill='none' stroke='currentColor' stroke-width='1.5'/>";
      var cx = W / 2, cy = H / 2;
      // diagonals + inner diamond
      s += "<line x1='4' y1='4' x2='" + (W - 4) + "' y2='" + (H - 4) + "' stroke='currentColor'/>";
      s += "<line x1='" + (W - 4) + "' y1='4' x2='4' y2='" + (H - 4) + "' stroke='currentColor'/>";
      s += "<polygon points='" + cx + ",4 " + (W - 4) + "," + cy + " " + cx + "," + (H - 4) + " 4," + cy + "' fill='none' stroke='currentColor'/>";
      // label positions per house (house1 top-center diamond etc.)
      var P = {
        1: [cx, 40], 2: [W - 80, 40], 3: [W - 60, cy - 60], 4: [W - 80, cy + 8], 5: [W - 60, cy + 70], 6: [W - 80, H - 36],
        7: [cx, H - 30], 8: [80, H - 36], 9: [60, cy + 70], 10: [80, cy + 8], 11: [60, cy - 60], 12: [80, 40],
      };
      for (var h = 1; h <= 12; h++) {
        var signNum = ((lagnaSign + h - 1) % 12) + 1;
        var p = P[h];
        s += "<text x='" + p[0] + "' y='" + (p[1] - 14) + "' class='hn'>" + signNum + "</text>";
        s += planetText(byHouse[h], p[0], p[1] + 4);
      }
      return s + "</svg>";
    }

    function southSVG(bySign) {
      // South Indian: fixed 4×4 grid; signs placed clockwise from Pisces/Aries corners.
      var W = 320, H = 320, u = 80;
      var layout = [ // [col,row] per signIndex 0..11 (Aries at second cell of top row)
        [1, 0], [2, 0], [3, 0], [3, 1], [3, 2], [3, 3],
        [2, 3], [1, 3], [0, 3], [0, 2], [0, 1], [0, 0],
      ];
      var s = "<svg viewBox='0 0 " + W + " " + H + "' width='320' height='320' role='img' aria-label='" + ariaSouth + "'>";
      for (var i = 0; i < 4; i++) {
        s += "<line x1='" + (i * u) + "' y1='0' x2='" + (i * u) + "' y2='" + H + "' stroke='currentColor'/>";
        s += "<line x1='0' y1='" + (i * u) + "' x2='" + W + "' y2='" + (i * u) + "' stroke='currentColor'/>";
      }
      s += "<rect x='0.75' y='0.75' width='" + (W - 1.5) + "' height='" + (H - 1.5) + "' fill='none' stroke='currentColor' stroke-width='1.5'/>";
      for (var sign = 0; sign < 12; sign++) {
        var pos = layout[sign];
        var x = pos[0] * u, y = pos[1] * u;
        s += "<text x='" + (x + 8) + "' y='" + (y + 16) + "' class='hn'>" + SIGN_SHORT[SIGNS[sign]] + "</text>";
        s += planetText(bySign[sign], x + 10, y + 40);
      }
      return s + "</svg>";
    }

    /* ---------- doshas — API verdicts (engine 1.8/1.10; D12: logic in backend) ---------- */
    function doshaNotes(d) {
      var m = d.manglik || {};
      var manglikVerdict = m.cancelled ? vMangCancel : m.is_manglik ? vPresent : vNot;
      var manglikDetail = m.detail || "";
      if (m.cancelled && m.cancellation_reason) manglikDetail += " " + cancelPre + m.cancellation_reason;

      var k = d.kaal_sarp || {};
      var ksVerdict = k.present ? (k.type ? k.type + kaalSuf : vPresent) : vNot;

      var s = d.sade_sati || {};
      var ssVerdict, ssDetail;
      if (s.in_sade_sati) {
        ssVerdict = ssRunPre + (s.phase ?? "—") + ssRunPost;
        ssDetail = ssSatPre + sname(s.saturn_sign) + ssMid + sname(s.moon_sign) + ssSatPost;
        if (s.current) ssDetail += ssWinPre + fmtDay(s.current.start) + ssTo + fmtDay(s.current.end) + ssWinPost;
      } else {
        ssVerdict = ssNotRun;
        ssDetail = s.next
          ? ssNextPre + fmtDay(s.next.start) + ssTo + fmtDay(s.next.end) + ssNextPost
          : "";
      }
      ssDetail += " " + (s.note || "");

      return [
        { name: dMangal, verdict: manglikVerdict, detail: manglikDetail },
        { name: dKaal, verdict: ksVerdict, detail: k.note || "" },
        { name: dSadeSati, verdict: ssVerdict, detail: ssDetail.trim() },
      ];
    }

    /* ---------- render ---------- */
    function render(d, style) {
      styleLabel.textContent = style === "south" ? styleSouth : styleNorth;
      var byHouse = housePlants(d.grahas, d.houses);
      var bySign = signPlanets(d.grahas);
      chartWrap.innerHTML = style === "south" ? southSVG(bySign) : northSVG(d.lagna.signIndex, byHouse);

      summaryEl.innerHTML =
        '<div class="s-grid">' +
        '<div class="s"><div class="k">' + sumLagna + '</div><div class="v">' + sname(d.lagna.sign) + " · " + d.lagna.nakshatra + padaLbl + d.lagna.pada + "</div></div>" +
        '<div class="s"><div class="k">' + sumBirth + '</div><div class="v">' + d.birth.date + " " + d.birth.time + " · " + d.birth.timezone + "</div></div>" +
        '<div class="s"><div class="k">' + sumDasha + '</div><div class="v">' + pname(d.dasha.mahadashas[0].lord) + "</div></div>" +
        "</div>";

      planetsEl.innerHTML =
        "<thead><tr><th>" + thPlanet + "</th><th>" + thLon + "</th><th>" + thSign + "</th><th>" + thNak + "</th><th>" + thD9 + "</th><th>" + thMotion + "</th></tr></thead><tbody>" +
        d.grahas.map(function (g) {
          var d9 = d.divisionals && d.divisionals[g.planet] ? d.divisionals[g.planet].D9 : null;
          return "<tr><td>" + pname(g.planet) + "</td><td>" + g.lon.toFixed(2) + "°</td><td>" + sname(g.sign) + "</td><td>" + g.nakshatra + " (" + g.pada + ")</td><td>" + (d9 == null ? "—" : signNames[d9]) + "</td><td>" + (g.retrograde ? retro : direct) + "</td></tr>";
        }).join("") +
        "</tbody>";

      dashaEl.innerHTML =
        "<thead><tr><th>" + thLord + "</th><th>" + thStart + "</th><th>" + thEnd + "</th><th>" + thYears + "</th></tr></thead><tbody>" +
        d.dasha.mahadashas.map(function (m) {
          return "<tr><td>" + pname(m.lord) + "</td><td>" + new Date(m.start).toLocaleDateString(locale) + "</td><td>" + new Date(m.end).toLocaleDateString(locale) + "</td><td>" + m.years + "</td></tr>";
        }).join("") +
        "</tbody>";

      doshasEl.innerHTML = doshaNotes(d).map(function (n) {
        return '<div class="d"><div class="dn">' + esc(n.name) + ': <strong>' + esc(n.verdict) + "</strong></div><div class=" + '"dd"' + ">" + esc(n.detail) + "</div></div>";
      }).join("");

      /* Interpretation notes (fetched at build time). Fail-soft per block;
       * nothing renders when none are published (honest empty state). */
      var noteKeys = Object.keys(notes || {}).sort();
      var noteHtml = "";
      for (var i = 0; i < noteKeys.length; i++) {
        var p = notes[noteKeys[i]];
        if (p && typeof p === "object" && typeof p.title === "string" && typeof p.body === "string" && p.title && p.body) {
          noteHtml += '<div class="in"><div class="in-t">' + esc(p.title) + '</div><div class="in-b">' + esc(p.body) + "</div></div>";
        }
      }
      interpEl.innerHTML = noteHtml;
      if (noteHtml) interpHead.removeAttribute("hidden"); else interpHead.setAttribute("hidden", "");

      out.removeAttribute("hidden");
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      errEl.setAttribute("hidden", "");
      var f = new FormData(form);
      var cityRaw = String(f.get("city") || "");
      var style = String(f.get("style") || "north");
      if (!cityRaw) {
        errEl.textContent = errPlace;
        errEl.removeAttribute("hidden");
        return;
      }
      var city = cityRaw.split(",");
      errEl.setAttribute("hidden", "");
      fetch(apiBase + "/api/v1/kundli" + (document.documentElement.lang === "hi" ? "?lang=hi" : ""), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ date: f.get("date"), time: f.get("time"), lat: parseFloat(city[0]), lng: parseFloat(city[1]), tz: city[2] }),
      })
        .then(function (r) { if (!r.ok) throw new Error("bad"); return r.json(); })
        .then(function (j) { lastData = j.data; render(j.data, style); if (window.vyTrack) window.vyTrack("kundli_generated"); })
        .catch(function () { errEl.removeAttribute("hidden"); });

      // re-render when style changes after a successful run
      var styleSel = form.querySelector("select[name=style]");
      styleSel.onchange = function () { if (lastData) render(lastData, styleSel.value); };
    });
  })();
</script>

<script>
  // S18 — shared validation gate (module script: imports the shared bundle).
  // dt + required-place come from markup; the inline handler above stays as
  // the no-JS-fallback path and never sees a blocked submission.
  import { installFormValidation } from "../scripts/form-validation";
  const kForm = document.querySelector<HTMLFormElement>("[data-k-form]");
  if (kForm) installFormValidation(kForm);
</script>

<style is:global>
  .kl { max-width: 860px; margin: 0 auto; padding: var(--space-7) var(--space-4) var(--space-5); }
  .kl h1 { font-family: var(--font-display); color: var(--ivory); font-size: 34px; }
  .lede { color: var(--text-muted); font-size: 14.5px; margin-top: var(--space-2); line-height: 1.6; }
  .kl form { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
  .row { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  /* :not() — this grid rule predates the shared DateField/PlaceField; their
     labels carry their own layout, and grid stacked the label text and the
     required `*` as two rows (star on its own line, S20 sweep) */
  .kl label:not(.dt-label):not(.pp-label) { flex: 1; min-width: 170px; display: grid; gap: var(--space-1); color: var(--text-dim); font-size: 13px; }
  .kl .dt { flex: 1; min-width: 200px; }
  .kl input:not(.dt-seg), .kl select:not(.dt-sel) {
    min-height: var(--target-min);
    background: var(--bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    color: var(--text-body);
    padding: 0 var(--space-3);
  }
  .kl button {
    min-height: var(--target-min);
    background: var(--color-accent);
    border: none;
    border-radius: var(--radius-pill);
    color: var(--ink-on-gold);
    font-weight: 500;
    cursor: pointer;
    justify-self: start;
    padding: 0 var(--space-6);
  }
  .k-error { color: var(--color-error-text); margin-top: var(--space-3); }
  .k-out { max-width: 860px; margin: 0 auto; padding: 0 var(--space-4) var(--space-8); }
  .charts { display: flex; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-5); }
  .k-out figure { margin: 0; }
  .k-out figcaption { color: var(--text-dim); font-size: 13px; margin-bottom: var(--space-2); }
  [data-chart-svg] { color: var(--text-dim); background: var(--bg-raised); border: 1px solid var(--border-gold-soft); border-radius: var(--radius-card); padding: var(--space-3); }
  [data-chart-svg] .hn { fill: var(--gold); font-size: 12px; }
  [data-chart-svg] .pt { fill: var(--text-body); font-size: 13px; font-weight: 600; }
  .summary { margin-top: var(--space-5); }
  .s-grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .s { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-3) var(--space-4); }
  .s .k { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); }
  .s .v { font-family: var(--font-display); font-size: 18px; color: var(--ivory); margin-top: 2px; }
  .k-out h2 { font-family: var(--font-display); color: var(--ivory); font-size: 22px; margin: var(--space-6) 0 var(--space-3); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); }
  .k-out table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .k-out th, .k-out td { text-align: left; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--border-faint); color: var(--text-body); }
  .k-out th { color: var(--text-dim); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; }
  .k-out tr:last-child td { border-bottom: none; }
  .doshas { display: grid; gap: var(--space-3); }
  .d { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-3) var(--space-4); }
  .d .dn { color: var(--text-body); font-size: 14px; }
  .d .dn strong { color: var(--ivory); }
  .d .dd { color: var(--text-faint); font-size: 12.5px; margin-top: var(--space-1); line-height: 1.6; }
  .interp { display: grid; gap: var(--space-3); }
  .in { background: var(--bg-raised); border: 1px solid var(--border-gold-soft); border-radius: var(--radius-card); padding: var(--space-3) var(--space-4); }
  .in-t { color: var(--gold); font-family: var(--font-display); font-size: 15px; }
  .in-b { color: var(--text-muted); font-size: 13.5px; line-height: 1.7; margin-top: var(--space-1); }
  .fine { color: var(--text-faint); font-size: 12.5px; margin-top: var(--space-6); }
</style>
