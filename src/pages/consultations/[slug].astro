---
import BookingForm from "../../components/BookingForm.astro";
/** /consultations/[slug] — astrologer profile + inline booking (Epic 5.2
 * follow-up). Build-time fetch of GET /api/v1/astrologers (D12: the frontend
 * renders; the directory list is the source of truth, so unknown slugs at
 * build time simply don't generate a page — 404 via the static output). */
import Base from "../../layouts/Base.astro";
import { type ApiAstrologer, fetchAstrologers } from "../../lib/content";

export async function getStaticPaths() {
  const astrologers = (await fetchAstrologers()) ?? [];
  return astrologers.map((a) => ({ params: { slug: a.slug }, props: { astrologer: a } }));
}

interface Props {
  astrologer: ApiAstrologer;
}
const { astrologer: a } = Astro.props;
const initials = a.name
  .replace(/^(Pt\.|Dr\.|Acharya)\s+/, "")
  .split(/\s+/)
  .map((w) => w[0] ?? "")
  .join("")
  .slice(0, 2)
  .toUpperCase();
const description =
  a.about.slice(0, 150) ||
  `${a.name} — ${a.title || "Vedic astrologer"} on Vyotish: ${a.expertise.slice(0, 3).join(", ")}. Request a consultation directly.`;
---

<Base title={`${a.name}${a.title ? ` — ${a.title}` : ""} | Vyotish Consultations`} description={description}>
  <section class="prof">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/consultations">Consultations</a> › <span aria-current="page">{a.name}</span>
    </nav>

    <div class="head">
      <span class="badge">{initials}</span>
      <div>
        <h1>{a.name} <span class="hi-text">(ज्योतिषी)</span></h1>
        {a.title && <p class="title">{a.title}</p>}
      </div>
      <span class={`avail ${a.is_available ? "on" : ""}`}>
        <span class="dot" /> {a.availability_label || (a.is_available ? "Available" : "Unavailable")}
      </span>
    </div>

    {a.about && <p class="about">{a.about}</p>}

    <div class="facts">
      <div class="fact"><span class="k">Experience</span><span class="v">{a.experience_years ?? "—"} years</span></div>
      <div class="fact"><span class="k">Consultation rate</span><span class="v">{a.rate_per_min === null ? "On request" : `₹${a.rate_per_min} / min`}</span></div>
      <div class="fact">
        <span class="k">Languages</span>
        <span class="v">{a.languages.length > 0 ? a.languages.join(", ") : "—"}</span>
      </div>
    </div>

    {
      a.expertise.length > 0 && (
        <div class="block">
          <h2>Expertise</h2>
          <div class="tags">
            {a.expertise.map((e) => (
              <span class="tag">{e}</span>
            ))}
          </div>
        </div>
      )
    }

    {
      a.session_types.length > 0 && (
        <div class="block">
          <h2>Session types</h2>
          <ul class="sessions">
            {a.session_types.map((s) => (
              <li>
                {s.type ?? "Session"}
                {s.duration_min ? ` · ${s.duration_min} min` : ""}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {a.is_sample && (
      <p class="note">Sample profile for Phase 1 review — profiles are admin-managed in the Vyotish admin area.</p>
    )}

    <h2>Request a consultation with {a.name}</h2>
    <div class="formpanel">
      <BookingForm kind="consultation" slug={a.slug} subjectLabel="Topic" submitLabel="Request Consultation" />
    </div>

    <p class="fine">Looking for someone else? <a href="/consultations">Back to the full directory</a>.</p>
  </section>
</Base>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://vyotish.com/" },
    { "@type": "ListItem", position: 2, name: "Consultations", item: "https://vyotish.com/consultations" },
    { "@type": "ListItem", position: 3, name: a.name },
  ],
})} />

<style>
  .prof { max-width: 860px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  .crumbs { color: var(--text-dim); font-size: 13px; }
  .crumbs a { color: var(--gold); text-decoration: underline; text-underline-offset: 2px; }
  .head { display: flex; gap: var(--space-4); align-items: center; margin-top: var(--space-4); flex-wrap: wrap; }
  .badge { width: 64px; height: 64px; border-radius: 999px; background: var(--gold); color: var(--color-on-primary); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 21px; flex-shrink: 0; }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(24px, 4.5vw, 34px); }
  .hi-text { color: var(--text-dim); font-size: 0.7em; }
  .title { color: var(--text-dim); font-size: 14px; margin-top: 2px; }
  .avail { color: var(--text-dim); font-size: 12.5px; display: inline-flex; align-items: center; gap: 6px; margin-left: auto; }
  .avail.on { color: #7fce9d; }
  .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--text-dim); display: inline-block; }
  .avail.on .dot { background: #7fce9d; }
  .about { color: var(--text-muted); font-size: 14.5px; line-height: 1.7; margin-top: var(--space-4); max-width: 720px; }
  .facts { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); margin-top: var(--space-5); }
  .fact { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-3) var(--space-4); }
  .fact .k { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); display: block; }
  .fact .v { font-family: var(--font-display); font-size: 16px; color: var(--ivory); margin-top: 2px; }
  .block { margin-top: var(--space-5); }
  h2 { font-family: var(--font-display); color: var(--gold); font-size: 18px; margin: var(--space-6) 0 var(--space-3); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { font-size: 11.5px; color: var(--text-dim); border: 1px solid var(--color-border); border-radius: 999px; padding: 2px 9px; }
  .sessions { margin: 0; padding-left: 18px; color: var(--text-muted); font-size: 13.5px; line-height: 1.9; }
  .note { color: var(--text-faint); font-size: 12.5px; margin-top: var(--space-5); }
  .formpanel { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-5); }
  .fine { color: var(--text-faint); font-size: 12.5px; margin-top: var(--space-6); }
  .fine a { color: var(--gold); }
</style>
