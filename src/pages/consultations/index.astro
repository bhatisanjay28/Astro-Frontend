---
import BookingForm from "../../components/BookingForm.astro";
import OfferStrip from "../../components/OfferStrip.astro";
/** /consultations/ — Astrologer directory + booking (Epic 5.2). Directory is
 * a build-time fetch of GET /api/v1/astrologers (D12); the booking form posts
 * live to POST /api/v1/requests/consultation. Offers come from the admin
 * settings (public.offers_config, audience=consultation) — honest empty state
 * when unset. Honest empty states throughout.
 * S24: the /hi twin renders this same body via the page path. */
import Base from "../../layouts/Base.astro";
import { fetchAstrologers, fetchSettings, parseOffers } from "../../lib/content";
import { langFromPath, withLang } from "../../lib/i18n";
import { CONSULTATIONS_HUB } from "../../lib/i18n/hubs";

const lang = langFromPath(Astro.url.pathname);
const hi = lang === "hi";
const t = CONSULTATIONS_HUB[lang];

const astrologers = (await fetchAstrologers()) ?? [];
const settings = await fetchSettings();
const offers = parseOffers(settings?.offers_config, "consultation");
---

<Base title={t.title} description={t.description}>
  <section class="cons">
    <h1 class={hi ? "hi-text" : ""}>{t.h1}</h1>
    <p class={`lede ${hi ? "hi-text" : ""}`}>
      {t.lede}
    </p>

    <OfferStrip offers={offers} />

    <div class="grid">
      {
        astrologers.length === 0 ? (
          <p class={`lede ${hi ? "hi-text" : ""}`}>{t.empty}</p>
        ) : (
          astrologers.map((a) => (
            <article class={`card ${hi ? "hi-text" : ""}`}>
              <div class="head">
                <span class="badge">{a.name.replace(/^(Pt\.|Dr\.|Acharya)\s+/, "").split(/\s+/).map((w) => w[0] ?? "").join("").slice(0, 2).toUpperCase()}</span>
                <div>
                  <span class="name">{a.name}</span>
                  {/* S24 — admin Hindi title/about surface when filled */}
                  {a.title && <span class="title">{hi && a.title_hi ? a.title_hi : a.title}</span>}
                  <span class="meta">
                    {a.experience_years ?? "—"} {t.yrsExp} · {a.languages.join(", ")}
                  </span>
                </div>
              </div>
              <p class="about">{hi && a.about_hi ? a.about_hi : a.about}</p>
              <div class="tags">
                {a.expertise.map((e) => (
                  <span class="tag">{e}</span>
                ))}
              </div>
              <div class="foot">
                <span class="rate">{a.rate_per_min === null ? "—" : `₹${a.rate_per_min} / min`}</span>
                <span class={`avail ${a.is_available ? "on" : ""}`}>
                  <span class="dot" /> {a.availability_label || (a.is_available ? t.availOn : t.availOff)}
                </span>
              </div>
              <a class="profile" href={withLang(`/consultations/${a.slug}`, Astro.url.pathname)}>{t.profile}</a>
            </article>
          ))
        )
      }
    </div>

    {astrologers.length > 0 && (
      <p class={`lede ${hi ? "hi-text" : ""}`}>
        {t.previewNote}
      </p>
    )}

    <h2 class={hi ? "hi-text" : ""}>{t.formH2}</h2>
    <div class="formpanel">
      <BookingForm kind="consultation" subjectLabel={t.subjectLabel} submitLabel={t.submitLabel} lang={lang} />
    </div>
  </section>
</Base>

<style>
  .cons { max-width: 1000px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(26px, 5vw, 38px); }
  h2 { font-family: var(--font-display); color: var(--gold); font-size: 19px; margin-top: var(--space-7); margin-bottom: var(--space-3); }
  .lede { color: var(--text-muted); margin-top: var(--space-2); font-size: 14.5px; max-width: 760px; }
  .grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); margin-top: var(--space-5); }
  .card { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  .head { display: flex; gap: var(--space-3); align-items: center; }
  .badge { width: 52px; height: 52px; border-radius: 999px; background: var(--gold); color: var(--color-on-primary); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 17px; flex-shrink: 0; }
  .name { display: block; color: var(--ivory); font-weight: 600; font-size: 15px; }
  .title { display: block; color: var(--text-dim); font-size: 12.5px; }
  .meta { display: block; color: var(--gold); font-size: 12px; margin-top: 2px; }
  .about { color: var(--text-muted); font-size: 13.5px; line-height: 1.6; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { font-size: 11.5px; color: var(--text-dim); border: 1px solid var(--color-border); border-radius: 999px; padding: 2px 9px; }
  .foot { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: var(--space-3); }
  .rate { color: var(--gold); font-weight: 600; font-size: 14px; }
  .avail { color: var(--text-dim); font-size: 12.5px; display: inline-flex; align-items: center; gap: 6px; }
  .avail.on { color: var(--color-auspicious-text); }
  .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--text-dim); display: inline-block; }
  .avail.on .dot { background: var(--color-auspicious-text); }
  .profile { color: var(--gold); font-size: 13px; text-decoration: none; margin-top: auto; }
  .profile:hover { text-decoration: underline; }
  .formpanel { margin-top: var(--space-4); background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-5); }
</style>
