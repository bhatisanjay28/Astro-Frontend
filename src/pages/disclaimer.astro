---
/**
 * Astrological Disclaimer — Epic 7.3 final draft. S24: content moved to
 * src/lib/i18n/disclaimer.ts (EN verified verbatim); the /hi twin renders Hindi.
 * Phase 5: an admin-authored DB override (content_blocks legal.disclaimer,
 * edited at /admin/legal) wins at build time; the in-repo dict stays the
 * fallback.
 */
import LegalPage from "../components/LegalPage.astro";
import { langFromPath } from "../lib/i18n";
import { DISCLAIMER } from "../lib/i18n/disclaimer";
import { resolveLegalDoc } from "../lib/legal-content";

const t = await resolveLegalDoc("disclaimer", langFromPath(Astro.url.pathname), DISCLAIMER);
---

<LegalPage title={t.title} heading={t.heading} intro={t.intro} updated={t.updated} sections={t.sections} />
