---
/** /admin/media — upload images + copy URLs (Epic 6.4). PNG/JPEG/WebP/GIF,
 * 5MB cap — enforced server-side too. */
import Admin from "../../layouts/Admin.astro";
---

<Admin title="Media | Vyotish Admin" active="media">
  <h1>Media</h1>
  <form id="up" class="card">
    <label for="file">Image (PNG, JPEG, WebP or GIF — max 5 MB)</label>
    <input id="file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" required />
    <label for="alt">Alt text</label>
    <input id="alt" placeholder="Describe the image" />
    <p><button type="submit" class="btn">Upload</button></p>
  </form>
  <table style="margin-top:14px">
    <thead><tr><th>Path</th><th>MIME</th><th>Size</th><th>Uploaded</th><th>URL</th></tr></thead>
    <tbody id="rows"><tr><td colspan="5" class="empty">Loading…</td></tr></tbody>
  </table>
</Admin>

<script>
  import { api, el, esc, fmtDate, renderRows, requireSession, toast, logout } from "../../scripts/admin/api";

  const row = (m: Record<string, unknown>) => {
    const url = typeof m.url === "string" ? m.url : "";
    return `<tr>
      <td>${esc(m.path)}</td>
      <td>${esc(m.mime ?? "—")}</td>
      <td>${m.size_bytes ? `${Math.round(Number(m.size_bytes) / 1024)} KB` : "—"}</td>
      <td>${fmtDate(m.created_at)}</td>
      <td><input readonly value="${esc(url)}" style="max-width:280px; font-size:11px" onclick="this.select()" /></td>
    </tr>`;
  };

  async function load(): Promise<void> {
    const res = await api<{ data?: { media?: Array<Record<string, unknown>> } }>("/api/v1/admin/media");
    if (res.ok) renderRows("#rows", res.body.data?.media, row, "No media yet.");
    else toast(res.body.error?.message ?? "Loading failed", true);
  }

  el<HTMLFormElement>("#up")!.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const file = el<HTMLInputElement>("#file")!.files?.[0];
    if (!file) return;
    const alt = el<HTMLInputElement>("#alt")!.value.trim();
    const qs = new URLSearchParams({ filename: file.name });
    if (alt) qs.set("alt", alt);
    const res = await api<{ data?: { url?: string } }>(`/api/v1/admin/media?${qs.toString()}`, {
      method: "POST",
      body: file,
    });
    if (res.ok) {
      toast("Uploaded — URL copied to the table below.");
      el<HTMLInputElement>("#file")!.value = "";
      el<HTMLInputElement>("#alt")!.value = "";
      await load();
    } else {
      toast(res.body.error?.message ?? "Upload failed", true);
    }
  });
  document.getElementById("admin-logout")?.addEventListener("click", logout);
  if (await requireSession()) await load();
</script>
