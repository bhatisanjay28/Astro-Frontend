---
import { API_BASE } from "../../scripts/admin/api";
import "../../styles/fonts.css";

const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Admin sign in | Vyotish</title>
    <style>
      /* box-sizing here (no Tailwind preflight on this standalone page):
         without it width:340px + 28px padding overflows 360px screens. */
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #14100c; color: #ece5d8; font: 14px/1.55 Poppins, sans-serif; padding: 16px; }
      .card { width: min(340px, 100%); background: #1d1710; border: 1px solid #3a2f1f; border-radius: 14px; padding: 28px; }
      h1 { font-size: 18px; color: #d4a843; margin: 0 0 6px; }
      p { color: #9b8f7a; font-size: 12.5px; margin: 0 0 18px; }
      label { display: block; font-size: 12px; color: #9b8f7a; margin: 12px 0 4px; }
      input { width: 100%; background: #241c13; border: 1px solid #3a2f1f; color: #ece5d8; border-radius: 8px; padding: 9px 10px; font: inherit; }
      button { width: 100%; margin-top: 18px; background: #d4a843; color: #1a1206; border: 0; border-radius: 8px; padding: 10px; font: inherit; font-weight: 600; cursor: pointer; }
      button:disabled { opacity: 0.6; cursor: wait; }
      .err { color: #e08a8a; font-size: 12.5px; margin-top: 12px; min-height: 16px; }
      .notice { color: #d4a843; font-size: 12.5px; margin: -12px 0 12px; }
    </style>
    <script is:inline src="/turnstile.js" defer></script>
  </head>
  <body>
    <form class="card" id="login-form" data-api-base={API_BASE}>
      <h1>Vyotish Admin</h1>
      <p>Sign in with your Vyotish admin account.</p>
      <p class="notice" id="notice" hidden role="status"></p>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" required />
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
      <div data-turnstile-slot data-turnstile-sitekey={turnstileSitekey} style="margin-top:14px"></div>
      <button type="submit" id="go">Sign in</button>
      <div class="err" id="err" role="alert"></div>
    </form>
    <script>
      // Auth goes through the backend proxy (D4): the browser never talks to
      // Supabase directly and never sees a Supabase key.
      const notice = document.getElementById("notice") as HTMLElement;
      const reason = new URLSearchParams(location.search).get("reason");
      if (reason === "idle") {
        notice.textContent = "You were signed out after 30 minutes of inactivity.";
        notice.hidden = false;
      } else if (reason === "password_set") {
        notice.textContent = "Password set. Sign in with your new password.";
        notice.hidden = false;
      }
      const form = document.getElementById("login-form") as HTMLFormElement;
      type VyotishTurnstile = { ensure(c: ParentNode): void; getToken(c: ParentNode): Promise<string> };
      const ts = () => (window as unknown as { VyotishTurnstile?: VyotishTurnstile }).VyotishTurnstile;
      ts()?.ensure(form);
      form.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        const btn = document.getElementById("go") as HTMLButtonElement;
        const err = document.getElementById("err") as HTMLElement;
        btn.disabled = true;
        err.textContent = "";
        const email = (document.getElementById("email") as HTMLInputElement).value.trim();
        const password = (document.getElementById("password") as HTMLInputElement).value;
        const apiBase = form.dataset.apiBase || "";
        try {
          const turnstileToken = await ts()?.getToken(form);
          const res = await fetch(apiBase + "/api/v1/auth/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password, turnstile_token: turnstileToken || undefined }),
          });
          const body = await res.json();
          if (!res.ok || !body?.data?.access_token) {
            err.textContent = body?.error?.message ?? "Sign in failed";
            btn.disabled = false;
            return;
          }
          sessionStorage.setItem("vyotish.admin.token", body.data.access_token);
          sessionStorage.setItem("vyotish.admin.refresh", body.data.refresh_token ?? "");
          sessionStorage.setItem("vyotish.admin.email", body.data.user?.email ?? email);
          location.href = "/admin";
        } catch {
          err.textContent = "Network error — is the backend reachable?";
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>
