---
/** /admin/taxonomy — categories (create) + tags (list) (Epic 6.4). */
import Admin from "../../layouts/Admin.astro";
---

<Admin title="Taxonomy | Vyotish Admin" active="taxonomy">
  <h1>Categories & tags</h1>
  <div class="grid2">
    <div>
      <h2>New category</h2>
      <form id="cat-form" class="card">
        <label for="cat-name">Name</label>
        <input id="cat-name" required maxlength="80" />
        <label for="cat-slug">Slug (blank → from name; provide one for Hindi names)</label>
        <input id="cat-slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" />
        <p><button type="submit" class="btn">Create category</button></p>
      </form>
      <table style="margin-top:14px">
        <thead><tr><th>Name</th><th>Slug</th></tr></thead>
        <tbody id="cat-rows"><tr><td colspan="2" class="empty">Loading…</td></tr></tbody>
      </table>
    </div>
    <div>
      <h2>Tags (auto-created from posts)</h2>
      <table>
        <thead><tr><th>Name</th><th>Slug</th></tr></thead>
        <tbody id="tag-rows"><tr><td colspan="2" class="empty">Loading…</td></tr></tbody>
      </table>
    </div>
  </div>
</Admin>

<script>
  import { api, el, esc, renderRows, requireSession, toast, logout } from "../../scripts/admin/api";

  async function load(): Promise<void> {
    const [cats, tags] = await Promise.all([
      api<{ data?: { categories?: Array<{ slug: string; name: string }> } }>("/api/v1/admin/categories"),
      api<{ data?: { tags?: Array<{ slug: string; name: string }> } }>("/api/v1/admin/tags"),
    ]);
    const pairRow = (t: { slug: string; name: string }) =>
      `<tr><td>${esc(t.name)}</td><td>${esc(t.slug)}</td></tr>`;
    if (cats.ok) renderRows("#cat-rows", cats.body.data?.categories, pairRow, "No categories yet.");
    if (tags.ok) renderRows("#tag-rows", tags.body.data?.tags, pairRow, "No tags yet.");
  }

  el<HTMLFormElement>("#cat-form")!.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const name = el<HTMLInputElement>("#cat-name")!.value.trim();
    const slug = el<HTMLInputElement>("#cat-slug")!.value.trim();
    const res = await api("/api/v1/admin/categories", { method: "POST", body: JSON.stringify({ name, slug: slug || undefined }) });
    toast(res.ok ? "Category created." : res.body.error?.message ?? "Create failed", !res.ok);
    if (res.ok) {
      el<HTMLInputElement>("#cat-name")!.value = "";
      el<HTMLInputElement>("#cat-slug")!.value = "";
      await load();
    }
  });
  document.getElementById("admin-logout")?.addEventListener("click", () => logout());
  if (await requireSession()) await load();
</script>
