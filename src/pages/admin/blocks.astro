---
/** /admin/blocks — keyed content-block editor (Epic 4.2b, phase-4 §10).
 * Backs every keyed JSONB block surface (block_key "group.name" — the
 * kundli interpretation notes being the first). Phase 4: the list is no
 * longer hardcoded to the kundli.* prefix — one fetch of the whole store
 * (server caps at 500) feeds a group dropdown derived from the distinct
 * block_key prefixes, and the save form accepts any namespaced key.
 * Writes go through the admin CRUD; published rows are public via RLS. */
import Admin from "../../layouts/Admin.astro";
---

<Admin title="Content blocks | Vyotish Admin" active="blocks">
  <h1>Content blocks</h1>
  <p style="color:var(--a-dim); font-size:13px; margin:0 0 14px">
    Keyed JSONB content served by <code>GET /api/v1/content/blocks?prefix=</code> — keys are
    <code>group.name</code> (e.g. <code>kundli.lagna</code>), payload shape
    <code>&#123;"title": "…", "body": "…"&#125;</code> unless the consuming page says otherwise.
  </p>
  <div class="toolbar">
    <select id="f-group" aria-label="Filter by key group"><option value="">All groups</option></select>
    <span class="sub" id="count-note"></span>
  </div>
  <form id="up" class="card">
    <div class="grid2">
      <div>
        <label for="key">Block key (group.name — lowercase a-z 0-9 . _ -)</label>
        <input id="key" pattern="[a-z0-9_.-]{1,80}" required />
      </div>
      <div>
        <label for="lang">Language</label>
        <select id="lang">
          <option value="en">en</option>
          <option value="hi">hi</option>
        </select>
      </div>
      <div>
        <label for="status">Status</label>
        <select id="status">
          <option value="published">published</option>
          <option value="draft">draft</option>
        </select>
      </div>
    </div>
    <div style="margin-top:10px">
      <label for="title">Title</label>
      <input id="title" required maxlength="120" />
    </div>
    <div style="margin-top:10px">
      <label for="body">Body</label>
      <textarea id="body" rows="5" required maxlength="4000"></textarea>
    </div>
    <p><button type="submit" class="btn">Save block</button></p>
  </form>
  <table style="margin-top:14px">
    <thead><tr><th>Key</th><th>Lang</th><th>Status</th><th>Updated</th><th></th></tr></thead>
    <tbody id="rows"><tr><td colspan="5" class="empty">Loading…</td></tr></tbody>
  </table>
</Admin>

<script>
  import { api, el, esc, fmtDate, renderRows, requireSession, toast, logout } from "../../scripts/admin/api";
  import { confirmDialog } from "../../scripts/admin/confirm";

  interface BlockRow {
    block_key: string;
    lang: string;
    status: string;
    is_sample?: boolean;
    updated_at: string | null;
    payload: Record<string, unknown>;
  }

  let all: BlockRow[] = [];

  const groupOf = (key: string): string => key.split(".")[0] ?? key;

  function refreshGroups(): void {
    const sel = el<HTMLSelectElement>("#f-group")!;
    const current = sel.value;
    const groups = [...new Set(all.map((b) => groupOf(b.block_key)))].sort();
    sel.innerHTML =
      `<option value="">All groups</option>` +
      groups.map((g) => `<option value="${esc(g)}"${g === current ? " selected" : ""}>${esc(g)}.</option>`).join("");
  }

  function visible(): BlockRow[] {
    const g = el<HTMLSelectElement>("#f-group")!.value;
    return g ? all.filter((b) => groupOf(b.block_key) === g) : all;
  }

  const row = (b: BlockRow) => {
    const payload = b.payload ?? {};
    return `<tr>
      <td><strong>${esc(b.block_key)}</strong><br><span style="color:var(--a-dim)">${esc(String(payload.title ?? ""))}</span></td>
      <td>${esc(String(b.lang))}</td>
      <td>${esc(String(b.status))}${b.is_sample ? ' <span style="color:var(--a-dim)">(sample)</span>' : ""}</td>
      <td>${fmtDate(b.updated_at)}</td>
      <td style="white-space:nowrap">
        <button class="btn ghost" data-edit="${esc(b.block_key)}" data-lang="${esc(String(b.lang))}" data-title="${esc(String(payload.title ?? ""))}" data-body="${esc(String(payload.body ?? ""))}">Edit</button>
        <button class="btn danger" data-del="${esc(b.block_key)}" data-lang="${esc(String(b.lang))}">Delete</button>
      </td>
    </tr>`;
  };

  async function load(): Promise<void> {
    const res = await api<{ data?: { blocks?: BlockRow[] } }>("/api/v1/admin/content-blocks");
    if (!res.ok) {
      toast(res.body.error?.message ?? "Loading failed", true);
      return;
    }
    all = res.body.data?.blocks ?? [];
    refreshGroups();
    renderTable();
  }

  function renderTable(): void {
    const rows = visible();
    const g = el<HTMLSelectElement>("#f-group")!.value;
    renderRows(
      "#rows",
      rows,
      row,
      g
        ? `No blocks under ${g}.* yet — save the first one above.`
        : "No content blocks yet — save the first one above.",
    );
    el<HTMLSpanElement>("#count-note")!.textContent = `${rows.length} block${rows.length === 1 ? "" : "s"}${g ? ` in ${g}.` : ""}`;
  }

  el<HTMLSelectElement>("#f-group")!.addEventListener("change", () => renderTable());

  el<HTMLFormElement>("#up")!.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    const key = el<HTMLInputElement>("#key")!.value.trim();
    if (!key.includes(".") || key.startsWith(".") || key.endsWith(".")) {
      toast('Key must be namespaced as "group.name" (e.g. kundli.lagna).', true);
      return;
    }
    const res = await api(`/api/v1/admin/content-blocks/${encodeURIComponent(key)}`, {
      method: "PUT",
      body: JSON.stringify({
        lang: el<HTMLSelectElement>("#lang")!.value,
        status: el<HTMLSelectElement>("#status")!.value,
        payload: {
          title: el<HTMLInputElement>("#title")!.value.trim(),
          body: el<HTMLTextAreaElement>("#body")!.value.trim(),
        },
      }),
    });
    toast(res.ok ? "Saved." : res.body.error?.message ?? "Save failed", !res.ok);
    if (res.ok) await load();
  });

  document.querySelector("tbody")!.addEventListener("click", async (ev) => {
    const t = ev.target as HTMLElement;
    const editBtn = t.closest("button[data-edit]") as HTMLElement | null;
    if (editBtn) {
      el<HTMLInputElement>("#key")!.value = editBtn.dataset.edit ?? "";
      el<HTMLSelectElement>("#lang")!.value = editBtn.dataset.lang ?? "en";
      el<HTMLInputElement>("#title")!.value = editBtn.dataset.title ?? "";
      el<HTMLTextAreaElement>("#body")!.value = editBtn.dataset.body ?? "";
      toast(`Loaded ${editBtn.dataset.edit} — adjust and Save to overwrite.`);
      return;
    }
    const delBtn = t.closest("button[data-del]") as HTMLElement | null;
    if (delBtn) {
      const delKey = delBtn.dataset.del ?? "";
      const okGo = await confirmDialog({
        title: "Delete content block",
        message: `Delete ${delKey} (${delBtn.dataset.lang})? This un-publishes it immediately.`,
        confirmText: "Delete",
        danger: true,
        requireText: delKey,
      });
      if (!okGo) return;
      const res = await api(
        `/api/v1/admin/content-blocks/${encodeURIComponent(delKey)}?lang=${encodeURIComponent(delBtn.dataset.lang ?? "en")}`,
        { method: "DELETE" },
      );
      toast(res.ok ? "Deleted." : res.body.error?.message ?? "Delete failed", !res.ok);
      if (res.ok) await load();
    }
  });
  document.getElementById("admin-logout")?.addEventListener("click", () => logout());
  if (await requireSession()) await load();
</script>
