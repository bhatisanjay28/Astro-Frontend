---
import BookingForm from "../../components/BookingForm.astro";
/** /poojan/ — Pooja catalogue + booking (Epic 5.3). Catalogue is a
 * build-time fetch of GET /api/v1/pujas (D12); the booking form posts live to
 * POST /api/v1/requests/puja. Honest empty states throughout. */
import Base from "../../layouts/Base.astro";
import { fetchPujas } from "../../lib/content";

const pujas = (await fetchPujas()) ?? [];
const EMPTY =
  "The poojan catalogue is temporarily unavailable — the backend service could not be reached at build time. Please try again later.";
---

<Base
  title="Poojan — Vedic Puja Catalogue | Vyotish"
  description="Vedic pujas with purpose, duration, mode and what's included — Graha Shanti, Satyanarayan, Griha Pravesh and more — booked through the Vyotish admin inbox."
>
  <section class="poo">
    <h1>Poojan <span class="hi-text">(पूजन)</span></h1>
    <p class="lede">
      Traditional pujas performed by qualified pandits — online or at your home/temple.
      Every listing states its purpose, duration and inclusions. Request below; the team
      confirms muhurat, samagri and mode personally.
    </p>

    <div class="grid">
      {
        pujas.length === 0 ? (
          <p class="lede">{EMPTY}</p>
        ) : (
          pujas.map((p) => (
            <article class="card">
              <div class="toprow">
                <span class="cat">{p.category.replace(/_/g, " ")}</span>
                {p.name_hi && <span class="hi">{p.name_hi}</span>}
              </div>
              <span class="name">{p.name}</span>
              {p.purpose && <p class="purpose"><strong>Purpose:</strong> {p.purpose}</p>}
              {p.description && <p class="desc">{p.description}</p>}
              <div class="tags">
                {p.mode.map((m) => (
                  <span class="tag">{m}</span>
                ))}
                {p.duration_label && <span class="tag">{p.duration_label}</span>}
              </div>
              {p.includes.length > 0 && (
                <p class="includes"><strong>Includes:</strong> {p.includes.join(" · ")}</p>
              )}
              {p.muhurat_note && <p class="note">{p.muhurat_note}</p>}
              <div class="foot">
                <span class="price">{p.price_inr === null ? "On request" : `₹${p.price_inr.toLocaleString("en-IN")}`}</span>
              </div>
            </article>
          ))
        )
      }
    </div>

    <h2>Request a puja</h2>
    <div class="formpanel">
      <BookingForm kind="puja" subjectLabel="Puja" submitLabel="Request Puja" />
    </div>
  </section>
</Base>

<style>
  .poo { max-width: 1000px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(26px, 5vw, 38px); }
  h2 { font-family: var(--font-display); color: var(--gold); font-size: 19px; margin-top: var(--space-7); margin-bottom: var(--space-3); }
  .hi-text { color: var(--text-dim); font-size: 0.7em; }
  .lede { color: var(--text-muted); margin-top: var(--space-2); font-size: 14.5px; max-width: 760px; }
  .grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: var(--space-5); }
  .card { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); }
  .toprow { display: flex; justify-content: space-between; align-items: center; }
  .cat { font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); border: 1px solid var(--border-gold-soft); border-radius: 999px; padding: 2px 10px; }
  .hi { color: var(--text-dim); font-size: 13px; }
  .name { color: var(--ivory); font-weight: 600; font-size: 16px; }
  .purpose, .includes { color: var(--text-muted); font-size: 13px; line-height: 1.55; }
  .purpose strong, .includes strong { color: var(--ivory); font-weight: 600; }
  .desc { color: var(--text-muted); font-size: 13px; line-height: 1.6; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { font-size: 11.5px; color: var(--text-dim); border: 1px solid var(--color-border); border-radius: 999px; padding: 2px 9px; }
  .note { color: var(--text-faint); font-size: 12.5px; line-height: 1.5; }
  .foot { border-top: 1px solid var(--color-border); padding-top: var(--space-3); margin-top: var(--space-2); }
  .price { color: var(--gold); font-weight: 700; font-size: 15px; }
  .formpanel { margin-top: var(--space-4); background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-5); }
</style>
