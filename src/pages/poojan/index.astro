---
import BookingForm from "../../components/BookingForm.astro";
import OfferStrip from "../../components/OfferStrip.astro";
/** /poojan/ — Pooja catalogue + booking (Epic 5.3). Catalogue is a
 * build-time fetch of GET /api/v1/pujas (D12); the booking form posts live to
 * POST /api/v1/requests/puja. Offers come from the admin settings
 * (public.offers_config, audience=puja) — honest empty state when unset.
 * S24: the /hi twin renders this same body via the page path. */
import Base from "../../layouts/Base.astro";
import { fetchPujas, fetchSettings, parseOffers } from "../../lib/content";
import { langFromPath, withLang } from "../../lib/i18n";
import { POOJAN_HUB } from "../../lib/i18n/hubs";

const lang = langFromPath(Astro.url.pathname);
const hi = lang === "hi";
const t = POOJAN_HUB[lang];

const pujas = (await fetchPujas()) ?? [];
const settings = await fetchSettings();
const offers = parseOffers(settings?.offers_config, "puja");
---

<Base title={t.title} description={t.description}>
  <section class="poo">
    <h1 class={hi ? "hi-text" : ""}>{t.h1}</h1>
    <p class={`lede ${hi ? "hi-text" : ""}`}>
      {t.lede}
    </p>

    <OfferStrip offers={offers} />

    <div class="grid">
      {
        pujas.length === 0 ? (
          <p class={`lede ${hi ? "hi-text" : ""}`}>{t.empty}</p>
        ) : (
          pujas.map((p) => (
            <article class={`card ${hi ? "hi-text" : ""}`}>
              <div class="toprow">
                <span class="cat">{p.category.replace(/_/g, " ")}</span>
                {/* S24 — gloss shows the OTHER language's name: hi as sub on EN
                    cards, EN as sub on hi cards; primary name follows the page */}
                {hi ? (p.name && p.name_hi ? <span class="hi">{p.name}</span> : null) : p.name_hi ? <span class="hi">{p.name_hi}</span> : null}
              </div>
              <span class="name">{hi && p.name_hi ? p.name_hi : p.name}</span>
              {p.purpose && <p class="purpose"><strong>{t.purpose}</strong> {p.purpose}</p>}
              {hi && p.description_hi ? <p class="desc">{p.description_hi}</p> : p.description && <p class="desc">{p.description}</p>}
              <div class="tags">
                {p.mode.map((m) => (
                  <span class="tag">{m}</span>
                ))}
                {p.duration_label && <span class="tag">{p.duration_label}</span>}
              </div>
              {p.includes.length > 0 && (
                <p class="includes"><strong>{t.includes}</strong> {p.includes.join(" · ")}</p>
              )}
              {p.muhurat_note && <p class="note">{p.muhurat_note}</p>}
              <div class="foot">
                <span class="price">{p.price_inr === null ? t.onRequest : `₹${p.price_inr.toLocaleString("en-IN")}`}</span>
                <a class="profile" href={withLang(`/poojan/${p.slug}`, Astro.url.pathname)}>{t.details}</a>
              </div>
            </article>
          ))
        )
      }
    </div>

    <h2 class={hi ? "hi-text" : ""}>{t.formH2}</h2>
    <div class="formpanel">
      <BookingForm kind="puja" subjectLabel={t.subjectLabel} submitLabel={t.submitLabel} lang={lang} />
    </div>
  </section>
</Base>

<style>
  .poo { max-width: 1000px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(26px, 5vw, 38px); }
  h2 { font-family: var(--font-display); color: var(--gold); font-size: 19px; margin-top: var(--space-7); margin-bottom: var(--space-3); }
  .lede { color: var(--text-muted); margin-top: var(--space-2); font-size: 14.5px; max-width: 760px; }
  .grid { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: var(--space-5); }
  .card { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); }
  .toprow { display: flex; justify-content: space-between; align-items: center; }
  .cat { font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); border: 1px solid var(--border-gold-soft); border-radius: 999px; padding: 2px 10px; }
  .hi { color: var(--text-dim); font-size: 13px; }
  .name { color: var(--ivory); font-weight: 600; font-size: 16px; }
  .purpose, .includes { color: var(--text-muted); font-size: 13px; line-height: 1.55; }
  .purpose strong, .includes strong { color: var(--ivory); font-weight: 600; }
  .desc { color: var(--text-muted); font-size: 13px; line-height: 1.6; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { font-size: 11.5px; color: var(--text-dim); border: 1px solid var(--color-border); border-radius: 999px; padding: 2px 9px; }
  .note { color: var(--text-faint); font-size: 12.5px; line-height: 1.5; }
  .foot { border-top: 1px solid var(--color-border); padding-top: var(--space-3); margin-top: var(--space-2); display: flex; justify-content: space-between; align-items: center; }
  .price { color: var(--gold); font-weight: 700; font-size: 15px; }
  .profile { color: var(--text-dim); font-size: 12.5px; text-decoration: none; }
  .profile:hover { color: var(--gold); }
  .formpanel { margin-top: var(--space-4); background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-5); }
</style>
