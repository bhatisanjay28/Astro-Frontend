---
import { getCollection } from "astro:content";
/** /astrology/learn/ — Learn hub (Epic 4.5): original articles from the
 * Astro content collection. S24: dict-driven chrome; /hi twin renders Hindi
 * chrome around the same (original-language) article list. */
import Base from "../../../layouts/Base.astro";
import { langFromPath, withLang } from "../../../lib/i18n";
import { LEARN_HUB, learnLede } from "../../../lib/i18n/learn";

const lang = langFromPath(Astro.url.pathname);
const t = LEARN_HUB[lang];
const here = Astro.url.pathname;
const articles = (await getCollection("learn")).sort((a, b) => a.data.order - b.data.order);
const ledeHtml = learnLede(lang, withLang("/calculators", here));
---

<Base title={t.title} description={t.description}>
  <section class="lrn">
    <h1 class={lang === "hi" ? "hi-text" : ""}>{t.h1}</h1>
    <p class="lede" set:html={ledeHtml} />
    <div class="grid">
      {
        articles.length === 0 ? (
          <p class="lede">{t.empty}</p>
        ) : (
          articles.map((a) => (
            <a class="card" href={`/astrology/learn/${a.id}`}>
              <span class="name">{a.data.title}</span>
              <span class="desc">{a.data.description}</span>
              <span class="cta">{t.cta}</span>
            </a>
          ))
        )
      }
    </div>
  </section>
</Base>

<style>
  .lrn { max-width: 900px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(26px, 5vw, 36px); }
  .lede { color: var(--text-muted); margin-top: var(--space-2); font-size: 14.5px; max-width: 700px; }
  .lede a { color: var(--gold); }
  .grid { display: grid; gap: var(--space-3); margin-top: var(--space-5); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  .card {
    display: flex; flex-direction: column; gap: 5px;
    background: var(--bg-raised);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    text-decoration: none;
  }
  .card:hover { border-color: var(--border-gold-soft); }
  .name { color: var(--ivory); font-weight: 500; font-size: 15px; }
  .desc { color: var(--text-dim); font-size: 13px; line-height: 1.55; }
  .cta { color: var(--gold); font-size: 12.5px; margin-top: var(--space-2); }
</style>
