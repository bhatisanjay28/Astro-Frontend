---
import PostCard from "../../../components/blog/PostCard.astro";
import Base from "../../../layouts/Base.astro";
import { fetchBlogPosts, fetchBlogTags } from "../../../lib/content";

/** /blog/tag/{slug} — all published posts carrying one tag (Epic 6.3). */

export async function getStaticPaths() {
  const tags = (await fetchBlogTags()) ?? [];
  const paths: Array<{ params: { slug: string }; props: { tag: { slug: string; name: string } } }> =
    [];
  for (const tag of tags) {
    const result = await fetchBlogPosts({ tag: tag.slug, perPage: 50 });
    if (result && result.posts.length > 0) {
      paths.push({ params: { slug: tag.slug }, props: { tag } });
    }
  }
  return paths;
}

const { tag } = Astro.props as { tag: { slug: string; name: string } };
const result = await fetchBlogPosts({ tag: tag.slug, perPage: 50 });
const posts = result?.posts ?? [];
---

<Base
  title={`Articles tagged “${tag.name}” | Vyotish Blog`}
  description={`All Vyotish articles tagged ${tag.name} — original Vedic astrology education.`}
>
  <section class="blog">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/blog">Blog</a>
      <span>#{tag.name}</span>
    </nav>
    <h1>#{tag.name}</h1>
    {
      posts.length === 0 ? (
        <p class="empty">No articles carry this tag yet — check back shortly.</p>
      ) : (
        <div class="grid">
          {posts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      )
    }
  </section>
</Base>

<style>
  .blog { max-width: 900px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  .crumbs { display: flex; gap: var(--space-2); font-size: 13px; color: var(--text-dim); }
  .crumbs a { color: var(--gold); text-decoration: none; }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(26px, 5vw, 36px); margin-top: var(--space-2); }
  .grid { display: grid; gap: var(--space-3); margin-top: var(--space-5); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  .empty { margin-top: var(--space-6); color: var(--text-muted); font-size: 14.5px; border: 1px dashed var(--border-gold-soft); border-radius: var(--radius-card); padding: var(--space-5); }
</style>
