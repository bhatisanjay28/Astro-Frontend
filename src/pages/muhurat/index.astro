---
import PlaceField from "../../components/PlaceField.astro";
import DateField from "../../components/DateField.astro";
import RequiredNote from "../../components/forms/RequiredNote.astro";
/** /muhurat/ — today's windows + finder form (Epic 3.4). Client islands on
 * the LIVE /api/v1/muhurat routes. City pickers use the /places proxy
 * (owner directive, 2026-11-20); the today-island keeps a New Delhi default
 * and reloads when a place is selected. */
import Base from "../../layouts/Base.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "https://astro-backend.vyotish.workers.dev";
const EVENTS = [
  "marriage",
  "engagement",
  "griha_pravesh",
  "vehicle",
  "property",
  "business",
  "naamkaran",
  "mundan",
  "annaprashan",
  "travel",
];
---

<Base
  title="Muhurat Today & Finder | Vyotish"
  description="Today's auspicious and inauspicious windows (Abhijit, Brahma Muhurta, Rahu Kaal) and an event-wise muhurat finder."
>
  <section class="mt">
    <h1>Muhurat</h1>
    <p class="lede">
      Today's auspicious and inauspicious periods for your city, plus an event-wise
      finder. <strong>Treat the windows as indicative only — for an important
      occasion, confirm the muhurat in a personal consultation.</strong>
    </p>
  </section>

  <section class="today" aria-labelledby="today-h">
    <h2 id="today-h">Today</h2>
    <div class="toolbar">
      <div class="tb-city">
        <PlaceField
          variant="combined"
          inputId="mt-place"
          label="Your city"
          names={{ combined: "city" }}
          ids={{}}
          hiddenAttrs={{ "data-mt-city": "", value: "28.6139,77.209,Asia/Kolkata" }}
        />
      </div>
      <p class="def-note">Defaults to New Delhi — pick your city above for local windows.</p>
    </div>
    <div class="windows" data-mt-out>
      <div class="cell skeleton">Loading…</div>
    </div>
  </section>

  <section class="finder" aria-labelledby="finder-h">
    <h2 id="finder-h">Muhurat finder</h2>
    <form data-mf-form>
      <RequiredNote />
      <div class="row">
        <label>Event
          <select name="event">
            {EVENTS.map((e) => <option value={e}>{e.replace(/_/g, " ")}</option>)}
          </select>
        </label>
        <DateField id="mf-from" name="from" label="From" required preset="free" />
        <DateField id="mf-to" name="to" label="To" required preset="free" />
        <PlaceField
          variant="combined"
          inputId="mf-place"
          label="City"
          names={{ combined: "city" }}
        />
      </div>
      <button type="submit">Find muhurat windows</button>
    </form>
    <div class="mf-error" data-mf-error hidden>Could not run the finder — check the range (max 62 days) and try again.</div>
    <div class="mf-out" data-mf-out hidden aria-live="polite"></div>
  </section>

  <script>
    // S18 — shared validation gate for the finder: From/To dates + city are
    // markup-driven (all required); no text rules.
    import { installFormValidation } from "../../scripts/form-validation";
    const mfForm = document.querySelector<HTMLFormElement>("[data-mf-form]");
    if (mfForm) installFormValidation(mfForm);
  </script>

  <script is:inline define:vars={{ apiBase }}>
    (function () {
      function fmt(iso, tz) {
        try {
          return new Intl.DateTimeFormat("en-GB", { timeZone: tz, hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date(iso));
        } catch (e) { return "—"; }
      }
      function dayName(iso, tz) {
        try {
          return new Intl.DateTimeFormat("en-GB", { timeZone: tz, weekday: "short", day: "numeric", month: "short" }).format(new Date(iso));
        } catch (e) { return ""; }
      }

      // --- today block ---
      var citySel = document.querySelector("[data-mt-city]");
      var out = document.querySelector("[data-mt-out]");
      function loadToday() {
        var parts = citySel.value.split(",");
        var url = apiBase + "/api/v1/muhurat/today?lat=" + parts[0] + "&lng=" + parts[1] + "&tz=" + encodeURIComponent(parts[2]);
        out.innerHTML = '<div class="cell skeleton">Loading…</div>';
        fetch(url).then(function (r) { return r.json(); }).then(function (j) {
          var d = j.data;
          var rows = [];
          d.auspicious.forEach(function (s) {
            rows.push('<div class="cell good"><div class="sn">' + s.name + '</div><div class="st">' + fmt(s.start, d.timezone) + " – " + fmt(s.end, d.timezone) + "</div></div>");
          });
          d.inauspicious.forEach(function (s) {
            rows.push('<div class="cell bad"><div class="sn">' + s.name + '</div><div class="st">' + fmt(s.start, d.timezone) + " – " + fmt(s.end, d.timezone) + '</div><div class="ss">avoid</div></div>');
          });
          out.innerHTML = rows.join("");
        }).catch(function () { out.innerHTML = '<div class="cell">Unavailable right now.</div>'; });
      }
      citySel.addEventListener("change", loadToday);
      // the place picker writes the hidden input directly — listen for it
      var mtField = citySel.closest("[data-place-field]");
      if (mtField) mtField.addEventListener("place:selected", loadToday);
      loadToday();

      // --- finder ---
      var form = document.querySelector("[data-mf-form]");
      var mfErr = document.querySelector("[data-mf-error]");
      var mfOut = document.querySelector("[data-mf-out]");
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        mfErr.setAttribute("hidden", "");
        var f = new FormData(form);
        var cityRaw = String(f.get("city") || "");
        if (!cityRaw || cityRaw.split(",").length < 3) {
          mfErr.textContent = "Please select the city from the suggestions.";
          mfErr.removeAttribute("hidden");
          return;
        }
        var city = cityRaw.split(",");
        fetch(apiBase + "/api/v1/muhurat/find", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            event: f.get("event"),
            from: f.get("from"),
            to: f.get("to"),
            lat: parseFloat(city[0]),
            lng: parseFloat(city[1]),
            tz: city[2],
          }),
        })
          .then(function (r) { if (!r.ok) throw new Error("bad"); return r.json(); })
          .then(function (j) {
            var res = j.data;
            var html = '<p class="disc">' + res.disclaimer + "</p>";
            res.days.forEach(function (day) {
              var badge = day.verdict === "suitable" ? "ok" : day.verdict === "conditional" ? "cond" : "no";
              var fails = day.failing_rules.map(function (fr) { return fr.rule_name; }).join("; ") || "—";
              html += '<div class="day ' + badge + '"><div class="dh"><span>' + dayName(day.date + "T00:00:00Z", res.timezone) + '</span><span class="badge ' + badge + '">' + day.verdict + "</span></div>";
              html += '<div class="df">Failing rules: ' + fails + "</div>";
              day.candidate_windows.forEach(function (w) {
                html += '<div class="win">' + w.name + ": " + fmt(w.start, res.timezone) + " – " + fmt(w.end, res.timezone) + (w.exclusions.length ? " (excludes " + w.exclusions.join(", ") + ")" : "") + "</div>";
              });
              html += "</div>";
            });
            mfOut.innerHTML = html;
            mfOut.removeAttribute("hidden");
          })
          .catch(function () {
            mfOut.setAttribute("hidden", "");
            mfErr.removeAttribute("hidden");
          });
      });
    })();
  </script>

  <style is:global>
    .mt, .today, .finder { max-width: 1000px; margin: 0 auto; padding: var(--space-5) var(--space-4); }
    .mt { padding-top: var(--space-7); }
    .mt h1 { font-family: var(--font-display); color: var(--ivory); font-size: 36px; }
    .mt h2 { font-family: var(--font-display); color: var(--ivory); font-size: 24px; margin-bottom: var(--space-3); }
    .lede { color: var(--text-muted); font-size: 14.5px; line-height: 1.7; margin-top: var(--space-2); }
    .toolbar { display: flex; gap: var(--space-3); margin-bottom: var(--space-4); flex-wrap: wrap; }
    .tb-city { min-width: 260px; }
    .def-note { color: var(--text-dim); font-size: 12.5px; margin-top: var(--space-2); }
    .mt label { color: var(--text-dim); font-size: 13px; display: grid; gap: var(--space-1); flex: 1; min-width: 160px; }
    .finder .dt { flex: 1; min-width: 200px; }
    .mt select:not(.dt-sel), .mt input:not(.dt-seg) {
      min-height: var(--target-min);
      background: var(--bg-raised);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-card);
      color: var(--text-body);
      padding: 0 var(--space-3);
    }
    .windows { display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
    .cell { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-3); min-height: 64px; }
    .cell.good { background: var(--color-auspicious-bg); border-color: transparent; }
    .cell.good .sn { color: var(--color-auspicious-text); }
    .cell.good .sn::before { content: "✓ "; }
    .cell.bad { background: var(--color-inauspicious-bg); }
    .cell.bad .sn { color: var(--color-inauspicious-text); }
    .cell.bad .sn::before { content: "⚠ "; }
    .cell .sn { color: var(--color-text); font-weight: 500; font-size: 14px; }
    .cell .st { color: var(--color-text-muted); font-size: 13px; margin-top: 2px; font-variant-numeric: tabular-nums; }
    .cell .ss { color: var(--color-text-muted); font-size: 11px; }
    .cell.skeleton { display: flex; align-items: center; color: var(--text-dim); }
    .finder form { display: grid; gap: var(--space-3); }
    .finder .row { display: flex; gap: var(--space-3); flex-wrap: wrap; }
    .finder button {
      min-height: var(--target-min);
      padding: 0 var(--space-5);
      background: var(--color-accent);
      border: none;
      border-radius: var(--radius-pill);
      color: var(--ink-on-gold);
      font-weight: 500;
      cursor: pointer;
      justify-self: start;
    }
    .mf-error { color: var(--color-error-text); margin-top: var(--space-3); font-size: 14px; }
    .mf-out { margin-top: var(--space-4); }
    .disc { color: var(--text-faint); font-size: 12.5px; border: 1px dashed var(--border-gold-soft); border-radius: var(--radius-card); padding: var(--space-3); margin-bottom: var(--space-4); line-height: 1.6; }
    .day { background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-4); margin-bottom: var(--space-3); }
    .day.no { opacity: 0.75; }
    .dh { display: flex; justify-content: space-between; align-items: center; color: var(--ivory); font-weight: 500; }
    .badge { font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; border-radius: var(--radius-pill); padding: 4px 10px; }
    .badge.ok { background: var(--color-auspicious-bg); color: var(--color-auspicious-text); }
    .badge.ok::before { content: "✓ "; }
    .badge.cond { background: var(--color-tint); color: var(--color-text-muted); }
    .badge.no { background: var(--color-inauspicious-bg); border: none; color: var(--color-inauspicious-text); }
    .badge.no::before { content: "⚠ "; }
    .df { color: var(--text-dim); font-size: 12.5px; margin: var(--space-2) 0; }
    .win { color: var(--text-muted); font-size: 13.5px; padding: 3px 0; font-variant-numeric: tabular-nums; }
  </style>
</Base>
