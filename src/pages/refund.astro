---
/**
 * Refund & Cancellation — Epic 7.3 final draft. S24: content moved to
 * src/lib/i18n/refund.ts (EN verified verbatim); the /hi twin renders Hindi.
 * Phase 5: an admin-authored DB override (content_blocks legal.refund, edited
 * at /admin/legal) wins at build time; the in-repo dict stays the fallback.
 */
import LegalPage from "../components/LegalPage.astro";
import { langFromPath } from "../lib/i18n";
import { REFUND } from "../lib/i18n/refund";
import { resolveLegalDoc } from "../lib/legal-content";

const t = await resolveLegalDoc("refund", langFromPath(Astro.url.pathname), REFUND);
---

