---
import DateField from "../components/DateField.astro";
import RequiredNote from "../components/forms/RequiredNote.astro";
import PlaceField from "../components/PlaceField.astro";
/**
 * /matching — Guna Milan (Ashtakoota 36) + Manglik UI (Epic 4.3).
 * The page is a thin renderer: POST /api/v1/kundli/match does everything
 * (D12). Honest fail-soft; verification status surfaced (P11).
 * S24: the /hi twin renders this same body via the page path — labels and
 * the JS-injected result lines follow the page language (MATCHING dict).
 */
import Base from "../layouts/Base.astro";
import { langFromPath } from "../lib/i18n";
import { MATCHING } from "../lib/i18n/matching";

const lang = langFromPath(Astro.url.pathname);
const hi = lang === "hi";
const t = MATCHING[lang];

const labelClass =
  "block font-label text-label-sm font-semibold text-light-on-surface-variant dark:text-dark-on-surface-variant mb-1";

type InputType = "date" | "time" | "number" | "text";

const BOY = {
  prefix: "boy",
  label: t.boy,
  fields: [
    { name: "boy-date", label: t.boyDate, type: "date" },
    { name: "boy-time", label: t.boyTime, type: "time" },
  ] as Array<{ name: string; label: string; type: InputType; ph?: string }>,
};
const GIRL = {
  prefix: "girl",
  label: t.girl,
  fields: [
    { name: "girl-date", label: t.girlDate, type: "date" },
    { name: "girl-time", label: t.girlTime, type: "time" },
  ] as Array<{ name: string; label: string; type: InputType; ph?: string }>,
};
---

<Base title={t.title} description={t.description}>
  <section class="mx">
    <h1 class={hi ? "hi-text" : ""}>{t.h1}</h1>
    <p class={`lede ${hi ? "hi-text" : ""}`}>
      {t.lede}
    </p>

    <form id="match-form" class="panel" autocomplete="off">
      <RequiredNote lang={lang} />
      <div class="grid md:grid-cols-2 gap-6">
        {
          [BOY, GIRL].map((p) => (
            <fieldset class="person">
              <legend>{p.label}</legend>
              {p.fields.map((f) => (
                <div>
                  {/* S18: birth chart times drive the moon-based koota scores —
                      required for both people, like the dates and places */}
                  <DateField
                    mode={f.type === "time" ? "time" : "date"}
                    id={f.name}
                    name={f.name}
                    label={f.label}
                    labelClass={labelClass}
                    required
                  />
                </div>
              ))}
              <PlaceField
                variant="separate"
                label={`${p.label} ${hi ? "का जन्म स्थान" : "birth place"}`}
                inputId={`${p.prefix}-place`}
                ids={{ lat: `${p.prefix}-lat`, lng: `${p.prefix}-lng`, tz: `${p.prefix}-tz` }}
              />
            </fieldset>
          ))
        }
      </div>
      <button
        type="submit"
        class={`mt-5 w-full py-3 rounded bg-light-secondary text-light-on-secondary dark:bg-dark-secondary dark:text-dark-on-secondary font-label text-label-md font-semibold hover:opacity-95 transition-opacity ${hi ? "hi-text" : ""}`}
      >
        {t.submit}
      </button>
    </form>

    <section id="match-result" class={`result ${hi ? "hi-text" : ""}`} aria-live="polite">
      <p class="hint">{t.hint}</p>
    </section>

    <p class={`fine ${hi ? "hi-text" : ""}`}>
      {t.fine}
    </p>
  </section>
</Base>

<script define:vars={{
  apiBase: import.meta.env.PUBLIC_API_BASE_URL ?? "https://astro-backend.vyotish.workers.dev",
  errFields: t.errFields, matchingMsg: t.matching, fail: t.fail,
  okPre: t.okPre, okTh: t.okTh, warnPre: t.warnPre,
  thKoota: t.thKoota, thPoints: t.thPoints, thDetail: t.thDetail,
  manglikH3: t.manglikH3, yes: t.yes, no: t.no, cancelPre: t.cancelPre,
  rowBoyManglik: t.rowBoyManglik, rowGirlManglik: t.rowGirlManglik,
  rowReading: t.rowReading, rowBoyProfile: t.rowBoyProfile, rowGirlProfile: t.rowGirlProfile,
  moonLbl: t.moonLbl, padaLbl: t.padaLbl, flagline: t.flagline, errBackend: t.errBackend,
}}>
  (function () {
    var form = document.getElementById("match-form");
    var box = document.getElementById("match-result");
    if (!form || !box) return;

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (ch) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch];
      });
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var get = function (id) { var el = document.getElementById(id); return el ? String(el.value).trim() : ""; };
      function person(prefix) {
        return {
          date: get(prefix + "-date"),
          time: get(prefix + "-time") || "12:00",
          lat: parseFloat(get(prefix + "-lat")),
          lng: parseFloat(get(prefix + "-lng")),
          tz: get(prefix + "-tz"),
        };
      }
      var boy = person("boy");
      var girl = person("girl");
      if (!boy.date || !girl.date || !boy.tz || !girl.tz || isNaN(boy.lat) || isNaN(girl.lat)) {
        box.innerHTML = "<p class='hint err'>" + esc(errFields) + "</p>";
        return;
      }
      box.innerHTML = "<p class='hint'>" + esc(matchingMsg) + "</p>";
      fetch(apiBase + "/api/v1/kundli/match", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ boy: boy, girl: girl }),
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (r) {
          if (!r.ok || r.j.error) {
            box.innerHTML = "<p class='hint err'>" + esc((r.j.error && r.j.error.message) || fail) + "</p>";
            return;
          }
          var d = r.j.data;
          var a = d.ashtakoota;
          var rows = a.kootas.map(function (k) {
            return "<tr><td>" + esc(k.koota.replace("_", " ")) + "</td><td>" + esc(k.points) + " / " + esc(k.max) + "</td><td>" + esc(k.detail) + "</td></tr>";
          }).join("");
          var pct = Math.round((a.total / a.max) * 100);
          var verdict = a.acceptable
            ? "<strong class='ok'>" + esc(okPre) + esc(a.total) + "/36 (" + esc(pct) + "%) ≥ " + esc(okTh) + esc(a.threshold) + "</strong>"
            : "<strong class='warn'>" + esc(warnPre) + esc(a.total) + "/36 (" + esc(pct) + "%) &lt; " + esc(a.threshold) + "</strong>";
          var m = d.manglik;
          var manglikRows =
            "<div class='row'><span class='k'>" + esc(rowBoyManglik) + "</span><span class='v'>" + (m.boy.is_manglik ? esc(yes) : esc(no)) + (m.boy.cancelled ? esc(cancelPre) + esc(m.boy.cancellation_reason) + ")" : "") + "</span></div>" +
            "<div class='row'><span class='k'>" + esc(rowGirlManglik) + "</span><span class='v'>" + (m.girl.is_manglik ? esc(yes) : esc(no)) + (m.girl.cancelled ? esc(cancelPre) + esc(m.girl.cancellation_reason) + ")" : "") + "</span></div>" +
            "<div class='row'><span class='k'>" + esc(rowReading) + "</span><span class='v'>" + esc(m.note) + "</span></div>" +
            "<div class='row'><span class='k'>" + esc(rowBoyProfile) + "</span><span class='v'>" + esc(moonLbl) + esc(a.boy.moon_sign) + " · " + esc(a.boy.moon_nakshatra) + esc(padaLbl) + esc(a.boy.moon_pada) + "</span></div>" +
            "<div class='row'><span class='k'>" + esc(rowGirlProfile) + "</span><span class='v'>" + esc(moonLbl) + esc(a.girl.moon_sign) + " · " + esc(a.girl.moon_nakshatra) + esc(padaLbl) + esc(a.girl.moon_pada) + "</span></div>";
          box.innerHTML =
            "<div class='verdict'>" + verdict + "</div>" +
            "<table><thead><tr><th>" + esc(thKoota) + "</th><th>" + esc(thPoints) + "</th><th>" + esc(thDetail) + "</th></tr></thead><tbody>" + rows + "</tbody></table>" +
            "<h3>" + esc(manglikH3) + "</h3>" + manglikRows +
            "<p class='flagline'>" + esc(flagline) + "</p>";
          // consent-gated analytics; no-op unless GA4 is loaded
          if (window.vyTrack) window.vyTrack("calculator_used", { tool: "match" });
        })
        .catch(function () {
          box.innerHTML = "<p class='hint err'>" + esc(errBackend) + "</p>";
        });
    });
  })();
</script>

<script>
  // S18 — shared validation gate: 2 dates + 2 times (now required) + 2
  // required places are all markup-driven; no text rules here.
  import { installFormValidation } from "../scripts/form-validation";
  const mForm = document.getElementById("match-form") as HTMLFormElement | null;
  if (mForm) installFormValidation(mForm);
</script>

<style>
  .mx { max-width: 900px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(26px, 5vw, 36px); }
  .lede { color: var(--text-muted); font-size: 14.5px; margin-top: var(--space-2); max-width: 700px; }
  .panel { margin-top: var(--space-5); background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-5); }
  fieldset.person { border: 1px solid var(--color-border); border-radius: 10px; padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  fieldset.person legend { color: var(--gold); font-family: var(--font-display); font-weight: 600; padding: 0 var(--space-2); font-size: 15px; }
  .result { margin-top: var(--space-5); background: var(--bg-raised); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); padding: var(--space-5); min-height: 80px; }
  .hint { color: var(--text-dim); font-size: 13.5px; }
  .hint.err { color: #e0806d; }
  .verdict { font-size: 16px; color: var(--ivory); margin-bottom: var(--space-4); }
  .ok { color: #7fce9d; }
  .warn { color: #e0a06d; }
  /* block + overflow-x: the 36-guna result table scrolls inside the card on
     narrow phones instead of pushing the page wide (UX audit F2) */
  table { display: block; width: 100%; border-collapse: collapse; font-size: 13.5px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  th { text-align: left; color: var(--gold); font-weight: 600; padding: 6px 8px; border-bottom: 1px solid var(--color-border-strong); }
  td { padding: 6px 8px; border-bottom: 1px solid var(--color-border); color: var(--text-muted); vertical-align: top; }
  td:first-child, td:nth-child(2) { color: var(--ivory); white-space: nowrap; }
  .result h3 { color: var(--gold); font-family: var(--font-display); font-size: 15px; margin: var(--space-5) 0 var(--space-2); }
  .row { display: grid; grid-template-columns: 160px 1fr; gap: var(--space-3); padding: 5px 0; border-bottom: 1px solid var(--color-border); }
  /* narrow phones: stack label above value (UX audit F8) */
  @media (max-width: 480px) {
    .row { grid-template-columns: 1fr; gap: 2px; }
  }
  .k { color: var(--text-dim); font-size: 13px; }
  .v { color: var(--ivory); font-size: 13.5px; }
  .flagline { margin-top: var(--space-4); font-size: 12px; color: var(--text-dim); }
  .fine { margin-top: var(--space-4); font-size: 12.5px; color: var(--text-faint); line-height: 1.6; }
</style>
