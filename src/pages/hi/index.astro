---
import ExploreTiles from "../../components/ExploreTiles.astro";
import TodayAtAGlance from "../../components/TodayAtAGlance.astro";
/** Hindi home skeleton (PRD §9/§11): structure proof for the /hi/ prefix +
 * hreflang pair. Full Hindi translation lands per-epic with the EN pages. */
import Base from "../../layouts/Base.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "https://astro-backend.vyotish.workers.dev";
---

<Base
  title="व्योतिष — प्रामाणिक वैदिक ज्योतिष"
  description="मुफ्त कुंडली, दैनिक पंचांग, मुहूर्त मार्गदर्शन और प्रामाणिक वैदिक ज्योतिष परामर्श।"
  lang="hi"
  langPath="/"
>
  <section class="hero">
    <div class="hero-inner">
      <div class="om" aria-hidden="true">ॐ</div>
      <h1>वैदिक ज्ञान, <span class="gold">आधुनिक जीवन के लिए</span></h1>
      <p class="hero-sub">
        मुफ्त कुंडली, आपके शहर का आज का पंचांग, मुहूर्त विंडो और गणना यंत्र —
        फिर जब तैयार हों, अनुभवी ज्योतिषी से परामर्श।
      </p>
      <div class="hero-actions">
        <a class="primary" href="/hi/">मुफ्त कुंडली</a>
        <a class="secondary" href="#glance-h">आज का पंचांग</a>
        <a class="secondary" href="/consultations">ज्योतिषी से बात करें</a>
      </div>
      <p class="en-note">
        Hindi build is in progress — English pages are complete today.
        <a href="/">Switch to English</a>
      </p>
    </div>
  </section>

  <TodayAtAGlance apiBase={apiBase} />
  <ExploreTiles />

  <style>
    .hero {
      background: var(--color-bg);
      padding: var(--space-8) var(--space-4) var(--space-6);
      text-align: center;
    }
    .hero-inner { max-width: 760px; margin: 0 auto; }
    .om { font-size: 40px; color: var(--gold); /* glow removed — calm palette */ margin-bottom: var(--space-3); }
    h1 {
      font-family: "Noto Sans Devanagari", var(--font-body);
      font-size: clamp(28px, 5.4vw, 42px);
      font-weight: 600;
      color: var(--text-primary);
      line-height: 1.3;
    }
    .gold { color: var(--gold); }
    .hero-sub { color: var(--text-muted); font-size: 15px; line-height: 1.8; margin: var(--space-4) auto 0; max-width: 560px; }
    .hero-actions { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; margin-top: var(--space-6); }
    .hero-actions a {
      min-height: var(--target-min);
      display: inline-flex; align-items: center;
      padding: 0 var(--space-5);
      border-radius: var(--radius-pill);
      text-decoration: none; font-size: 14px; font-weight: 500;
    }
    .primary { background: var(--color-accent); color: var(--ink-on-gold); }
    .secondary { background: var(--color-surface); border: 1px solid var(--color-primary); color: var(--color-primary); }
    .en-note { color: var(--text-faint); font-size: 13px; margin-top: var(--space-5); }
    .en-note a { color: var(--gold); }
  </style>
</Base>
