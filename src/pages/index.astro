---
import ExploreTiles from "../components/ExploreTiles.astro";
import QuickKundli from "../components/QuickKundli.astro";
import TodayAtAGlance from "../components/TodayAtAGlance.astro";
/**
 * Home page (Epic 2.2, PRD §6 order): hero → today at a glance → explore →
 * quick Kundli → trust → FAQ → (sample-marked) community teasers.
 * Sections requiring DB content (astrologers, poojas, blog) render honest
 * sample/empty states until their epics land — never fabricated (PRD §15).
 */
import Base from "../layouts/Base.astro";

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? "https://astro-backend.vyotish.workers.dev";

const faqs = [
  {
    q: "Is the Kundli free? Do I need to sign up?",
    a: "Yes, free and without signup. Enter your birth details and the chart is computed instantly. We never store your birth data.",
  },
  {
    q: "How are the Panchang values calculated?",
    a: "Our engine computes planetary positions with published astronomical methods, Lahiri ayanamsha, and full IANA timezone handling. The Vedic day runs sunrise to sunrise.",
  },
  {
    q: "Are the predictions real?",
    a: "Astrology is guidance, not certainty. We make no guaranteed-outcome claims, and we never ask for OTPs or passwords.",
  },
  {
    q: "Is my personal data safe?",
    a: "We collect only what a request needs, state its purpose plainly, and delete on request (DPDP Act 2023). Details on the Privacy Policy page.",
  },
];

const trustPoints = [
  "Calculations validated against known Panchang values and published almanacs.",
  "City-level accuracy with exact coordinates and IANA timezones.",
  "Clearly-marked sample content — we never fabricate reviews or numbers.",
  "Privacy-first: minimal collection, clear consent, deletion on request.",
];
---

<Base
  title="Vyotish — Authentic Vedic Astrology"
  description="Free Kundli, daily Panchang, muhurat guidance and authentic Vedic astrology consultations. No signup, no stored birth data."
  langPath="/"
>
  <section class="hero">
    <div class="hero-inner">
      <div class="om" aria-hidden="true">ॐ</div>
      <h1>Vedic wisdom, <span class="gold">made useful</span> for modern life.</h1>
      <p class="hero-sub">
        Free Kundli, live Panchang for your city, muhurat windows and calculators —
        then talk to an experienced astrologer when you are ready.
      </p>
      <div class="hero-actions">
        <a class="primary" href="#quick-kundli">Free Kundli</a>
        <a class="secondary" href="#glance-h">Today's Panchang</a>
        <a class="secondary" href="/consultations">Talk to an Astrologer</a>
      </div>
    </div>
  </section>

  <TodayAtAGlance apiBase={apiBase} />
  <ExploreTiles />

  <section id="quick-kundli" aria-label="Quick Kundli">
    <QuickKundli apiBase={apiBase} />
  </section>

  <section class="trust" aria-labelledby="trust-h">
    <div class="trust-inner">
      <h2 id="trust-h">Why Vyotish</h2>
      <ul>
        {trustPoints.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="community" aria-labelledby="community-h">
    <div class="community-inner">
      <h2 id="community-h">Coming with the next milestones</h2>
      <div class="cards">
        <div class="card">
          <h3>Astrologers</h3>
          <p>Directory with expertise, languages and availability. <em>Sample profiles land with Epic 5 — clearly marked, never presented as real.</em></p>
        </div>
        <div class="card">
          <h3>Festivals &amp; Muhurat</h3>
          <p>Festival calendar and an event-wise muhurat finder. <em>Rules are data — a qualified Jyotishi reviews them before launch.</em></p>
        </div>
        <div class="card">
          <h3>Blog</h3>
          <p>Original astro-education articles. <em>Editorial desk arrives with Epic 6.</em></p>
        </div>
      </div>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-h">
    <div class="faq-inner">
      <h2 id="faq-h">Frequently asked</h2>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <style>
    .hero {
      background: var(--color-bg);
      padding: var(--space-8) var(--space-4) var(--space-6);
      text-align: center;
    }
    .hero-inner { max-width: 760px; margin: 0 auto; }
    .om { font-size: 40px; color: var(--gold); /* glow removed — calm palette */ margin-bottom: var(--space-3); }
    h1 {
      font-family: var(--font-display);
      font-size: clamp(30px, 5.4vw, 46px);
      font-weight: 600;
      color: var(--text-primary);
      line-height: 1.2;
    }
    .gold { color: var(--color-accent-text); font-style: italic; }
    .hero-sub { color: var(--text-muted); font-size: 15px; line-height: 1.7; margin: var(--space-4) auto 0; max-width: 560px; }
    .hero-actions { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; margin-top: var(--space-6); }
    .hero-actions a {
      min-height: var(--target-min);
      display: inline-flex;
      align-items: center;
      padding: 0 var(--space-5);
      border-radius: var(--radius-pill);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
    }
    .primary {
      background: var(--color-accent);
      color: var(--ink-on-gold);
    }
    .secondary {
      background: var(--color-surface);
      border: 1px solid var(--color-primary);
      color: var(--color-primary);
    }
    .trust, .community, .faq { max-width: 1100px; margin: 0 auto var(--space-8); padding: 0 var(--space-4); }
    .trust-inner, .community-inner, .faq-inner {
      background: var(--bg-raised);
      border: 1px solid var(--border-faint);
      border-radius: var(--radius-card);
      padding: var(--space-6);
    }
    h2 { font-family: var(--font-display); color: var(--ivory); font-size: 26px; margin-bottom: var(--space-4); font-weight: 600; }
    .trust ul { list-style: none; display: grid; gap: var(--space-3); }
    .trust li { color: var(--text-body); font-size: 14.5px; padding-left: var(--space-5); position: relative; }
    .trust li::before { content: "✦"; position: absolute; left: 0; color: var(--color-accent-text); }
    .cards { display: grid; gap: var(--space-4); grid-template-columns: 1fr; }
    .card { border: 1px dashed var(--border-faint); border-radius: var(--radius-card); padding: var(--space-4); }
    .card h3 { color: var(--ivory); font-family: var(--font-display); font-size: 18px; margin-bottom: var(--space-2); }
    .card p { color: var(--text-dim); font-size: 13.5px; line-height: 1.6; }
    .card em { color: var(--text-faint); }
    details { border-bottom: 1px solid var(--border-faint); padding: var(--space-3) 0; }
    summary {
      min-height: var(--target-min);
      display: flex;
      align-items: center;
      cursor: pointer;
      color: var(--text-body);
      font-size: 15px;
      font-weight: 500;
    }
    details p { color: var(--text-muted); font-size: 14px; line-height: 1.7; padding: var(--space-2) 0; }
    @media (min-width: 768px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  </style>
</Base>
