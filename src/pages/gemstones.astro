---
/**
 * Gemstones (PRD §5.8) — wired to the GEMSTONES_SITE_URL site setting via
 * GET /api/v1/settings (Epic 5.4). While the setting is empty this page
 * renders; once the owner sets it, the page links straight out to the store.
 * S24: the /hi twin renders this same body via the page path.
 */
import Base from "../layouts/Base.astro";
import { fetchSettings } from "../lib/content";
import { langFromPath, withLang } from "../lib/i18n";
import { GEMSTONES } from "../lib/i18n/hubs";

const lang = langFromPath(Astro.url.pathname);
const hi = lang === "hi";
const t = GEMSTONES[lang];

const settings = await fetchSettings();
const storeUrl = settings?.gemstones_site_url ?? null;
---

<Base
  title={storeUrl ? t.titleLive : t.titleSoon}
  description={t.description}
  lockDark
>
  <section class="gem">
    <div class="om" aria-hidden="true">💎</div>
    {storeUrl ? (
      <>
        <h1 class={hi ? "hi-text" : ""}>{t.h1Live}</h1>
        <p class={hi ? "hi-text" : ""}>
          {t.pLive}
        </p>
        <a class="cta" href={storeUrl} rel="noopener noreferrer">{t.ctaLive}</a>
      </>
    ) : (
      <>
        <h1 class={hi ? "hi-text" : ""}>{t.h1Soon}</h1>
        <p class={hi ? "hi-text" : ""}>
          {t.pSoon}
        </p>
        <a class="back" href={withLang("/", Astro.url.pathname)}>{t.backHome}</a>
      </>
    )}
  </section>
</Base>

<style>
  .gem {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-6);
    background: var(--color-bg);
  }
  .om { font-size: 48px; }
  h1 {
    font-family: var(--font-display);
    color: var(--ivory);
    font-size: clamp(32px, 6vw, 52px);
    margin-top: var(--space-4);
  }
  p { color: var(--text-muted); max-width: 460px; line-height: 1.7; margin-top: var(--space-4); font-size: 15px; }
  .cta {
    margin-top: var(--space-6);
    color: #17201e;
    background: var(--gold);
    border-radius: 10px;
    padding: 10px 22px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
  }
  .back { margin-top: var(--space-6); color: var(--gold); text-decoration: none; min-height: var(--target-min); line-height: var(--target-min); }
</style>
