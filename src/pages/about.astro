---
/**
 * About — Epic 7.3 final draft.
 * Trust elements follow the pattern of leading astrology-brand About pages
 * (mission/story, methodology transparency, honest policy statements) but every
 * claim here is repo-verified: astronomy-engine (MIT) + own Lahiri layer per
 * DECISIONS.md D5, IANA timezone db, GeoNames 70k+ city seed (Epic 4.7b),
 * 250+ automated backend tests (Epic 8.1), honest empty states + marked sample
 * data per PRD §15. No invented numbers, no invented credentials.
 * S24: prose lives in the ABOUT dict; the /hi twin renders this same body
 * via the page path with fully translated sections.
 */
import LegalPage from "../components/LegalPage.astro";
import { langFromPath } from "../lib/i18n";
import { ABOUT } from "../lib/i18n/about";

const t = ABOUT[langFromPath(Astro.url.pathname)];
---

<LegalPage
  title={t.title}
  heading={t.heading}
  eyebrow={t.eyebrow}
  intro={t.intro}
  updated={t.updated}
  sections={t.sections}
  note={t.note}
/>
