---
/** /compatibility/ — Zodiac Sign Compatibility hub (Epic ZC S-ZC-3).
 * Entry point: pick two signs → canonical pair page. All scores, verdicts
 * and explanations come from the backend API (D12); this page is structure,
 * navigation and honest framing only.
 * S24: the /hi twin renders this same body via the page path; pair links
 * go through withLang (the dynamic pair twins land with P3). */
import Base from "../../layouts/Base.astro";
import { langFromPath, withLang } from "../../lib/i18n";
import { COMPATIBILITY } from "../../lib/i18n/compatibility";
import { canonicalPairs, ZODIAC_SIGNS } from "../../lib/zodiac-signs";

const lang = langFromPath(Astro.url.pathname);
const hi = lang === "hi";
const t = COMPATIBILITY[lang];

const sameSignPairs = ZODIAC_SIGNS.map((s) => ({
  ...s,
  href: withLang(`/compatibility/${s.slug}/${s.slug}/`, Astro.url.pathname),
}));
const pairCount = canonicalPairs().length;
---

<Base
  title={t.title}
  description={t.description}
>
  <nav class={`zc-crumbs ${hi ? "hi-text" : ""}`} aria-label={hi ? "ब्रेडक्रंब" : "Breadcrumb"}>
    <a href={withLang("/astrology", Astro.url.pathname)}>{t.crumbsRoot}</a> <span aria-hidden="true">/</span>
    <span aria-current="page">{t.crumbsCurrent}</span>
  </nav>

  <section class="zc-hub">
    <header class="zc-hero">
      <p class={`zc-kicker ${hi ? "hi-text" : ""}`}>{t.kicker}</p>
      <h1 class={hi ? "hi-text" : ""}>{t.h1}</h1>
      <p class={`zc-lede ${hi ? "hi-text" : ""}`}>
        {t.lede}
      </p>
    </header>

    <section class="zc-picker" aria-label={t.pickerAria}>
      <form data-zc-picker>
        <div class="zc-fields">
          <label class={hi ? "hi-text" : ""}>
            <span>{t.yourSign}</span>
            <select name="sign1" required>
              <option value="" selected disabled>{t.chooseYour}</option>
              {ZODIAC_SIGNS.map((s) => (
                <option value={s.slug}>{hi ? s.hi : s.en} · {s.hi}</option>
              ))}
            </select>
          </label>
          <button type="button" class="zc-swap" data-zc-swap aria-label={t.swapAria}>⇄</button>
          <label class={hi ? "hi-text" : ""}>
            <span>{t.partnerSign}</span>
            <select name="sign2" required>
              <option value="" selected disabled>{t.chooseTheir}</option>
              {ZODIAC_SIGNS.map((s) => (
                <option value={s.slug}>{hi ? s.hi : s.en} · {s.hi}</option>
              ))}
            </select>
          </label>
        </div>
        <button type="submit" class={`zc-check ${hi ? "hi-text" : ""}`} disabled>{t.check}</button>
        <p class={`zc-hint ${hi ? "hi-text" : ""}`}>{t.hint}</p>
      </form>
    </section>

    <section class="zc-how" aria-label={t.howAria}>
      <h2 class={hi ? "hi-text" : ""}>{t.howH}</h2>
      <ol>
        {t.steps.map((step) => (
          <li class={hi ? "hi-text" : ""}>
            <h3>{step.h3}</h3>
            <p>{step.p}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="zc-grid-wrap" aria-label={t.gridAria}>
      <h2 class={hi ? "hi-text" : ""}>{t.gridPre}{pairCount}{t.gridSuf}</h2>
      <div class="zc-grid">
        {sameSignPairs.map((s) => (
          <a class={`zc-sign-card ${hi ? "hi-text" : ""}`} href={s.href}>
            <span class="zc-symbol" aria-hidden="true">{s.symbol}</span>
            <span class="zc-name">{hi ? s.hi : s.en}</span>
            <span class="zc-hi">{hi ? s.en : s.hi}</span>
          </a>
        ))}
      </div>
      <p class={`zc-grid-note ${hi ? "hi-text" : ""}`}>
        {t.gridNote}
      </p>
    </section>

    <section class="zc-strip" aria-label={t.stripAria}>
      <p class={hi ? "hi-text" : ""}>
        {t.strip}
      </p>
    </section>

    <section class="zc-vedic" aria-label={t.vedicAria}>
      <div class="zc-vedic-copy">
        <h2 class={hi ? "hi-text" : ""}>{t.vedicH}</h2>
        <p class={hi ? "hi-text" : ""}>{t.vedicP}</p>
      </div>
      <a class={`zc-vedic-btn ${hi ? "hi-text" : ""}`} href={withLang("/matching", Astro.url.pathname)}>{t.vedicBtn}</a>
    </section>
  </section>
</Base>

<script>
  import { canonicalPairSlug } from "../../lib/zodiac-signs";

  document.querySelector<HTMLButtonElement>("[data-zc-swap]")?.addEventListener("click", () => {
    const f = document.querySelector<HTMLFormElement>("[data-zc-picker]");
    if (!f) return;
    const a = f.querySelector<HTMLSelectElement>("select[name='sign1']");
    const b = f.querySelector<HTMLSelectElement>("select[name='sign2']");
    if (a && b) {
      const tmp = a.value;
      a.value = b.value;
      b.value = tmp;
    }
  });

  document.querySelector<HTMLFormElement>("[data-zc-picker]")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const f = e.currentTarget as HTMLFormElement;
    const s1 = f.querySelector<HTMLSelectElement>("select[name='sign1']")?.value ?? "";
    const s2 = f.querySelector<HTMLSelectElement>("select[name='sign2']")?.value ?? "";
    if (!s1 || !s2) return;
    const key = canonicalPairSlug(s1, s2);
    if (!key) return; // fail closed — never navigate on a non-canonical pair
    const [a, b] = key.split("-");
    // S24: keep the visitor's language — the dynamic pair pages have /hi twins
    const prefix = document.documentElement.lang === "hi" ? "/hi" : "";
    window.location.assign(`${prefix}/compatibility/${a}/${b}/`);
  });

  // Button stays disabled until both signs are chosen (design spec §1.3).
  const picker = document.querySelector<HTMLFormElement>("[data-zc-picker]");
  const sel1 = picker?.querySelector<HTMLSelectElement>("select[name='sign1']");
  const sel2 = picker?.querySelector<HTMLSelectElement>("select[name='sign2']");
  const checkBtn = picker?.querySelector<HTMLButtonElement>("button[type='submit']");
  const syncCheck = () => {
    if (checkBtn) checkBtn.disabled = !(sel1?.value && sel2?.value);
  };
  sel1?.addEventListener("change", syncCheck);
  sel2?.addEventListener("change", syncCheck);
  syncCheck();
</script>

<style>
  .zc-crumbs {
    max-width: 900px; margin: 0 auto; padding: var(--space-4) var(--space-4) 0;
    font-size: 12.5px; color: var(--text-dim);
  }
  .zc-crumbs a { color: var(--gold); text-decoration: underline; }
  .zc-crumbs a:hover { text-decoration: none; }
  .zc-hub { max-width: 900px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-8); }
  .zc-kicker { color: var(--gold); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
  .zc-hero h1 { font-family: var(--font-display); color: var(--ivory); font-size: clamp(26px, 5vw, 38px); margin-top: var(--space-1); }
  .zc-lede { color: var(--text-muted); margin-top: var(--space-2); font-size: 14.5px; max-width: 680px; }

  .zc-picker {
    margin-top: var(--space-5); background: var(--bg-raised);
    border: 1px solid var(--color-border-strong); border-radius: var(--radius-card);
    padding: var(--space-5);
  }
  .zc-fields { display: flex; gap: var(--space-3); align-items: flex-end; flex-wrap: wrap; }
  .zc-fields label { flex: 1 1 200px; display: flex; flex-direction: column; gap: 6px; }
  .zc-fields label span { color: var(--text-dim); font-size: 12.5px; }
  .zc-fields select {
    min-height: var(--target-min); padding: 0 var(--space-3);
    background: var(--color-tint, var(--bg-page)); border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card); color: var(--ivory); font-size: 14px;
  }
  .zc-fields select:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  @media (max-width: 480px) {
    .zc-fields { flex-direction: column; align-items: stretch; }
    .zc-swap { align-self: center; margin: -6px 0; }
  }
  .zc-swap {
    min-height: var(--target-min); min-width: var(--target-min);
    background: transparent; border: 1px solid var(--color-border-strong); border-radius: var(--radius-card);
    color: var(--gold); font-size: 18px; cursor: pointer;
  }
  .zc-swap:hover { border-color: var(--border-gold-soft); }
  .zc-check {
    margin-top: var(--space-4); min-height: var(--target-min); padding: 0 var(--space-6);
    background: var(--gold); color: var(--color-on-primary); border: none; border-radius: var(--radius-pill);
    font-size: 14px; font-weight: 600; cursor: pointer;
  }
  .zc-check:hover { background: var(--gold-bright); }
  .zc-check:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  .zc-check:disabled { opacity: 0.5; cursor: not-allowed; }
  @media (max-width: 639px) { .zc-check { width: 100%; } }
  .zc-hint { color: var(--text-dim); font-size: 12.5px; margin-top: var(--space-2); }

  .zc-how { margin-top: var(--space-7); }
  .zc-how h2 { color: var(--ivory); font-size: 18px; font-weight: 500; }
  .zc-how ol { display: grid; gap: var(--space-3); margin: var(--space-4) 0 0; padding: 0; list-style: none; counter-reset: step; }
  @media (min-width: 640px) { .zc-how ol { grid-template-columns: repeat(3, 1fr); } }
  .zc-how li { counter-increment: step; background: var(--bg-raised); border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: var(--space-4); }
  .zc-how li::before {
    content: counter(step); display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 999px; background: var(--color-tint, var(--bg-page));
    border: 1px solid var(--border-gold-soft); color: var(--gold); font-size: 13px; font-weight: 600;
  }
  .zc-how h3 { color: var(--ivory); font-size: 14px; font-weight: 500; margin-top: var(--space-2); }
  .zc-how p { color: var(--text-muted); font-size: 13px; line-height: 1.65; margin-top: 6px; }

  .zc-grid-wrap { margin-top: var(--space-7); }
  .zc-grid-wrap h2 { color: var(--ivory); font-size: 18px; font-weight: 500; }
  .zc-grid { display: grid; gap: var(--space-3); margin-top: var(--space-4); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 640px) { .zc-grid { grid-template-columns: repeat(6, 1fr); } }
  .zc-sign-card {
    display: flex; flex-direction: column; align-items: center; gap: 2px; text-align: center;
    background: var(--bg-raised); border: 1px solid var(--color-border); border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-2); text-decoration: none;
  }
  .zc-sign-card:hover { border-color: var(--border-gold-soft); }
  .zc-symbol { color: var(--gold); font-size: 22px; }
  .zc-name { color: var(--ivory); font-size: 13px; font-weight: 500; }
  .zc-hi { color: var(--text-dim); font-size: 12px; }
  .zc-grid-note { color: var(--text-dim); font-size: 12.5px; margin-top: var(--space-3); max-width: 640px; }

  .zc-strip {
    margin-top: var(--space-7); padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border); border-radius: var(--radius-card);
    background: var(--color-tint, var(--bg-raised));
  }
  .zc-strip p { color: var(--text-muted); font-size: 13px; line-height: 1.7; }
  .zc-strip p + p { margin-top: var(--space-2); }
  .zc-strip a { color: var(--gold); }

  .zc-vedic {
    margin-top: var(--space-5); padding: var(--space-4) var(--space-5);
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;
    background: var(--bg-raised); border: 1px solid var(--color-border); border-radius: var(--radius-card);
  }
  .zc-vedic h2 { color: var(--ivory); font-family: var(--font-display); font-size: 16px; font-weight: 600; }
  .zc-vedic-copy p { color: var(--text-muted); font-size: 13px; margin-top: 4px; }
  .zc-vedic-btn {
    display: inline-flex; align-items: center; min-height: var(--target-min); padding: 0 var(--space-5);
    background: transparent; border: 1px solid var(--color-border-strong); border-radius: var(--radius-pill);
    color: var(--gold); font-size: 13.5px; font-weight: 600; text-decoration: none; white-space: nowrap;
  }
  .zc-vedic-btn:hover { background: var(--color-tint, var(--bg-raised)); }
  .zc-vedic-btn:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  @media (max-width: 639px) { .zc-vedic-btn { width: 100%; justify-content: center; } }
</style>
