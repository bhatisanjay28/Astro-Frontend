---
/** Admin chrome (Epic 6.4) — minimal sidebar shell; no public header/footer.
 * The session gate is requireSession() in each page script: the backend
 * (401/403 on every /admin route) is the real security boundary. */
import "../styles/fonts.css";

interface Props {
  title: string;
  active?: string;
}
const { title, active = "" } = Astro.props;
const NAV = [
  { href: "/admin", key: "home", label: "Dashboard" },
  { href: "/admin/posts", key: "posts", label: "Blog posts" },
  { href: "/admin/taxonomy", key: "taxonomy", label: "Categories & tags" },
  { href: "/admin/media", key: "media", label: "Media" },
  { href: "/admin/horoscopes", key: "horoscopes", label: "Horoscope content" },
  { href: "/admin/blocks", key: "blocks", label: "Content blocks" },
  { href: "/admin/legal", key: "legal", label: "Trust & Legal" },
  { href: "/admin/nav", key: "nav", label: "Navigation" },
  { href: "/admin/catalog", key: "catalog", label: "Astrologers & poojas" },
  { href: "/admin/inbox", key: "inbox", label: "Inbox" },
  { href: "/admin/settings", key: "settings", label: "Settings" },
  { href: "/admin/subscribers", key: "subscribers", label: "Subscribers" },
  { href: "/admin/users", key: "users", label: "Users & roles" },
  { href: "/admin/audit", key: "audit", label: "Audit log" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <aside class="side">
      <a class="brand" href="/admin">Vyotish Admin</a>
      <nav aria-label="Admin sections">
        {
          NAV.map((n) => (
            <a class={active === n.key ? "on" : undefined} href={n.href}>
              {n.label}
              {n.key === "inbox" && (
                <span id="inbox-badge" class="nav-badge" hidden aria-label="new inbox items" />
              )}
            </a>
          ))
        }
      </nav>
      <div class="side-foot">
        <span id="admin-email"></span>
        <span id="admin-role" class="role-chip" hidden></span>
        <button type="button" id="admin-logout">Sign out</button>
      </div>
    </aside>
    <main class="main">
      <div id="admin-toast" class="toast" hidden role="status"></div>
      <slot />
    </main>
    <style is:global>
      :root { --a-bg: #14100c; --a-panel: #1d1710; --a-border: #3a2f1f; --a-gold: #d4a843; --a-text: #ece5d8; --a-dim: #9b8f7a; }
      /* DateField token mapping — admin pages don't load tokens.css, so the
         shared picker's token vars resolve to the admin palette here. */
      .main .dt {
        --bg-raised: var(--a-panel);
        --color-border-strong: var(--a-border);
        --text-body: var(--a-text);
        --text-muted: var(--a-dim);
        --text-dim: var(--a-dim);
        --text-faint: var(--a-dim);
        --color-primary: var(--a-gold);
        --color-on-primary: #1a1206;
        --color-accent: var(--a-gold);
        --color-error-text: #e08a8a;
        --radius-card: 8px;
        --space-2: 8px;
        --space-3: 12px;
        --target-min: 44px;
      }
      * { box-sizing: border-box; }
      body { margin: 0; display: flex; min-height: 100vh; background: var(--a-bg); color: var(--a-text); font: 14px/1.55 Poppins, sans-serif; }
      .side { width: 210px; flex: 0 0 210px; background: var(--a-panel); border-right: 1px solid var(--a-border); padding: 20px 14px; display: flex; flex-direction: column; gap: 4px; }
      .brand { color: var(--a-gold); font-weight: 600; text-decoration: none; margin-bottom: 14px; }
      .side nav { display: flex; flex-direction: column; gap: 2px; }
      .side nav a { color: var(--a-dim); text-decoration: none; padding: 8px 10px; border-radius: 8px; }
      .side nav a:hover { color: var(--a-text); background: rgba(212, 168, 67, 0.08); }
      .side nav a.on { color: var(--a-gold); background: rgba(212, 168, 67, 0.12); }
      .nav-badge { margin-left: 7px; background: var(--a-gold); color: #1a1206; border-radius: 999px; font-size: 11px; padding: 0 7px; font-weight: 600; }
      .nav-badge[hidden] { display: none; }
      .side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--a-dim); word-break: break-all; }
      .role-chip { align-self: flex-start; font-size: 11px; color: var(--a-gold); border: 1px solid var(--a-border); background: rgba(212, 168, 67, 0.08); border-radius: 999px; padding: 2px 10px; text-transform: capitalize; }
      #admin-logout { background: none; border: 1px solid var(--a-border); color: var(--a-dim); border-radius: 8px; padding: 6px; cursor: pointer; }
      #admin-logout:hover { color: var(--a-text); border-color: var(--a-gold); }
      .main { flex: 1; padding: 24px 28px; min-width: 0; }
      h1 { font-size: 20px; margin: 0 0 16px; color: var(--a-gold); font-weight: 600; }
      h2 { font-size: 15px; color: var(--a-text); margin: 22px 0 10px; }
      table { width: 100%; border-collapse: collapse; background: var(--a-panel); border: 1px solid var(--a-border); border-radius: 10px; overflow: hidden; }
      th { text-align: left; font-size: 12px; color: var(--a-dim); padding: 9px 10px; border-bottom: 1px solid var(--a-border); }
      td { padding: 9px 10px; border-bottom: 1px solid rgba(58, 47, 31, 0.55); font-size: 13px; vertical-align: top; }
      tr:last-child td { border-bottom: 0; }
      td.empty { color: var(--a-dim); text-align: center; padding: 22px; }
      .btn { background: var(--a-gold); color: #1a1206; border: 0; border-radius: 8px; padding: 8px 14px; font-weight: 600; cursor: pointer; font-size: 13px; }
      .btn.ghost { background: none; border: 1px solid var(--a-border); color: var(--a-dim); font-weight: 400; }
      .btn.ghost:hover { border-color: var(--a-gold); color: var(--a-gold); }
      .btn.danger { background: none; border: 1px solid #7a2f2f; color: #e08a8a; font-weight: 400; }
      input, select, textarea { background: #241c13; border: 1px solid var(--a-border); color: var(--a-text); border-radius: 8px; padding: 8px 10px; font: inherit; width: 100%; }
      textarea { min-height: 110px; resize: vertical; }
      label { display: block; font-size: 12px; color: var(--a-dim); margin: 12px 0 4px; }
      .toast { position: fixed; right: 20px; top: 20px; background: #2b2416; border: 1px solid var(--a-gold); color: var(--a-text); padding: 10px 16px; border-radius: 10px; font-size: 13px; z-index: 50; }
      .toast.bad { border-color: #a33; }
      .row-actions { display: flex; gap: 6px; flex-wrap: wrap; }
      .card { background: var(--a-panel); border: 1px solid var(--a-border); border-radius: 10px; padding: 16px; }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      @media (max-width: 800px) { body { flex-direction: column; } .side { width: 100%; flex: none; } .grid2 { grid-template-columns: 1fr; } }
      .pill { font-size: 11px; border: 1px solid var(--a-border); border-radius: 999px; padding: 2px 9px; color: var(--a-dim); }
      .pill.pub { color: #8fc98f; border-color: #2f5a2f; }
      .pill.dr { color: var(--a-gold); border-color: var(--a-border); }
      .pill.arch { color: #c98fc9; border-color: #5a2f5a; }
      .pill.trash { color: #e08a8a; border-color: #7a2f2f; }
      /* toolbar / filter rows (posts, media, taxonomy) */
      .toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 14px 0; }
      .toolbar input, .toolbar select { width: auto; min-width: 0; }
      .tabs { display: flex; gap: 6px; margin: 0 0 6px; }
      .tabs button { background: none; border: 1px solid var(--a-border); color: var(--a-dim); border-radius: 999px; padding: 5px 14px; cursor: pointer; font: inherit; font-size: 12px; }
      .tabs button.on { color: var(--a-gold); border-color: var(--a-gold); background: rgba(212, 168, 67, 0.08); }
      .chk { width: auto; }
      /* bulk action bar (posts) */
      .bulkbar { position: sticky; top: 10px; z-index: 5; display: flex; gap: 10px; align-items: center; background: var(--a-panel); border: 1px solid var(--a-gold); border-radius: 10px; padding: 9px 14px; margin: 0 0 12px; font-size: 13px; }
      .bulkbar[hidden] { display: none; }
      .bulkbar .count { color: var(--a-gold); font-weight: 600; }
      .pager { display: flex; gap: 12px; align-items: center; margin-top: 14px; font-size: 13px; color: var(--a-dim); }
      .badge { font-size: 11px; border: 1px solid var(--a-border); border-radius: 999px; padding: 1px 8px; color: var(--a-dim); white-space: nowrap; }
      .badge.used { color: var(--a-gold); }
      /* shared confirm dialog (scripts/admin/confirm.ts) */
      #confirm-dlg { background: var(--a-panel); border: 1px solid var(--a-border); border-radius: 14px; padding: 22px; max-width: 460px; width: 92vw; color: var(--a-text); }
      #confirm-dlg::backdrop { background: rgba(0, 0, 0, 0.6); }
      .dlg-title { margin: 0 0 8px; color: var(--a-gold); font-size: 15px; }
      .dlg-msg { margin: 0 0 12px; font-size: 13px; }
      .dlg-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 16px; }
      .dlg-ok.danger { background: #7a2f2f; color: #f2d7d7; }
      /* editor extras (posts/edit) */
      .md-toolbar { display: flex; gap: 4px; flex-wrap: wrap; margin: 0 0 6px; }
      .md-toolbar button { background: none; border: 1px solid var(--a-border); color: var(--a-dim); border-radius: 6px; padding: 3px 9px; cursor: pointer; font: inherit; font-size: 12px; }
      .md-toolbar button:hover { color: var(--a-gold); border-color: var(--a-gold); }
      .autosave { font-size: 12px; color: var(--a-dim); }
      .autosave.err { color: #e08a8a; }
      .pick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; max-height: 55vh; overflow: auto; }
      .pick-item { background: #241c13; border: 1px solid var(--a-border); border-radius: 8px; padding: 8px; cursor: pointer; text-align: center; }
      .pick-item:hover { border-color: var(--a-gold); }
      .pick-item img { width: 100%; height: 80px; object-fit: cover; border-radius: 6px; }
      .pick-item .pick-path { display: block; margin-top: 6px; font-size: 10px; color: var(--a-dim); word-break: break-all; }
      .thumb { width: 56px; height: 40px; object-fit: cover; border-radius: 6px; border: 1px solid var(--a-border); display: block; }
      .sub { display: block; font-size: 11px; color: var(--a-dim); }
    </style>
  </body>
</html>
