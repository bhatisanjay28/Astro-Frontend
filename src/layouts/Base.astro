---
/**
 * Base HTML shell — Epic 2.1/2.4.
 * Theme: no-flash inline script (localStorage → prefers-color-scheme).
 * i18n: hreflang alternates when `langPath` provided (PRD §11).
 * Fonts: hotlinked for Coming-Soon parity — self-host before launch (P3).
 */
import "../styles/tokens.css";
import "../styles/tailwind.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import UtilityBar from "../components/UtilityBar.astro";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "hi";
  /** e.g. "/" → hreflang pair / ↔ /hi/ */
  langPath?: string;
  /** lock the night-sky look (Coming-Soon page) */
  lockDark?: boolean;
  /** render header/footer chrome (off for the pixel-parity Coming-Soon page) */
  chrome?: boolean;
  /** explicit canonical override (blog articles honour admin-set URLs) */
  canonical?: string;
  /** Open Graph image (absolute URL) for social shares */
  ogImage?: string;
  /** Open Graph type — "article" on blog posts */
  ogType?: string;
  /** JSON-LD blocks (structured data, Epic 7.1) */
  jsonLd?: Array<Record<string, unknown>>;
}

const {
  title,
  description,
  lang = "en",
  langPath,
  lockDark = false,
  chrome = true,
  canonical,
  ogImage,
  ogType = "website",
  jsonLd = [],
} = Astro.props;
const canonicalUrl = canonical ?? `https://vyotish.com${Astro.url.pathname}`;
const themeLock = lockDark ? "dark" : null;
---

<!doctype html>
<html lang={lang} data-theme={themeLock}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Vyotish" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Vyotish Blog" href="/blog/rss.xml" />
    <title>{title}</title>
    {jsonLd.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : jsonLd)} />
    )}
    {
      langPath && (
        <link rel="alternate" hreflang="en" href={`https://vyotish.com${langPath}`} />
      )
    }
    {
      langPath && (
        <link rel="alternate" hreflang="hi" href={`https://vyotish.com/hi${langPath}`} />
      )
    }
    {
      langPath && (
        <link rel="alternate" hreflang="x-default" href={`https://vyotish.com${langPath}`} />
      )
    }
    <script is:inline>
      // No-flash theme bootstrap: follows the SYSTEM setting by default,
      // remembers an explicit user choice (localStorage "vyotish-theme").
      // Sets BOTH the .dark class (Tailwind dark: variant) and data-theme
      // (legacy tokens.css overrides) so both styling systems agree.
      (function () {
        var root = document.documentElement;
        var locked = root.getAttribute("data-theme") === "dark";
        if (locked) {
          root.classList.add("dark");
          return;
        }
        var theme = "light";
        try {
          var saved = localStorage.getItem("vyotish-theme");
          theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        } catch (e) {
          theme = "light";
        }
        if (theme === "dark") {
          root.setAttribute("data-theme", "dark");
          root.classList.add("dark");
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Poppins:wght@400;500;600&family=JetBrains+Mono:wght@500&family=Noto+Sans+Devanagari:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {chrome && <UtilityBar lang={lang} />}
    {
      chrome && <Header currentPath={Astro.url.pathname} />
    }
    <main id="main-content">
      <slot />
    </main>
    {chrome && <Footer />}

    <!-- 2.3b consent-banner stub: no analytics load yet — the banner honestly
         states that and remembers acceptance in localStorage. Epic 7 swaps the
         stub for the real CMP without changing this markup contract. -->
    {
      chrome && (
        <div class="consent-stub" data-consent-stub hidden role="region" aria-label="Cookie notice">
          <span>
            Vyotish does not load analytics or tracking yet. When that changes we will
            ask here before anything non-essential runs.
          </span>
          <button type="button" data-consent-ok>Got it</button>
        </div>
      )
    }
    {
      chrome && (
        <script is:inline>
          (function () {
            var el = document.querySelector("[data-consent-stub]");
            if (!el) return;
            try {
              if (!localStorage.getItem("vyotish.consent.v1")) el.removeAttribute("hidden");
            } catch (e) {
              /* storage blocked: show the banner (safe default) */
              el.removeAttribute("hidden");
            }
            var btn = el.querySelector("[data-consent-ok]");
            if (btn)
              btn.addEventListener("click", function () {
                try {
                  localStorage.setItem("vyotish.consent.v1", "acknowledged");
                } catch (e) {}
                el.setAttribute("hidden", "");
              });
          })();
        </script>
      )
    }
    {chrome && <script>import "../scripts/site-enhancements";</script>}
    <!-- global styles live in src/styles/base.css (layer order: theme → base → utilities) -->
  </body>
</html>
