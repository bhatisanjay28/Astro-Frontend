---
/**
 * Base HTML shell — Epic 2.1/2.4.
 * Theme: no-flash inline script (localStorage → prefers-color-scheme).
 * i18n (S24): the site is bilingual under the /hi prefix — every public page
 * computes its counterpart + hreflang alternates from its own pathname
 * (lib/i18n.ts). Blog deep routes have no /hi twin (articles keep their
 * original language) and emit no cross-language alternates. Chrome strings
 * come from lib/i18n/chrome.ts by page language.
 * Fonts: self-hosted (S1/P3) incl. Noto Sans Devanagari.
 */
import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/tailwind.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import UtilityBar from "../components/UtilityBar.astro";
import { hasHiTwin, hiPathOf, langFromPath, switcherHrefs } from "../lib/i18n";
import { BASE_CHROME } from "../lib/i18n/chrome";

interface Props {
  title: string;
  description: string;
  /** lock the night-sky look (Coming-Soon page) */
  lockDark?: boolean;
  /** render header/footer chrome (off for the pixel-parity Coming-Soon page) */
  chrome?: boolean;
  /** explicit canonical override (blog articles honour admin-set URLs) */
  canonical?: string;
  /** Open Graph image (absolute URL) for social shares */
  ogImage?: string;
  /** Open Graph type — "article" on blog posts */
  ogType?: string;
  /** JSON-LD blocks (structured data, Epic 7.1) */
  jsonLd?: Array<Record<string, unknown>>;
}

const {
  title,
  description,
  lockDark = false,
  chrome = true,
  canonical,
  ogImage,
  ogType = "website",
  jsonLd = [],
} = Astro.props;
const canonicalUrl = canonical ?? `https://vyotish.com${Astro.url.pathname}`;
const themeLock = lockDark ? "dark" : null;

// Language-switcher hrefs + hreflang alternates (S24): computed from the page
// path itself — /hi twins exist site-wide, so the counterpart is mechanical.
// Deep blog routes (no twin) emit no cross-language alternates.
const pageLang = langFromPath(Astro.url.pathname);
const chromeT = BASE_CHROME[pageLang];
const sw = switcherHrefs(Astro.url.pathname);
const enAlt = pageLang === "hi" ? sw.en : Astro.url.pathname;
const hiAlt = pageLang === "hi" ? Astro.url.pathname : hiPathOf(Astro.url.pathname);
const showAlternates = hasHiTwin(enAlt);
---

<!doctype html>
<html lang={pageLang} data-theme={themeLock}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Vyotish" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Vyotish Blog" href="/blog/rss.xml" />
    <title>{title}</title>
    {jsonLd.length > 0 && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd.length === 1 ? jsonLd[0] : jsonLd)} />
    )}
    {
      showAlternates && (
        <link rel="alternate" hreflang="en" href={`https://vyotish.com${enAlt}`} />
      )
    }
    {
      showAlternates && (
        <link rel="alternate" hreflang="hi" href={`https://vyotish.com${hiAlt}`} />
      )
    }
    {
      showAlternates && (
        <link rel="alternate" hreflang="x-default" href={`https://vyotish.com${enAlt}`} />
      )
    }
    <script is:inline src="/turnstile.js" defer></script>
    <script is:inline>
      // No-flash theme bootstrap: follows the SYSTEM setting by default,
      // remembers an explicit user choice (localStorage "vyotish-theme").
      // Sets BOTH the .dark class (Tailwind dark: variant) and data-theme
      // (legacy tokens.css overrides) so both styling systems agree.
      (function () {
        var root = document.documentElement;
        var locked = root.getAttribute("data-theme") === "dark";
        if (locked) {
          root.classList.add("dark");
          return;
        }
        var theme = "light";
        try {
          var saved = localStorage.getItem("vyotish-theme");
          theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        } catch (e) {
          theme = "light";
        }
        if (theme === "dark") {
          root.setAttribute("data-theme", "dark");
          root.classList.add("dark");
        }
      })();
    </script>
    <!-- Fonts are self-hosted: @font-face set in styles/fonts.css,
         woff2 in /public/fonts/ — zero third-party font requests. -->
  </head>
  <body>
    <a class="skip-link" href="#main-content">{chromeT.skip}</a>
    {chrome && <UtilityBar lang={pageLang} enHref={sw.en} hiHref={sw.hi} />}
    {
      chrome && <Header currentPath={Astro.url.pathname} lang={pageLang} />
    }
    <main id="main-content">
      <slot />
    </main>
    {chrome && <Footer lang={pageLang} />}

    <!-- Cookie notice: analytics stay off until the visitor accepts — the
         notice states that honestly and remembers acceptance in localStorage. -->
    {
      chrome && (
        <div class="consent-stub" data-consent-stub hidden role="region" aria-label={chromeT.consentAria}>
          <span>{chromeT.consent}</span>
          <button type="button" data-consent-ok>{chromeT.consentOk}</button>
        </div>
      )
    }
    {
      chrome && (
        <script is:inline>
          (function () {
            var el = document.querySelector("[data-consent-stub]");
            if (!el) return;
            try {
              if (!localStorage.getItem("vyotish.consent.v1")) el.removeAttribute("hidden");
            } catch (e) {
              /* storage blocked: show the banner (safe default) */
              el.removeAttribute("hidden");
            }
            var btn = el.querySelector("[data-consent-ok]");
            if (btn)
              btn.addEventListener("click", function () {
                try {
                  localStorage.setItem("vyotish.consent.v1", "acknowledged");
                } catch (e) {}
                el.setAttribute("hidden", "");
              });
          })();
        </script>
      )
    }
    {chrome && <script>import "../scripts/site-enhancements";</script>}
    {chrome && <script>import "../scripts/place-picker";</script>}
    <!-- global styles live in src/styles/base.css (layer order: theme → base → utilities) -->
  </body>
</html>
